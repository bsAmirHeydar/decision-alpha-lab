  "patch_id": "EXP0017-PH14-HOTFIX002-ONE-SHOT-SIGNAL-ENTITLEMENT",
  "version": "1.0.0",
  "created": "2026-07-10",
  "experiment": "EXP0017",
  "required_baseline": [
    "EXP0017 Phase06 Hotfix011 or later",
    "EXP0017 Phase14 Raw Execution Backtest V1",
    "EXP0017 Phase14 Hotfix001",
    "EXP0017 Phase14 Execution Controls V2"
  ],
  "intent": "Enforce a hard one-shot execution entitlement for each divergence anatomy across repeated lower-timeframe closed-candle observations.",
  "hard_invariants": [
    "Each canonical divergence entitlement can be consumed once only.",
    "Confirmation candle time is excluded from entitlement identity.",
    "Symbol order does not alter entitlement identity.",
    "Entitlement is consumed before planning and order routing.",
    "Planner, position-policy, paper, broker failure, and successful execution never rearm the entitlement.",
    "Startup warmup reconstructs current-day consumed entitlements without sending historical orders.",
    "Registry capacity fails closed.",
    "The policy is not input-switchable."
  ],
  "behavior_preserved": [
    "No change to divergence detection, freshness, or lifecycle authority.",
    "No change to CG definitions.",
    "No change to protected/hunter trade-leg selection.",
    "No change to entry, stop, target, risk, hedge, or visual models.",
    "cg_3m remains the only enabled CG by default."
  ],
