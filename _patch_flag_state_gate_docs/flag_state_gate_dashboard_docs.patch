+MQL5/Files/FlagCountingPhoenix/latest_state_gate_summary.csv
+MQL5/Files/FlagCountingPhoenix/latest_state_gate_rally.csv
+MQL5/Files/FlagCountingPhoenix/latest_state_gate_hooks.csv
