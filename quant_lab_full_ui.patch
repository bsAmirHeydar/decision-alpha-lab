@@ -0,0 +1,35 @@
+import type { TableSpec } from '../types/visualization';
+import { formatNumber, formatTime } from '../utils/format';
+
+export function DataTable({ table, selectedRowId, onRowSelect }: { table: TableSpec; selectedRowId: string | null; onRowSelect: (row: Record<string, unknown>) => void }) {
+  return (
+    <div className="data-table-wrap">
+      <table className="data-table">
+        <thead>
+          <tr>
+            {table.columns.map((column) => <th key={column.key}>{column.label}</th>)}
+          </tr>
+        </thead>
+        <tbody>
+          {table.rows.map((row) => {
+            const rowId = String(row[table.primary_key] ?? row.event_id ?? row.node_object_id ?? '');
+            return (
+              <tr key={rowId} className={selectedRowId === rowId ? 'selected' : ''} onClick={() => onRowSelect(row)}>
+                {table.columns.map((column) => <td key={column.key}>{formatCell(row[column.key], column.type)}</td>)}
+              </tr>
+            );
+          })}
+        </tbody>
+      </table>
+    </div>
+  );
+}
+
+function formatCell(value: unknown, type: string): string {
+  if (type === 'number') return formatNumber(value, 4);
+  if (type === 'integer') return formatNumber(value, 0);
+  if (String(value).includes?.('T')) return formatTime(value);
+  if (value === true) return 'true';
+  if (value === false) return 'false';
+  return value === null || value === undefined ? '—' : String(value);
+}
