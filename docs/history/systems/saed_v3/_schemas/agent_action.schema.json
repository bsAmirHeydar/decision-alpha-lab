{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAED Agent Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "agent_role",
    "authority_version",
    "action_type",
    "input_hashes",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "const": "saed.agent-action.v2"
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_role": {
      "type": "string",
      "minLength": 1
    },
    "authority_version": {
      "type": "string",
      "minLength": 1
    },
    "action_type": {
      "type": "string",
      "minLength": 1
    },
    "input_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "blocked": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    }
  }
}
