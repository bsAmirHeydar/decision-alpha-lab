{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAED Promotion Dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "artifact_hashes",
    "critical_gates",
    "decision",
    "reviewers"
  ],
  "properties": {
    "schema_version": {
      "const": "saed.promotion-dossier.v2"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "critical_gates": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "decision": {
      "enum": [
        "promote",
        "restricted_promote",
        "extend_challenge",
        "reject",
        "retire"
      ]
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
