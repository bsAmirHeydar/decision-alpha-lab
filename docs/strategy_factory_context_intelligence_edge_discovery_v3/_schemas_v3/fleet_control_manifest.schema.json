{
  "$id": "https://alpha-lab.local/schemas/saed-v3/fleet_control_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cells": {
      "type": "array"
    },
    "central_engine_hash": {
      "type": "string"
    },
    "central_invariance_required": {
      "const": true,
      "type": "boolean"
    },
    "contract_type": {
      "const": "fleet_control_manifest",
      "type": "string"
    },
    "quotas": {
      "type": "object"
    },
    "schema_version": {
      "const": "3.0.0",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_type",
    "cells",
    "central_engine_hash",
    "central_invariance_required"
  ],
  "title": "Fleet Control Manifest",
  "type": "object"
}
