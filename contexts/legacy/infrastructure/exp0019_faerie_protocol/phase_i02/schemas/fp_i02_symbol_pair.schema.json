{
  "$id": "https://decision-alpha-lab.local/exp0019/fp-i02/fp_i02_symbol_pair.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "pair_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "primary_symbol": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "secondary_symbol": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "primary_symbol",
    "secondary_symbol",
    "pair_version"
  ],
  "title": "fp_i02_symbol_pair",
  "type": "object"
}
