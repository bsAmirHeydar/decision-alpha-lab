{
  "$id": "https://decision-alpha-lab.local/schemas/exp0019/fp_i06/fp_i06_revision_impact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_side_plan_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "impact_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason_code": {
      "minLength": 1,
      "type": "string"
    },
    "revision_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "impact_id",
    "revision_id",
    "affected_side_plan_ids",
    "reason_code",
    "evidence_hash"
  ],
  "title": "fp_i06_revision_impact",
  "type": "object"
}
