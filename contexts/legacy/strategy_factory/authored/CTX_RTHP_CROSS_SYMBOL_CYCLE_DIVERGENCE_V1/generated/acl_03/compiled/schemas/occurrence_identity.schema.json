{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anchor_time": {
      "format": "date-time",
      "type": "string"
    },
    "context_id": {
      "const": "CTX_RTHP_CROSS_SYMBOL_CYCLE_DIVERGENCE_V1"
    },
    "context_version": {
      "minLength": 1,
      "type": "string"
    },
    "direction": {
      "enum": [
        "LONG",
        "SHORT",
        "NEUTRAL",
        "UNKNOWN"
      ]
    },
    "subject_key": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "context_id",
    "context_version",
    "anchor_time",
    "direction",
    "subject_key"
  ],
  "type": "object"
}
