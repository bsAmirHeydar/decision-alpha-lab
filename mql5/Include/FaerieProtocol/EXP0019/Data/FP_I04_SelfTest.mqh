#ifndef __EXP0019_FP_I04_SELF_TEST_MQH__
#define __EXP0019_FP_I04_SELF_TEST_MQH__
#include "FP_I04_Diagnostics.mqh"
void FP_I04_Check(const bool condition,const string name,FP_I04_SelfTestResult &r){r.check_count++;if(condition)r.pass_count++;else{r.fail_count++;r.latest_failed_check=name;}}
void FP_I04_TestBar(FP_I04_M1Bar &b,const string symbol,const datetime minute,const double price,const long sequence){b.canonical_symbol=symbol;b.open_utc=minute;b.open=price;b.high=price+0.5;b.low=price-0.5;b.close=price+0.25;b.tick_volume=10;b.real_volume=0;b.spread_points=1;b.finality=FP_I04_BAR_CLOSED;b.source_id="SELFTEST";b.source_sequence=sequence;b.source_revision="R1";b.received_utc=minute+60;b.bar_hash=FP_I04_BarHash(b);}
bool FP_I04_RunSelfTest(FP_I04_SelfTestResult &r){ZeroMemory(r);FP_I04_SymbolPair pair;FP_I04_DefaultPair(pair);string canonical="";FP_I04_Check(FP_I04_ResolveSymbol(pair,"us500",canonical)&&canonical=="ES","symbol_resolver",r);datetime start=StringToTime("2026.07.13 12:00:00");FP_I04_M1Bar left[],right[];ArrayResize(left,3);ArrayResize(right,3);for(int i=0;i<3;i++){FP_I04_TestBar(left[i],"ES",start+i*60,5000+i,2*i);FP_I04_TestBar(right[i],"NQ",start+i*60,20000+i,2*i+1);}string reason="";FP_I04_Check(FP_I04_ValidateBar(left[0],pair.left,reason),"bar_validation",r);FP_I04_AlignedMinute rows[];FP_I04_SyncResult result;FP_I04_Check(FP_I04_SynchronizeRange(pair,start,start+180,left,right,rows,result),"synchronize",r);FP_I04_Check(result.row_count==3,"row_count",r);FP_I04_Check(result.both_present_count==3,"both_present",r);FP_I04_Check(result.health==FP_I04_SYNC_READY,"ready",r);ArrayResize(right,2);FP_I04_SyncResult degraded;FP_I04_Check(FP_I04_SynchronizeRange(pair,start,start+180,left,right,rows,degraded),"degraded_sync",r);FP_I04_Check(degraded.gap_count==1&&degraded.health==FP_I04_SYNC_DEGRADED,"missing_explicit",r);FP_I04_M1Bar dup=left[0];dup.source_sequence=99;FP_I04_DuplicateResolution dr;FP_I04_Check(FP_I04_ResolveTwoBars(left[0],dup,dr)&&dr.disposition==FP_I04_DUP_IDENTICAL_DEDUPLICATED,"duplicate_dedup",r);dup.close+=0.25;FP_I04_Check(!FP_I04_ResolveTwoBars(left[0],dup,dr)&&dr.disposition==FP_I04_DUP_CONFLICT,"duplicate_conflict",r);FP_I04_IncrementalCursor cursor;FP_I04_EmptyCursor(pair.pair_id,cursor);FP_I04_Check(cursor.state==FP_I04_CURSOR_EMPTY,"empty_cursor",r);FP_I04_BackfillRequest br;FP_I04_PlanBackfill("ES",start,start+120,FP_I04_GAP_SOURCE_MISSING,100,br);FP_I04_Check(br.action==FP_I04_BACKFILL_FETCH_RANGE,"backfill",r);r.evidence_key=FP_I02_CompactId("FPI04TEST",IntegerToString(r.check_count)+"|"+IntegerToString(r.pass_count)+"|"+r.latest_failed_check);return r.fail_count==0;}
#endif
