#ifndef __EXP0019_FP_I04_ENUMS_MQH__
#define __EXP0019_FP_I04_ENUMS_MQH__
enum FP_I04_BarFinality { FP_I04_BAR_CLOSED=0, FP_I04_BAR_PROVISIONAL=1 };
enum FP_I04_MinuteCellState { FP_I04_CELL_PRESENT=0, FP_I04_CELL_MISSING=1, FP_I04_CELL_OUT_OF_COVERAGE=2, FP_I04_CELL_CONFLICT=3, FP_I04_CELL_REVISED=4 };
enum FP_I04_CoverageState { FP_I04_COVERAGE_COMPLETE=0, FP_I04_COVERAGE_PARTIAL=1, FP_I04_COVERAGE_EMPTY=2, FP_I04_COVERAGE_CONFLICTED=3, FP_I04_COVERAGE_BLOCKED=4 };
enum FP_I04_SyncHealth { FP_I04_SYNC_READY=0, FP_I04_SYNC_DEGRADED=1, FP_I04_SYNC_BLOCKED=2 };
enum FP_I04_DuplicateDisposition { FP_I04_DUP_UNIQUE=0, FP_I04_DUP_IDENTICAL_DEDUPLICATED=1, FP_I04_DUP_CONFLICT=2 };
enum FP_I04_RevisionKind { FP_I04_REV_INITIAL=0, FP_I04_REV_APPEND=1, FP_I04_REV_LATE_INSERT=2, FP_I04_REV_VALUE_CORRECTION=3, FP_I04_REV_DELETE=4, FP_I04_REV_CONFLICT=5, FP_I04_REV_NO_CHANGE=6 };
enum FP_I04_GapReason { FP_I04_GAP_SOURCE_MISSING=0, FP_I04_GAP_BEFORE_COVERAGE=1, FP_I04_GAP_AFTER_COVERAGE=2, FP_I04_GAP_CALENDAR_EXCLUDED=3, FP_I04_GAP_DUPLICATE_CONFLICT=4 };
enum FP_I04_CursorState { FP_I04_CURSOR_EMPTY=0, FP_I04_CURSOR_ACTIVE=1, FP_I04_CURSOR_EXHAUSTED=2, FP_I04_CURSOR_INVALIDATED=3 };
enum FP_I04_BackfillAction { FP_I04_BACKFILL_NONE=0, FP_I04_BACKFILL_FETCH_RANGE=1, FP_I04_BACKFILL_FULL_REBUILD=2, FP_I04_BACKFILL_BLOCK=3 };
#endif
