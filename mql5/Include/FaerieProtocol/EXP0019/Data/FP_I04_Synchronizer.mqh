#ifndef __EXP0019_FP_I04_SYNCHRONIZER_MQH__
#define __EXP0019_FP_I04_SYNCHRONIZER_MQH__
#include "FP_I04_Backfill.mqh"
int FP_I04_FindMinute(const FP_I04_M1Bar &bars[],const datetime minute){for(int i=0;i<ArraySize(bars);i++)if(bars[i].open_utc==minute)return i;return -1;}
void FP_I04_MakeCell(const string symbol,const datetime minute,const FP_I04_M1Bar &bars[],const string revision_hash,FP_I04_MinuteCell &cell)
  { cell.canonical_symbol=symbol;cell.open_utc=minute;int index=FP_I04_FindMinute(bars,minute);if(index>=0){cell.state=FP_I04_CELL_PRESENT;cell.bar=bars[index];cell.has_bar=true;cell.reason_code="FP_DRC_M1_PRESENT";}else{cell.state=FP_I04_CELL_MISSING;cell.has_bar=false;cell.reason_code="FP_DRC_M1_MISSING";}cell.source_revision_hash=revision_hash; }
bool FP_I04_SynchronizeRange(const FP_I04_SymbolPair &pair,const datetime start_utc,const datetime end_utc,const FP_I04_M1Bar &left_bars[],const FP_I04_M1Bar &right_bars[],FP_I04_AlignedMinute &rows[],FP_I04_SyncResult &result)
  { if(end_utc<=start_utc||!FP_I04_IsMinuteAligned(start_utc)||!FP_I04_IsMinuteAligned(end_utc))return false;int count=(int)((end_utc-start_utc)/60);ArrayResize(rows,count);int both=0,gaps=0;string rev=FP_I02_CompactId("FPREV",pair.pair_hash+"|"+IntegerToString((long)start_utc)+"|"+IntegerToString((long)end_utc));for(int i=0;i<count;i++){datetime minute=start_utc+i*60;rows[i].pair_id=pair.pair_id;rows[i].open_utc=minute;FP_I04_MakeCell(pair.left.canonical_symbol,minute,left_bars,rev,rows[i].left);FP_I04_MakeCell(pair.right.canonical_symbol,minute,right_bars,rev,rows[i].right);rows[i].calendar_segment="UNRESOLVED_BY_I04_STATIC_TEST";rows[i].calendar_snapshot_hash="UPSTREAM_FP_I03";rows[i].row_id=FP_I02_CompactId("FPALIGN",pair.pair_id+"|"+IntegerToString((long)minute)+"|"+rows[i].left.reason_code+"|"+rows[i].right.reason_code);if(rows[i].left.has_bar&&rows[i].right.has_bar)both++;else gaps++;}result.pair_id=pair.pair_id;result.start_utc=start_utc;result.end_utc=end_utc;result.row_count=count;result.both_present_count=both;result.gap_count=gaps;result.conflict_count=0;result.health=(gaps==0?FP_I04_SYNC_READY:FP_I04_SYNC_DEGRADED);result.revision_id=rev;result.semantic_hash=FP_I02_CompactId("FPSYNCSEM",pair.pair_hash+"|"+IntegerToString((long)start_utc)+"|"+IntegerToString((long)end_utc)+"|"+IntegerToString(both)+"|"+IntegerToString(gaps));result.result_id=FP_I02_CompactId("FPSYNC",result.semantic_hash);return true; }
#endif
