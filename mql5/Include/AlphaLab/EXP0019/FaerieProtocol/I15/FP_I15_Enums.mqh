#ifndef FP_I15_ENUMS_MQH
#define FP_I15_ENUMS_MQH
#define FP_I15_VERSION "1.0.0"
enum FP_I15_DIRECTION { FP_I15_BUY=1, FP_I15_SELL=-1 };
enum FP_I15_GEOMETRY_STATUS { FP_I15_GEOMETRY_READY=1, FP_I15_GEOMETRY_BLOCKED=2 };
enum FP_I15_QUOTA_STATE { FP_I15_QUOTA_AVAILABLE=0, FP_I15_QUOTA_RESERVED=1, FP_I15_QUOTA_CONSUMED=2, FP_I15_QUOTA_RELEASED=3 };
enum FP_I15_CONSUME_EVENT { FP_I15_CONSUME_UNSET=0, FP_I15_CONSUME_PLAN=1, FP_I15_CONSUME_ATTEMPT=2, FP_I15_CONSUME_ACCEPTED=3, FP_I15_CONSUME_FIRST_FILL=4 };
enum FP_I15_ORDER_STATE { FP_I15_ORDER_CREATED=0, FP_I15_ORDER_VALIDATED=1, FP_I15_ORDER_ATTEMPTED=2, FP_I15_ORDER_ACCEPTED=3, FP_I15_ORDER_PARTIAL=4, FP_I15_ORDER_FILLED=5, FP_I15_ORDER_REJECTED=6, FP_I15_ORDER_CANCELLED=7 };
#endif
