#ifndef __SF19_REFERENCE_MONITORING_FIXTURE_MQH__
#define __SF19_REFERENCE_MONITORING_FIXTURE_MQH__
#include "../SF19_MonitoringCoordinator.mqh"
void SF19_BuildReferenceSchema(const string metric_name,const ENUM_SF19_METRIC_KIND kind,const string unit,const string stage,SF19_TelemetrySchemaEntry &e)
{e.metric_name=metric_name;e.schema_version="1.0.0";e.metric_kind=kind;e.unit=unit;e.stage=stage;e.description="Phase 19 deterministic reference metric";e.has_lower_bound=true;e.lower_bound=0.0;e.has_upper_bound=false;e.upper_bound=0.0;e.schema_id=SF19_DeriveSchemaId(e);}
void SF19_BuildReferenceEvent(const SF19_TelemetrySchemaEntry &schema,const long sequence,const long now,const double value,SF19_TelemetryEvent &e)
{e.metric_name=schema.metric_name;e.schema_id=schema.schema_id;e.run_id="run-phase19-reference";e.generation_id="generation-phase19-reference";e.strategy_id="strategy-reference";e.model_id="model-reference";e.correlation_id="corr-"+IntegerToString(sequence);e.causation_id="cause-reference";e.observed_time_utc_msc=now;e.known_time_utc_msc=now;e.sequence=sequence;e.value=value;e.payload_hash=SF19_DeriveTelemetryPayloadHash(e);e.event_id=SF19_DeriveTelemetryEventId(e);}
void SF19_BuildReferenceAlertPolicy(SF19_AlertPolicy &p)
{p.policy_id="alert-queue-v1";p.metric_name="runtime.queue_depth";p.warning_threshold=100.0;p.critical_threshold=500.0;p.comparison="HIGH";p.consecutive_breaches=2;p.consecutive_recoveries=2;p.cooldown_msc=0;p.reminder_msc=300000;}
void SF19_BuildReferenceLatencyPolicy(SF19_LatencySloPolicy &p)
{p.policy_id="slo-pipeline-v1";p.stage="pipeline";p.bucket_count=8;long edges[8]={100,250,500,1000,2500,5000,10000,25000};for(int i=0;i<p.bucket_count;i++)p.bucket_edges_us[i]=edges[i];p.p50_limit_us=1000;p.p95_limit_us=5000;p.p99_limit_us=10000;p.minimum_samples=5;}
void SF19_BuildReferenceDrift(SF19_DriftBaseline &b,SF19_DriftObservation &o,SF19_DriftThresholdPolicy &p,const bool shifted)
{b.baseline_id="baseline-feature-v1";b.feature_name="feature.volatility_z";b.model_id="model-reference";b.kind=SF19_DRIFT_FEATURE;b.bin_count=4;double probs[4]={0.10,0.40,0.40,0.10};for(int i=0;i<4;i++)b.probabilities[i]=probs[i];b.mean=0.0;b.standard_deviation=1.0;b.sample_count=1000;b.window_start_utc_msc=1;b.window_end_utc_msc=2;o.observation_id=(shifted?"observation-shifted":"observation-stable");o.baseline_id=b.baseline_id;o.feature_name=b.feature_name;o.model_id=b.model_id;o.kind=b.kind;o.bin_count=4;long stable[4]={10,40,40,10};long changed[4]={5,15,30,150};o.sample_count=0;for(int j=0;j<4;j++){o.bin_counts[j]=(shifted?changed[j]:stable[j]);o.sample_count+=o.bin_counts[j];}o.mean=(shifted?2.2:0.05);o.standard_deviation=1.0;o.missing_count=0;o.invalid_count=0;o.window_start_utc_msc=3;o.window_end_utc_msc=4;p.policy_id="drift-policy-feature-v1";p.kind=SF19_DRIFT_FEATURE;p.psi_warning=0.10;p.psi_critical=0.25;p.js_warning=0.03;p.js_critical=0.10;p.mean_z_warning=1.0;p.mean_z_critical=2.0;p.missing_rate_critical=0.05;p.invalid_rate_critical=0.01;p.minimum_samples=100;}
#endif
