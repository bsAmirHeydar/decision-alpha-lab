#ifndef __UCE02_CONFORMANCE_MQH__
#define __UCE02_CONFORMANCE_MQH__
#include "UCE02_EXP0017Reference.mqh"
struct UCE02_ConformanceTelemetry{long packages_linted;long manifest_failures;long descriptor_failures;long duplicate_observations;long illegal_transitions;long replay_mismatches;long future_perturbation_failures;long missing_source_failures;};
void UCE02_ResetConformanceTelemetry(UCE02_ConformanceTelemetry &value){value.packages_linted=0;value.manifest_failures=0;value.descriptor_failures=0;value.duplicate_observations=0;value.illegal_transitions=0;value.replay_mismatches=0;value.future_perturbation_failures=0;value.missing_source_failures=0;}
bool UCE02_LintPackage(IUCE02ContextPackage *package,UCE02_ConformanceTelemetry &telemetry,string &error){telemetry.packages_linted++;if(CheckPointer(package)==POINTER_INVALID){telemetry.manifest_failures++;error="invalid package pointer";return false;}if(!package.ValidatePackage(error)){telemetry.manifest_failures++;return false;}for(int i=0;i<package.FeatureCount();i++){UCE02_FeatureDescriptor d;if(!package.GetFeatureDescriptor(i,d)||!UCE02_ValidateFeatureDescriptor(d,error)){telemetry.descriptor_failures++;return false;}}for(int i=0;i<package.ViewCount();i++){UCE02_ViewDescriptor d;if(!package.GetViewDescriptor(i,d)||!UCE02_ValidateViewDescriptor(d,error)){telemetry.descriptor_failures++;return false;}}for(int i=0;i<package.ClusterRuleCount();i++){UCE02_ClusterRule d;if(!package.GetClusterRule(i,d)||!UCE02_ValidateClusterRule(d,error)){telemetry.descriptor_failures++;return false;}}error="";return true;}
bool UCE02_ReplayHashEqual(const UCE02_ContextObservation &a,const UCE02_ContextObservation &b,UCE02_ConformanceTelemetry &telemetry,string &error){if(a.observation_id!=b.observation_id||a.observation_hash!=b.observation_hash){telemetry.replay_mismatches++;error="replay hash mismatch";return false;}error="";return true;}
#endif
