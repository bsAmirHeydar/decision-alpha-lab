#ifndef __SF17_EXECUTION_ENUMS_MQH__
#define __SF17_EXECUTION_ENUMS_MQH__
enum ENUM_SF17_EXECUTION_MODE{SF17_MODE_PAPER=1,SF17_MODE_SHADOW=2};
enum ENUM_SF17_ORDER_STATE{SF17_ORDER_RECEIVED=1,SF17_ORDER_WORKING=2,SF17_ORDER_PARTIALLY_FILLED=3,SF17_ORDER_FILLED=4,SF17_ORDER_CANCELED=5,SF17_ORDER_EXPIRED=6,SF17_ORDER_REJECTED=7};
enum ENUM_SF17_POSITION_STATE{SF17_POSITION_OPEN=1,SF17_POSITION_CLOSED=2};
enum ENUM_SF17_FILL_REASON{SF17_FILL_ENTRY_MARKET=1,SF17_FILL_ENTRY_LIMIT=2,SF17_FILL_ENTRY_STOP=3,SF17_FILL_EXIT_STOP=4,SF17_FILL_EXIT_TARGET=5,SF17_FILL_EXIT_MANUAL=6};
enum ENUM_SF17_REJECT_REASON{SF17_REJECT_NONE=0,SF17_REJECT_INVALID_INTENT=1,SF17_REJECT_RESEARCH_AUTHORITY=2,SF17_REJECT_EXPIRED=3,SF17_REJECT_DUPLICATE_CONFLICT=4,SF17_REJECT_CAPACITY=7,SF17_REJECT_STALE_QUOTE=8};
enum ENUM_SF17_TRANSACTION_TYPE{SF17_TX_INTENT_RECEIVED=1,SF17_TX_ORDER_ACCEPTED=2,SF17_TX_ORDER_REJECTED=3,SF17_TX_ORDER_WORKING=4,SF17_TX_ORDER_PARTIAL_FILL=5,SF17_TX_ORDER_FILLED=6,SF17_TX_ORDER_CANCELED=7,SF17_TX_ORDER_EXPIRED=8,SF17_TX_POSITION_OPENED=9,SF17_TX_POSITION_INCREASED=10,SF17_TX_POSITION_CLOSED_STOP=11,SF17_TX_POSITION_CLOSED_TARGET=12,SF17_TX_POSITION_CLOSED_MANUAL=13,SF17_TX_RECONCILIATION=14};
#define SF17_MAX_ORDERS 512
#define SF17_MAX_FILLS 2048
#define SF17_MAX_POSITIONS 512
#define SF17_MAX_TRANSACTIONS 4096
#endif
