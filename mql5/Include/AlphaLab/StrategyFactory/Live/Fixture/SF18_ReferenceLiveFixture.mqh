void SF18_BuildReferenceRelease(const long now,SF18_MicroLiveRelease &r)
{r.release_id="sf18.reference.release";r.release_version="1.0.0";r.strategy_id="sf.reference";r.strategy_version="1.0.0";r.runtime_generation_id=18;r.model_release_hash="model_release";r.decision_policy_hash="decision_policy";r.risk_policy_hash="risk_policy";r.allocation_policy_hash="allocation_policy";r.execution_policy_hash="execution_policy";r.account_login=123456;r.account_server="Broker-Demo";r.allowed_symbol="X";r.maximum_volume=0.01;r.maximum_orders=1;r.valid_from_utc_msc=now-1000;r.valid_until_utc_msc=now+60000;r.phase17_soak_evidence_hash="soak_evidence";r.reconciliation_evidence_hash="reconciliation_evidence";r.anti_overfit_evidence_hash="anti_overfit_evidence";r.release_hash=SF18_DeriveReleaseHash(r);}
void SF18_BuildReferenceAuthorization(const long now,const SF18_MicroLiveRelease &r,const ENUM_SF18_LIVE_MODE mode,SF18_LiveAuthorization &a)
{a.authorization_id="auth.reference";a.release_hash=r.release_hash;a.account_login=r.account_login;a.account_server=r.account_server;a.allowed_symbol=r.allowed_symbol;a.mode=mode;a.issued_at_utc_msc=now-1000;a.expires_at_utc_msc=now+30000;a.maximum_volume=0.01;a.maximum_orders=1;a.nonce="nonce-001";a.operator_token_hash="operator-token";a.authorization_hash=SF18_DeriveAuthorizationHash(a);}
void SF18_BuildReferencePolicy(SF18_SafetyPolicy &p)
{p.policy_id="sf18.reference.safety";p.policy_version="1.0.0";p.maximum_orders_per_session=1;p.maximum_concurrent_orders=1;p.maximum_positions=1;p.maximum_volume_per_order=0.01;p.maximum_total_exposure_volume=0.01;p.maximum_cash_risk_per_order=100.0;p.maximum_daily_realized_loss_cash=200.0;p.maximum_daily_total_loss_cash=250.0;p.minimum_equity_cash=1000.0;p.minimum_free_margin_cash=500.0;p.minimum_margin_level_percent=100.0;p.maximum_spread_points=50.0;p.maximum_quote_age_milliseconds=1000;p.maximum_account_snapshot_age_milliseconds=1000;p.maximum_deviation_points=5;p.maximum_consecutive_failures=2;p.cooldown_after_failure_milliseconds=5000;p.one_shot_authorization=true;p.require_terminal_permission=true;p.require_account_permission=true;p.allow_emergency_flatten=false;p.policy_hash=SF18_DeriveSafetyPolicyHash(p);}
void SF18_BuildReferenceIntent(const long now,SF16_ExecutionIntent &i)
{i.intent_id="intent-1";i.batch_id="batch-1";i.candidate_id="candidate-1";i.candidate_hash="candidate-hash";i.context_frame_id="context-1";i.strategy_id="sf.reference";i.strategy_version="1.0.0";i.symbol="X";i.group_id="group-1";i.direction=1;i.runtime_generation_id=18;i.model_id="model";i.model_version="1";i.model_release_hash="model_release";i.decision_policy_hash="decision_policy";i.risk_policy_hash="risk_policy";i.allocation_policy_hash="allocation_policy";i.order_kind=SF08_ORDER_MARKET;i.entry_price=100.0;i.stop_price=99.0;i.target_price=102.0;i.has_target=true;i.volume=0.01;i.risk_budget_cash=100.0;i.expected_max_loss_cash=80.0;i.planned_r_multiple=2.0;i.model_score=0.8;i.ranking_score=0.8;i.priority=1;i.created_at_utc_msc=now-100;i.expires_at_utc_msc=now+10000;i.authority=SF16_AUTHORITY_PAPER_ELIGIBLE;i.intent_hash=SF16_DeriveIntentHash(i);}
