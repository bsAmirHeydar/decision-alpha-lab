#ifndef __UCEI03_ENTRY_ATOMS_MQH__
#define __UCEI03_ENTRY_ATOMS_MQH__
#include "UCEI03_Catalog.mqh"
void UCEI03_ResetEntryPlan(UCEI03_EntryPlan &p){p.invocation_id="";ArrayResize(p.legs,0);p.cancel_policy="cancel_on_context_invalidation";p.metadata_json="{}";p.plan_id="";}
bool UCEI03_BuildImmediateMarket(const UCEI03_BuildContext &c,const UCEI03_Invocation &i,UCEI03_EntryPlan &p,string &error){if(!UCEI03_ValidatePriceEnvironment(c.price,error))return false;UCEI03_ResetEntryPlan(p);p.invocation_id=i.invocation_id;ArrayResize(p.legs,1);p.legs[0].order_type=UCEI03_ORDER_MARKET;p.legs[0].trigger_price=UCEI03_RoundNearestTick(c.price,UCEI03_EntryExecutable(c.price,c.side));p.legs[0].limit_price=0.0;p.legs[0].allocation_fraction=1.0;p.legs[0].earliest_time_ms=c.decision_time_ms;p.legs[0].latest_time_ms=c.decision_time_ms;p.metadata_json=c.side==UCEI03_LONG?"{\"executable_side\":\"ask\"}":"{\"executable_side\":\"bid\"}";p.plan_id="uceep_"+UCE03_Fnv1a64HexUtf8(i.invocation_id+"|market|"+DoubleToString(p.legs[0].trigger_price,c.price.digits));error="";return true;}
bool UCEI03_BuildPassiveLimit(const UCEI03_BuildContext &c,const UCEI03_Invocation &i,const double offset_points,const long ttl_ms,UCEI03_EntryPlan &p,string &error){UCEI03_ResetEntryPlan(p);double raw=c.side==UCEI03_LONG?c.price.ask-offset_points*c.price.point:c.price.bid+offset_points*c.price.point;double price=UCEI03_RoundNearestTick(c.price,raw);if(!UCEI03_ValidatePending(c,UCEI03_ORDER_LIMIT,price,error))return false;p.invocation_id=i.invocation_id;ArrayResize(p.legs,1);p.legs[0].order_type=UCEI03_ORDER_LIMIT;p.legs[0].trigger_price=price;p.legs[0].limit_price=price;p.legs[0].allocation_fraction=1.0;p.legs[0].earliest_time_ms=c.decision_time_ms;p.legs[0].latest_time_ms=c.decision_time_ms+ttl_ms;p.plan_id="uceep_"+UCE03_Fnv1a64HexUtf8(i.invocation_id+"|limit|"+DoubleToString(price,c.price.digits));error="";return true;}
bool UCEI03_BuildBreakoutStop(const UCEI03_BuildContext &c,const UCEI03_Invocation &i,const double buffer_points,const long ttl_ms,UCEI03_EntryPlan &p,string &error){UCEI03_ResetEntryPlan(p);double raw=c.side==UCEI03_LONG?c.reference_price+buffer_points*c.price.point:c.reference_price-buffer_points*c.price.point;double price=UCEI03_RoundNearestTick(c.price,raw);if(!UCEI03_ValidatePending(c,UCEI03_ORDER_STOP,price,error))return false;p.invocation_id=i.invocation_id;ArrayResize(p.legs,1);p.legs[0].order_type=UCEI03_ORDER_STOP;p.legs[0].trigger_price=price;p.legs[0].allocation_fraction=1.0;p.legs[0].earliest_time_ms=c.decision_time_ms;p.legs[0].latest_time_ms=c.decision_time_ms+ttl_ms;p.plan_id="uceep_"+UCE03_Fnv1a64HexUtf8(i.invocation_id+"|stop|"+DoubleToString(price,c.price.digits));error="";return true;}
#endif
