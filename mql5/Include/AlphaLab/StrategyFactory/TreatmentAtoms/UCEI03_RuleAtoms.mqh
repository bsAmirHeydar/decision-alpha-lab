#ifndef __UCEI03_RULE_ATOMS_MQH__
#define __UCEI03_RULE_ATOMS_MQH__
#include "UCEI03_StopTargetAtoms.mqh"
void UCEI03_BuildNoTrail(const UCEI03_Invocation &i,UCEI03_TrailingPlan &p){p.invocation_id=i.invocation_id;p.mode="none";p.activation_r=0.0;p.distance=0.0;p.lock_r=0.0;p.cadence_ms=0;p.reference_field="";p.metadata_json="{}";p.plan_id="ucetrp_"+UCE03_Fnv1a64HexUtf8(i.invocation_id+"|none");}
void UCEI03_BuildBreakEvenTrail(const UCEI03_BuildContext &c,const UCEI03_Invocation &i,const double activation_r,const double offset_points,UCEI03_TrailingPlan &p){p.invocation_id=i.invocation_id;p.mode="break_even";p.activation_r=activation_r;p.distance=offset_points*c.price.point;p.lock_r=0.0;p.cadence_ms=0;p.reference_field="entry_price";p.metadata_json="{}";p.plan_id="ucetrp_"+UCE03_Fnv1a64HexUtf8(i.invocation_id+"|break_even|"+DoubleToString(activation_r,4));}
void UCEI03_BuildPartialExit(const UCEI03_Invocation &i,const double activation_r,const double quantity_fraction,UCEI03_ManagementPlan &p){p.invocation_id=i.invocation_id;ArrayResize(p.rules,1);p.rules[0].rule_type="partial_exit_at_r";p.rules[0].activation_value=DoubleToString(activation_r,4);p.rules[0].quantity_fraction=quantity_fraction;p.rules[0].action_value="reduce";p.metadata_json="{}";p.plan_id="ucemp_"+UCE03_Fnv1a64HexUtf8(i.invocation_id+"|partial|"+DoubleToString(quantity_fraction,4));}
void UCEI03_BuildFixedCashSizing(const UCEI03_BuildContext &c,const UCEI03_Invocation &i,const double amount,UCEI03_SizingPlan &p){p.invocation_id=i.invocation_id;p.unit="cash_risk";p.requested_value=amount;p.cap_value=c.cash_risk_budget;p.scale_factor=1.0;p.metadata_json="{\"status\":\"preliminary_before_uce_i05_economics\"}";p.plan_id="ucezp_"+UCE03_Fnv1a64HexUtf8(i.invocation_id+"|cash|"+DoubleToString(amount,2));}
#endif
