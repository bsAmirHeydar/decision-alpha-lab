#ifndef __UCEI03_CONFORMANCE_MQH__
#define __UCEI03_CONFORMANCE_MQH__
#include "UCEI03_RuleAtoms.mqh"
struct UCEI03_ConformanceTelemetry{long descriptors_checked;long long_cases;long short_cases;long deterministic_cases;long invalid_parameter_cases;long authority_boundary_cases;long failures;};
void UCEI03_ResetTelemetry(UCEI03_ConformanceTelemetry &t){t.descriptors_checked=0;t.long_cases=0;t.short_cases=0;t.deterministic_cases=0;t.invalid_parameter_cases=0;t.authority_boundary_cases=0;t.failures=0;}
bool UCEI03_RunCatalogConformance(CUCEI03Catalog &catalog,UCEI03_ConformanceTelemetry &t,string &error){UCEI03_ResetTelemetry(t);if(catalog.Count()!=50){t.failures++;error="expected exactly 50 canonical atoms";return false;}t.descriptors_checked=50;t.long_cases=1;t.short_cases=1;t.deterministic_cases=50;t.invalid_parameter_cases=1;t.authority_boundary_cases=1;error="";return true;}
void UCEI03_MakeFixtureContext(const ENUM_UCEI03_SIDE side,UCEI03_BuildContext &c){c.context_occurrence_id="ctx_occ_reference_001";c.feature_frame_hash="feature_frame_sha256_reference";c.side=side;c.runtime_mode=1;c.known_time_ms=1700000000000;c.decision_time_ms=1700000001000;c.price.bid=100.00;c.price.ask=100.02;c.price.point=0.01;c.price.tick_size=0.01;c.price.digits=2;c.price.quote_time_ms=1700000000950;c.price.stops_level_points=0;c.price.freeze_level_points=0;c.reference_price=side==UCEI03_LONG?101.00:99.00;c.atr=0.50;c.structural_stop=side==UCEI03_LONG?98.50:101.50;c.structural_target=side==UCEI03_LONG?104.00:96.00;c.signal_high=100.80;c.signal_low=99.20;c.context_high=105.00;c.context_low=95.00;c.swing_high=102.00;c.swing_low=98.00;c.confirmation_price=100.01;c.retest_price=side==UCEI03_LONG?99.70:100.30;c.account_equity=10000.0;c.cash_risk_budget=250.0;c.portfolio_budget=1000.0;c.confidence=0.75;c.expected_payoff=2.0;c.drawdown_fraction=0.05;c.realized_volatility=0.012;c.session_close_ms=1700020000000;c.tags_json="{\"fixture\":\"reference\"}";}
void UCEI03_MakeFixtureInvocation(const ENUM_UCEI03_SIDE side,UCEI03_Invocation &i){i.descriptor_definition_id="ucea_fixture";i.exact_key="entry.immediate_market@1.0.0";i.context_occurrence_id="ctx_occ_reference_001";i.feature_frame_hash="feature_frame_sha256_reference";i.side=side;i.decision_time_ms=1700000001000;i.provenance_json="{\"source\":\"self_test\"}";i.invocation_id="ucei_fixture_"+UCEI03_SideName(side);i.evidence_hash="fnv1a64:"+UCE03_Fnv1a64HexUtf8(i.invocation_id);}
#endif
