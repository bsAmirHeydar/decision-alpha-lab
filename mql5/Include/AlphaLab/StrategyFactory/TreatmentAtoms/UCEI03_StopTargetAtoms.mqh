#ifndef __UCEI03_STOP_TARGET_ATOMS_MQH__
#define __UCEI03_STOP_TARGET_ATOMS_MQH__
#include "UCEI03_EntryAtoms.mqh"
bool UCEI03_BuildFixedDistanceStop(const UCEI03_BuildContext &c,const UCEI03_Invocation &i,const double points,UCEI03_StopPlan &p,string &error){double entry=UCEI03_EntryExecutable(c.price,c.side);double raw=c.side==UCEI03_LONG?entry-points*c.price.point:entry+points*c.price.point;p.invocation_id=i.invocation_id;p.has_price_stop=true;p.stop_price=UCEI03_ConservativePrice(c.price,c.side,UCEI03_PRICE_STOP,raw);if(!UCEI03_ValidateProtectiveStop(c,p.stop_price,error))return false;p.distance=MathAbs(entry-p.stop_price);p.has_time_exit=false;p.time_exit_ms=0;p.has_catastrophic=false;p.catastrophic_price=0.0;p.metadata_json="{}";p.plan_id="ucesp_"+UCE03_Fnv1a64HexUtf8(i.invocation_id+"|"+DoubleToString(p.stop_price,c.price.digits));error="";return true;}
bool UCEI03_BuildStructuralStop(const UCEI03_BuildContext &c,const UCEI03_Invocation &i,const double buffer_points,UCEI03_StopPlan &p,string &error){double raw=c.side==UCEI03_LONG?c.structural_stop-buffer_points*c.price.point:c.structural_stop+buffer_points*c.price.point;double entry=UCEI03_EntryExecutable(c.price,c.side);p.invocation_id=i.invocation_id;p.has_price_stop=true;p.stop_price=UCEI03_ConservativePrice(c.price,c.side,UCEI03_PRICE_STOP,raw);if(!UCEI03_ValidateProtectiveStop(c,p.stop_price,error))return false;p.distance=MathAbs(entry-p.stop_price);p.has_time_exit=false;p.has_catastrophic=false;p.metadata_json="{\"source\":\"structural_stop\"}";p.plan_id="ucesp_"+UCE03_Fnv1a64HexUtf8(i.invocation_id+"|structural|"+DoubleToString(p.stop_price,c.price.digits));error="";return true;}
bool UCEI03_BuildFixedRTarget(const UCEI03_BuildContext &c,const UCEI03_Invocation &i,const double risk_points,const double reward_multiple,UCEI03_TargetPlan &p,string &error){double entry=UCEI03_EntryExecutable(c.price,c.side);double distance=risk_points*c.price.point*reward_multiple;double raw=c.side==UCEI03_LONG?entry+distance:entry-distance;double target=UCEI03_ConservativePrice(c.price,c.side,UCEI03_PRICE_TARGET,raw);if(!UCEI03_ValidateFavorableTarget(c,target,error))return false;p.invocation_id=i.invocation_id;ArrayResize(p.legs,1);p.legs[0].has_target_price=true;p.legs[0].target_price=target;p.legs[0].quantity_fraction=1.0;p.legs[0].activation_r=reward_multiple;p.legs[0].is_runner=false;p.no_fixed_target=false;p.metadata_json="{}";p.plan_id="ucetp_"+UCE03_Fnv1a64HexUtf8(i.invocation_id+"|fixed_r|"+DoubleToString(target,c.price.digits));error="";return true;}
void UCEI03_BuildRunnerTarget(const UCEI03_Invocation &i,UCEI03_TargetPlan &p){p.invocation_id=i.invocation_id;ArrayResize(p.legs,1);p.legs[0].has_target_price=false;p.legs[0].target_price=0.0;p.legs[0].quantity_fraction=1.0;p.legs[0].activation_r=0.0;p.legs[0].is_runner=true;p.no_fixed_target=true;p.metadata_json="{\"runner\":true}";p.plan_id="ucetp_"+UCE03_Fnv1a64HexUtf8(i.invocation_id+"|runner");}
#endif
