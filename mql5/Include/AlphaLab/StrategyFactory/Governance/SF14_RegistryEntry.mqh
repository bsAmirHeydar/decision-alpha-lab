#ifndef __SF14_REGISTRY_ENTRY_MQH__
#define __SF14_REGISTRY_ENTRY_MQH__
#include "SF14_PromotionEvaluation.mqh"
struct SF14_ModelRegistryEntry{string entry_id;string model_id;string model_version;string model_artifact_hash;string scope_id;string evidence_bundle_hash;string evaluation_hash;ENUM_SF14_REGISTRY_STATE state;int revision;long created_at_utc_msc;long updated_at_utc_msc;string supersedes_entry_id;bool no_execution_authority;string entry_hash;};
string SF14_RegistryEntryCanonical(const SF14_ModelRegistryEntry &v){return "alpha_lab.strategy_factory/model_registry_entry@1.0.0|"+v.entry_id+"|"+v.model_id+"|"+v.model_version+"|"+v.model_artifact_hash+"|"+v.scope_id+"|"+v.evidence_bundle_hash+"|"+v.evaluation_hash+"|"+IntegerToString((int)v.state)+"|"+IntegerToString(v.revision)+"|"+IntegerToString(v.created_at_utc_msc)+"|"+IntegerToString(v.updated_at_utc_msc)+"|"+v.supersedes_entry_id+"|"+SF01_CanonicalBool(v.no_execution_authority);}
string SF14_DeriveRegistryEntryHash(const SF14_ModelRegistryEntry &v){return SF01_StableId("mreg",SF14_RegistryEntryCanonical(v));}
bool SF14_ValidateRegistryEntry(const SF14_ModelRegistryEntry &v,string &error){if(v.entry_id==""||v.model_id==""||v.model_version==""||v.model_artifact_hash==""||v.scope_id==""||v.evidence_bundle_hash==""||v.revision<1||v.updated_at_utc_msc<v.created_at_utc_msc||!v.no_execution_authority){error="invalid registry entry identity, revision or authority";return false;}if((v.state==SF14_STATE_EVIDENCE_VALIDATED||v.state==SF14_STATE_CANDIDATE||v.state==SF14_STATE_CHALLENGER||v.state==SF14_STATE_CHAMPION)&&v.evaluation_hash==""){error="governed registry state requires evaluation";return false;}if(v.entry_hash!=""&&v.entry_hash!=SF14_DeriveRegistryEntryHash(v)){error="registry entry hash mismatch";return false;}error="";return true;}
#endif
