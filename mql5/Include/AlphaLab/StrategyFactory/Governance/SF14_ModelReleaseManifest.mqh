#ifndef __SF14_MODEL_RELEASE_MANIFEST_MQH__
#define __SF14_MODEL_RELEASE_MANIFEST_MQH__
#include "SF14_RollbackPlan.mqh"
struct SF14_ModelReleaseManifest{string release_id;string release_version;ENUM_SF14_RELEASE_CHANNEL channel;string registry_snapshot_hash;string registry_entry_hash;string model_artifact_hash;string transform_hash;string calibration_hash;string feature_schema_hash;string label_contract_hash;string artifact_inventory_hash;string attestation_hash;long created_at_utc_msc;bool no_execution_authority;string release_hash;};
string SF14_ModelReleaseCanonical(const SF14_ModelReleaseManifest &v){return "alpha_lab.strategy_factory/model_release_manifest@1.0.0|"+v.release_id+"|"+v.release_version+"|"+IntegerToString((int)v.channel)+"|"+v.registry_snapshot_hash+"|"+v.registry_entry_hash+"|"+v.model_artifact_hash+"|"+v.transform_hash+"|"+v.calibration_hash+"|"+v.feature_schema_hash+"|"+v.label_contract_hash+"|"+v.artifact_inventory_hash+"|"+v.attestation_hash+"|"+IntegerToString(v.created_at_utc_msc)+"|"+SF01_CanonicalBool(v.no_execution_authority);}
string SF14_DeriveModelReleaseHash(const SF14_ModelReleaseManifest &v){return SF01_StableId("mrel",SF14_ModelReleaseCanonical(v));}
bool SF14_ValidateModelRelease(const SF14_ModelReleaseManifest &v,string &error){if(v.release_id==""||v.release_version==""||v.registry_snapshot_hash==""||v.registry_entry_hash==""||v.model_artifact_hash==""||v.transform_hash==""||v.feature_schema_hash==""||v.label_contract_hash==""||v.artifact_inventory_hash==""||!v.no_execution_authority){error="invalid model release lineage or authority";return false;}if(v.channel==SF14_RELEASE_SHADOW_ELIGIBLE&&v.attestation_hash==""){error="shadow release requires attestation";return false;}if(v.release_hash!=""&&v.release_hash!=SF14_DeriveModelReleaseHash(v)){error="model release hash mismatch";return false;}error="";return true;}
#endif
