#ifndef __SF14_MODEL_EVIDENCE_BUNDLE_MQH__
#define __SF14_MODEL_EVIDENCE_BUNDLE_MQH__
#include "../Training/SF13_ModelArtifact.mqh"
struct SF14_ModelEvidenceBundle{string bundle_id;string model_id;string model_version;string model_artifact_hash;string transform_hash;string calibration_hash;string feature_schema_hash;string label_contract_hash;string dataset_hash;string training_plan_hash;string training_report_hash;string model_card_hash;string prediction_rowset_hash;string anti_overfit_report_hash;string phase12_promotion_decision_hash;string code_revision;string artifact_inventory_hash;string attestation_hash;long created_at_utc_msc;bool no_execution_authority;string bundle_hash;};
string SF14_ModelEvidenceCanonical(const SF14_ModelEvidenceBundle &v){return "alpha_lab.strategy_factory/model_evidence_bundle@1.0.0|"+v.bundle_id+"|"+v.model_id+"|"+v.model_version+"|"+v.model_artifact_hash+"|"+v.transform_hash+"|"+v.calibration_hash+"|"+v.feature_schema_hash+"|"+v.label_contract_hash+"|"+v.dataset_hash+"|"+v.training_plan_hash+"|"+v.training_report_hash+"|"+v.model_card_hash+"|"+v.prediction_rowset_hash+"|"+v.anti_overfit_report_hash+"|"+v.phase12_promotion_decision_hash+"|"+v.code_revision+"|"+v.artifact_inventory_hash+"|"+v.attestation_hash+"|"+IntegerToString(v.created_at_utc_msc)+"|"+SF01_CanonicalBool(v.no_execution_authority);}
string SF14_DeriveEvidenceBundleHash(const SF14_ModelEvidenceBundle &v){return SF01_StableId("mevb",SF14_ModelEvidenceCanonical(v));}
bool SF14_ValidateModelEvidence(const SF14_ModelEvidenceBundle &v,string &error){if(v.bundle_id==""||v.model_id==""||v.model_version==""||v.model_artifact_hash==""||v.transform_hash==""||v.feature_schema_hash==""||v.label_contract_hash==""||v.dataset_hash==""||v.training_plan_hash==""||v.training_report_hash==""||v.model_card_hash==""||v.prediction_rowset_hash==""||v.anti_overfit_report_hash==""||v.phase12_promotion_decision_hash==""||v.code_revision==""||v.artifact_inventory_hash==""||!v.no_execution_authority){error="invalid model evidence lineage or authority";return false;}if(v.bundle_hash!=""&&v.bundle_hash!=SF14_DeriveEvidenceBundleHash(v)){error="model evidence bundle hash mismatch";return false;}error="";return true;}
#endif
