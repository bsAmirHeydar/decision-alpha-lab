#ifndef __SF13_MODEL_ARTIFACT_MQH__
#define __SF13_MODEL_ARTIFACT_MQH__
#include "SF13_TransformState.mqh"
struct SF13_ModelArtifact{string model_id;string model_version;ENUM_SF13_MODEL_FAMILY family;int task;string training_plan_hash;string dataset_hash;string feature_schema_hash;string label_contract_hash;string transform_hash;string training_rowset_hash;int parameter_count;string parameter_names[SF13_MAX_PARAMETERS];double parameter_values[SF13_MAX_PARAMETERS];ENUM_SF13_DATASET_ROLE selected_on_role;int random_seed;bool no_execution_authority;string artifact_hash;};
string SF13_ModelArtifactCanonical(const SF13_ModelArtifact &v){string values="";for(int i=0;i<v.parameter_count;i++)values+="|"+v.parameter_names[i]+"="+SF01_CanonicalDouble(v.parameter_values[i],10);return "alpha_lab.strategy_factory/model_artifact@1.0.0|"+v.model_id+"|"+v.model_version+"|"+IntegerToString((int)v.family)+"|"+IntegerToString(v.task)+"|"+v.training_plan_hash+"|"+v.dataset_hash+"|"+v.feature_schema_hash+"|"+v.label_contract_hash+"|"+v.transform_hash+"|"+v.training_rowset_hash+values+"|"+IntegerToString((int)v.selected_on_role)+"|"+IntegerToString(v.random_seed)+"|"+SF01_CanonicalBool(v.no_execution_authority);}
string SF13_DeriveModelArtifactHash(const SF13_ModelArtifact &v){return SF01_StableId("model",SF13_ModelArtifactCanonical(v));}
bool SF13_ValidateModelArtifact(const SF13_ModelArtifact &v,string &error){if(v.model_id==""||v.model_version==""||v.training_plan_hash==""||v.dataset_hash==""||v.feature_schema_hash==""||v.label_contract_hash==""||v.transform_hash==""||v.training_rowset_hash==""||v.parameter_count<0||v.parameter_count>SF13_MAX_PARAMETERS||v.selected_on_role!=SF13_ROLE_VALIDATION||!v.no_execution_authority){error="invalid model artifact authority or lineage";return false;}if(v.artifact_hash!=""&&v.artifact_hash!=SF13_DeriveModelArtifactHash(v)){error="model artifact hash mismatch";return false;}error="";return true;}
#endif
