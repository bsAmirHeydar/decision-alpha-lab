#ifndef __SF13_DATASET_MANIFEST_MQH__
#define __SF13_DATASET_MANIFEST_MQH__
#include "SF13_DatasetRow.mqh"
struct SF13_DatasetManifest{string dataset_id;string dataset_version;string strategy_id;string source_run_id;string source_manifest_hash;string source_artifact_hash;string validation_plan_hash;string feature_schema_hash;string label_contract_hash;int row_count;int train_count;int validation_count;int test_count;int excluded_count;string rowset_hash;long created_at_utc_msc;string code_revision;string dataset_hash;};
string SF13_DatasetManifestCanonical(const SF13_DatasetManifest &v){return "alpha_lab.strategy_factory/dataset_manifest@1.0.0|"+v.dataset_id+"|"+v.dataset_version+"|"+v.strategy_id+"|"+v.source_run_id+"|"+v.source_manifest_hash+"|"+v.source_artifact_hash+"|"+v.validation_plan_hash+"|"+v.feature_schema_hash+"|"+v.label_contract_hash+"|"+IntegerToString(v.row_count)+"|"+IntegerToString(v.train_count)+"|"+IntegerToString(v.validation_count)+"|"+IntegerToString(v.test_count)+"|"+IntegerToString(v.excluded_count)+"|"+v.rowset_hash+"|"+IntegerToString(v.created_at_utc_msc)+"|"+v.code_revision;}
string SF13_DeriveDatasetHash(const SF13_DatasetManifest &v){return SF01_StableId("dset",SF13_DatasetManifestCanonical(v));}
bool SF13_ValidateDatasetManifest(const SF13_DatasetManifest &v,string &error){if(v.dataset_id==""||v.dataset_version==""||v.strategy_id==""||v.source_run_id==""||v.source_manifest_hash==""||v.source_artifact_hash==""||v.validation_plan_hash==""||v.feature_schema_hash==""||v.label_contract_hash==""||v.rowset_hash==""||v.code_revision==""){error="missing dataset manifest lineage";return false;}if(v.row_count<0||v.train_count<0||v.validation_count<0||v.test_count<0||v.excluded_count<0||v.train_count+v.validation_count+v.test_count+v.excluded_count!=v.row_count){error="dataset counts do not reconcile";return false;}if(v.dataset_hash!=""&&v.dataset_hash!=SF13_DeriveDatasetHash(v)){error="dataset hash mismatch";return false;}error="";return true;}
#endif
