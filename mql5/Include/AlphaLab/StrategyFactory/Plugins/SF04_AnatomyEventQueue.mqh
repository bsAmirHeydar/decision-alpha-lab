#ifndef __SF04_ANATOMY_EVENT_QUEUE_MQH__
#define __SF04_ANATOMY_EVENT_QUEUE_MQH__
#include "../Contracts/SF01_AnatomyEvent.mqh"
#include "SF04_PluginEnums.mqh"
#include "SF04_PluginTelemetry.mqh"
class CSF04AnatomyEventQueue{private:SF01_AnatomyEvent m_items[];string m_recent[];int m_capacity,m_head,m_count,m_recent_capacity;ENUM_SF04_QUEUE_OVERFLOW_POLICY m_policy;CSF04PluginTelemetry *m_telemetry;bool m_failed;bool Seen(const string id)const{for(int i=0;i<ArraySize(m_recent);i++)if(m_recent[i]==id)return true;return false;}void Remember(const string id){if(m_recent_capacity<=0)return;int n=ArraySize(m_recent);if(n<m_recent_capacity){ArrayResize(m_recent,n+1);m_recent[n]=id;return;}for(int i=1;i<n;i++)m_recent[i-1]=m_recent[i];m_recent[n-1]=id;}void Update(void){if(CheckPointer(m_telemetry)!=POINTER_INVALID)m_telemetry.Queue(m_count,m_capacity);}public:CSF04AnatomyEventQueue(void){m_capacity=0;m_head=0;m_count=0;m_recent_capacity=0;m_policy=SF04_QUEUE_REJECT_NEW;m_telemetry=NULL;m_failed=false;}void BindTelemetry(CSF04PluginTelemetry *v){m_telemetry=v;}bool Initialize(const int c,const ENUM_SF04_QUEUE_OVERFLOW_POLICY p,const int d,string &e){if(c<1||c>65536){e="queue capacity out of range";return false;}if(d<0||d>65536){e="duplicate window out of range";return false;}m_capacity=c;m_policy=p;m_recent_capacity=d;m_head=0;m_count=0;m_failed=false;ArrayResize(m_items,c);ArrayResize(m_recent,0);Update();e="";return true;}bool Push(SF01_AnatomyEvent &event,string &e){if(m_failed){e="queue failed";return false;}if(event.event_id=="")event.event_id=SF01_DeriveAnatomyEventId(event);string ve="";if(!SF01_ValidateAnatomyEvent(event,ve)){if(CheckPointer(m_telemetry)!=POINTER_INVALID)m_telemetry.Rejected();e="invalid event: "+ve;return false;}if(Seen(event.event_id)){if(CheckPointer(m_telemetry)!=POINTER_INVALID)m_telemetry.Duplicate();e="duplicate event";return false;}if(m_count>=m_capacity){if(CheckPointer(m_telemetry)!=POINTER_INVALID)m_telemetry.Overflow();if(m_policy==SF04_QUEUE_REJECT_NEW){e="queue full";return false;}if(m_policy==SF04_QUEUE_FAIL_PLUGIN){m_failed=true;e="queue overflow failed plugin";return false;}m_head=(m_head+1)%m_capacity;m_count--;}int tail=(m_head+m_count)%m_capacity;m_items[tail]=event;m_count++;Remember(event.event_id);if(CheckPointer(m_telemetry)!=POINTER_INVALID)m_telemetry.Emitted();Update();e="";return true;}bool Pop(SF01_AnatomyEvent &event){if(m_count<=0)return false;event=m_items[m_head];m_head=(m_head+1)%m_capacity;m_count--;if(CheckPointer(m_telemetry)!=POINTER_INVALID)m_telemetry.Popped();Update();return true;}int Count(void)const{return m_count;}int Capacity(void)const{return m_capacity;}bool Failed(void)const{return m_failed;}void Clear(void){m_head=0;m_count=0;m_failed=false;ArrayResize(m_recent,0);Update();}};
#endif
