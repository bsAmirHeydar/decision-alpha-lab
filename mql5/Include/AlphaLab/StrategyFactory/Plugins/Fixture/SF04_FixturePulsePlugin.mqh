#ifndef __SF04_FIXTURE_PULSE_PLUGIN_MQH__
#define __SF04_FIXTURE_PULSE_PLUGIN_MQH__
#include "../SF04_PluginVersion.mqh"
#include "../SF04_AnatomyPluginBase.mqh"
class CSF04FixturePulsePlugin:public CSF04AnatomyPluginBase{private:string m_symbol;int m_timeframe_seconds,m_lookback_bars,m_ticks_per_event;long m_tick_count,m_event_sequence;protected:bool OnPluginInitialize(string &e){m_tick_count=0;m_event_sequence=0;e="";return true;}bool OnPluginStart(string &e){e="";return true;}void OnPluginStop(void){}void OnPluginShutdown(void){}void OnPluginTimer(const long now){}void OnPluginTick(const MqlTick &tick){m_tick_count++;if(m_ticks_per_event<=0||(m_tick_count%m_ticks_per_event)!=0)return;if(tick.bid<=0.0||tick.ask<tick.bid)return;SF03_SymbolSpecSnapshot spec;string e="";if(!m_specs.GetSnapshot(m_symbol,spec,e))return;long t=(tick.time_msc>0)?(long)tick.time_msc:m_clock.UtcNowMilliseconds();bool is_long=(m_event_sequence%2)==0;double ref=is_long?tick.ask:tick.bid;double offset=MathMax(spec.point*10.0,spec.tick_size*4.0);SF01_AnatomyEvent event;event.schema=SF01_AnatomyEventSchema();event.strategy_id=m_runtime_config.strategy_id;event.strategy_version=m_runtime_config.strategy_version;event.producer_id=m_descriptor.plugin_id;event.producer_version=m_descriptor.version;event.symbol=m_symbol;event.reference_symbol=m_symbol;event.direction=is_long?SF01_DIRECTION_LONG:SF01_DIRECTION_SHORT;event.event_time=SF01_MakeUtcMilliseconds(t,"UTC",0,"sf04.fixture",SF01_TIME_MILLISECONDS);event.known_time=event.event_time;event.confirmation_time=event.event_time;event.reference_price=ref;event.invalidation_price=is_long?(ref-offset):(ref+offset);event.timeframe_seconds=m_timeframe_seconds;event.session_id="fixture_session";event.parent_event_id="none";event.market_event_cluster_id=SF01_StableId("cluster",m_symbol+"|"+IntegerToString(t));event.source_hash=SF01_StableId("src",m_descriptor.plugin_id+"|"+IntegerToString(m_event_sequence));event.anatomy_state="confirmed";event.event_id=SF01_DeriveAnatomyEventId(event);if(EmitEvent(event,e))m_event_sequence++;}public:CSF04FixturePulsePlugin(const string symbol,const int tf,const int lookback,const int ticks_per_event){m_symbol=symbol;m_timeframe_seconds=tf;m_lookback_bars=lookback;m_ticks_per_event=ticks_per_event;m_tick_count=0;m_event_sequence=0;m_descriptor=SF04_DefaultAnatomyDescriptor();m_descriptor.plugin_id="sf04.fixture.pulse";m_descriptor.display_name="SF04 Fixture Pulse Anatomy";m_descriptor.version="1.0.0";m_descriptor.provider_id="alpha_lab.strategy_factory";m_descriptor.provider_version=SF04_PluginKernelVersion();m_descriptor.capability_mask=SF04_CAP_TICK_INPUT|SF04_CAP_CLOSED_BAR_INPUT|SF04_CAP_REPLAY_SAFE|SF04_CAP_DETERMINISTIC|SF04_CAP_FAST_PATH_SAFE|SF04_CAP_STATEFUL|SF04_CAP_EMITS_CLUSTER_ID|SF04_CAP_REQUIRES_SYMBOL_SPEC;m_descriptor.update_scope_mask=SF04_UPDATE_TICK|SF04_UPDATE_TIMER|SF04_UPDATE_REPLAY;m_descriptor.event_queue_capacity=128;m_descriptor.queue_overflow_policy=SF04_QUEUE_FAIL_PLUGIN;m_descriptor.deterministic=true;m_descriptor.replay_safe=true;m_descriptor.fast_path_safe=true;m_descriptor.stateful=true;m_descriptor.description="Synthetic fixture proving the anatomy plugin SDK.";m_descriptor.configuration_schema_hash=SF01_StableId("cfg",symbol+"|"+IntegerToString(tf)+"|"+IntegerToString(lookback)+"|"+IntegerToString(ticks_per_event));string x="";SF04_DataRequirement tick;tick.requirement_id="primary_tick";tick.kind=SF04_REQUIREMENT_TICK;tick.strength=SF04_REQUIREMENT_REQUIRED;tick.symbol=m_symbol;tick.timeframe_seconds=0;tick.lookback_bars=0;tick.max_staleness_msc=5000;tick.max_close_skew_msc=0;tick.synchronization_group_id="";tick.purpose="event trigger";AddRequirement(tick,x);SF04_DataRequirement bars;bars.requirement_id="primary_closed_bars";bars.kind=SF04_REQUIREMENT_CLOSED_BARS;bars.strength=SF04_REQUIREMENT_REQUIRED;bars.symbol=m_symbol;bars.timeframe_seconds=m_timeframe_seconds;bars.lookback_bars=m_lookback_bars;bars.max_staleness_msc=(long)m_timeframe_seconds*3000;bars.max_close_skew_msc=0;bars.synchronization_group_id="fixture_primary";bars.purpose="startup history";AddRequirement(bars,x);SF04_DataRequirement spec;spec.requirement_id="primary_symbol_spec";spec.kind=SF04_REQUIREMENT_SYMBOL_SPEC;spec.strength=SF04_REQUIREMENT_REQUIRED;spec.symbol=m_symbol;spec.timeframe_seconds=0;spec.lookback_bars=0;spec.max_staleness_msc=0;spec.max_close_skew_msc=0;spec.synchronization_group_id="";spec.purpose="invalidation geometry";AddRequirement(spec,x);}};
#endif
