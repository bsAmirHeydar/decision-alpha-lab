#ifndef __SF04_PLUGIN_TELEMETRY_MQH__
#define __SF04_PLUGIN_TELEMETRY_MQH__
struct SF04_PluginTelemetrySnapshot{long ticks_received;long timers_received;long events_emitted;long events_popped;long events_rejected;long duplicate_events;long queue_overflows;int queue_depth;int queue_capacity;ulong last_processing_microseconds;ulong max_processing_microseconds;};
class CSF04PluginTelemetry{private:SF04_PluginTelemetrySnapshot m;public:CSF04PluginTelemetry(void){Reset();}void Reset(void){m.ticks_received=0;m.timers_received=0;m.events_emitted=0;m.events_popped=0;m.events_rejected=0;m.duplicate_events=0;m.queue_overflows=0;m.queue_depth=0;m.queue_capacity=0;m.last_processing_microseconds=0;m.max_processing_microseconds=0;}void Tick(void){m.ticks_received++;}void Timer(void){m.timers_received++;}void Emitted(void){m.events_emitted++;}void Popped(void){m.events_popped++;}void Rejected(void){m.events_rejected++;}void Duplicate(void){m.duplicate_events++;}void Overflow(void){m.queue_overflows++;}void Queue(const int d,const int c){m.queue_depth=d;m.queue_capacity=c;}void Processing(const ulong e){m.last_processing_microseconds=e;if(e>m.max_processing_microseconds)m.max_processing_microseconds=e;}SF04_PluginTelemetrySnapshot Snapshot(void)const{return m;}};
#endif
