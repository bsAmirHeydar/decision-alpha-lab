#ifndef __SF04_DATA_REQUIREMENT_MQH__
#define __SF04_DATA_REQUIREMENT_MQH__
#include "../Contracts/SF01_StringCodec.mqh"
#include "SF04_PluginEnums.mqh"
struct SF04_DataRequirement{string requirement_id;ENUM_SF04_REQUIREMENT_KIND kind;ENUM_SF04_REQUIREMENT_STRENGTH strength;string symbol;int timeframe_seconds;int lookback_bars;long max_staleness_msc;long max_close_skew_msc;string synchronization_group_id;string purpose;};
string SF04_DataRequirementCanonical(const SF04_DataRequirement &v){return v.requirement_id+"|"+IntegerToString((int)v.kind)+"|"+IntegerToString((int)v.strength)+"|"+v.symbol+"|"+IntegerToString(v.timeframe_seconds)+"|"+IntegerToString(v.lookback_bars)+"|"+IntegerToString(v.max_staleness_msc)+"|"+IntegerToString(v.max_close_skew_msc)+"|"+v.synchronization_group_id;}
bool SF04_ValidateDataRequirement(const SF04_DataRequirement &v,string &e){if(!SF01_IsSafeIdentifier(v.requirement_id,128)){e="invalid requirement id";return false;}if(v.kind==SF04_REQUIREMENT_UNKNOWN){e="unknown requirement kind";return false;}if(!SF01_IsSafeTerminalSymbol(v.symbol)){e="invalid symbol";return false;}if(v.kind==SF04_REQUIREMENT_CLOSED_BARS){if(v.timeframe_seconds<=0){e="positive timeframe required";return false;}if(v.lookback_bars<2||v.lookback_bars>100000){e="lookback out of range";return false;}}else if(v.timeframe_seconds<0||v.lookback_bars<0){e="negative timeframe or lookback";return false;}if(v.max_staleness_msc<0||v.max_close_skew_msc<0){e="negative freshness or skew";return false;}if(v.synchronization_group_id!=""&&!SF01_IsSafeIdentifier(v.synchronization_group_id,128)){e="invalid sync group";return false;}e="";return true;}
#endif
