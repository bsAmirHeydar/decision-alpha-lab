#ifndef __SF04_ANATOMY_PLUGIN_BASE_MQH__
#define __SF04_ANATOMY_PLUGIN_BASE_MQH__
#include "ISF04_AnatomyPlugin.mqh"
#include "SF04_PluginRequirements.mqh"
#include "SF04_AnatomyEventQueue.mqh"
class CSF04AnatomyPluginBase:public ISF04AnatomyPlugin{protected:SF04_PluginDescriptor m_descriptor;CSF04PluginRequirements m_requirements;CSF04PluginTelemetry m_telemetry;CSF04AnatomyEventQueue m_queue;ISF02ClockPort *m_clock;CSF03MarketDataService *m_market;CSF03SymbolSpecCache *m_specs;SF02_RuntimeConfig m_runtime_config;ENUM_SF04_PLUGIN_STATUS m_status;string m_last_error;virtual bool OnPluginInitialize(string &error)=0;virtual bool OnPluginStart(string &error)=0;virtual void OnPluginStop(void)=0;virtual void OnPluginShutdown(void)=0;virtual void OnPluginTick(const MqlTick &tick)=0;virtual void OnPluginTimer(const long now_utc_msc)=0;bool EmitEvent(SF01_AnatomyEvent &event,string &error){if(event.strategy_id=="")event.strategy_id=m_runtime_config.strategy_id;if(event.strategy_version=="")event.strategy_version=m_runtime_config.strategy_version;if(event.producer_id=="")event.producer_id=m_descriptor.plugin_id;if(event.producer_version=="")event.producer_version=m_descriptor.version;return m_queue.Push(event,error);}bool AddRequirement(const SF04_DataRequirement &v,string &e){return m_requirements.Add(v,e);}public:CSF04AnatomyPluginBase(void){m_descriptor=SF04_DefaultAnatomyDescriptor();m_clock=NULL;m_market=NULL;m_specs=NULL;m_status=SF04_PLUGIN_STATUS_CREATED;m_last_error="";m_queue.BindTelemetry(&m_telemetry);}virtual string ServiceId(void)const{return m_descriptor.plugin_id;}virtual ENUM_SF02_SERVICE_KIND ServiceKind(void)const{return SF02_SERVICE_ANATOMY;}virtual void GetDescriptor(SF04_PluginDescriptor &d)const{d=m_descriptor;}virtual string DescriptorHash(void)const{return SF04_PluginDescriptorHash(m_descriptor);}virtual int RequirementCount(void)const{return m_requirements.Count();}virtual bool GetRequirement(const int i,SF04_DataRequirement &r)const{return m_requirements.At(i,r);}virtual ENUM_SF04_PLUGIN_STATUS PluginStatus(void)const{return m_status;}virtual SF04_PluginTelemetrySnapshot PluginTelemetry(void)const{return m_telemetry.Snapshot();}virtual bool BindSharedServices(ISF02ClockPort *c,CSF03MarketDataService *m,CSF03SymbolSpecCache *s,string &e){if(CheckPointer(c)==POINTER_INVALID||CheckPointer(m)==POINTER_INVALID||CheckPointer(s)==POINTER_INVALID){e="invalid shared-service binding";return false;}m_clock=c;m_market=m;m_specs=s;m_status=SF04_PLUGIN_STATUS_BOUND;e="";return true;}virtual bool ValidatePluginConfiguration(string &e)const{if(!SF04_ValidatePluginDescriptor(m_descriptor,e))return false;if(m_descriptor.kind!=SF04_PLUGIN_ANATOMY){e="not anatomy plugin";return false;}if(CheckPointer(m_clock)==POINTER_INVALID||CheckPointer(m_market)==POINTER_INVALID||CheckPointer(m_specs)==POINTER_INVALID){e="shared services not bound";return false;}if(!m_requirements.Validate(e))return false;e="";return true;}virtual bool Initialize(const SF02_RuntimeConfig &c,string &e){if(m_status!=SF04_PLUGIN_STATUS_BOUND){e="plugin must be BOUND";return false;}m_runtime_config=c;if(!ValidatePluginConfiguration(e)){m_status=SF04_PLUGIN_STATUS_FAILED;m_last_error=e;return false;}if(!m_queue.Initialize(m_descriptor.event_queue_capacity,m_descriptor.queue_overflow_policy,m_descriptor.event_queue_capacity*4,e)){m_status=SF04_PLUGIN_STATUS_FAILED;m_last_error=e;return false;}if(!OnPluginInitialize(e)){m_status=SF04_PLUGIN_STATUS_FAILED;m_last_error=e;return false;}m_status=SF04_PLUGIN_STATUS_INITIALIZED;e="";return true;}virtual bool Start(string &e){if(m_status!=SF04_PLUGIN_STATUS_INITIALIZED){e="plugin not initialized";return false;}if(!OnPluginStart(e)){m_status=SF04_PLUGIN_STATUS_FAILED;m_last_error=e;return false;}m_status=SF04_PLUGIN_STATUS_RUNNING;e="";return true;}virtual void Stop(void){if(m_status==SF04_PLUGIN_STATUS_RUNNING)OnPluginStop();if(m_status!=SF04_PLUGIN_STATUS_FAILED)m_status=SF04_PLUGIN_STATUS_STOPPED;}virtual void Shutdown(void){OnPluginShutdown();m_queue.Clear();m_clock=NULL;m_market=NULL;m_specs=NULL;if(m_status!=SF04_PLUGIN_STATUS_FAILED)m_status=SF04_PLUGIN_STATUS_STOPPED;}virtual SF02_ServiceHealth Health(const long now)const{SF02_ServiceHealth h;h.service_id=ServiceId();h.service_kind=ServiceKind();h.observed_at_utc_msc=now;if(m_status==SF04_PLUGIN_STATUS_RUNNING){h.status=SF02_HEALTH_HEALTHY;h.detail="running";}else if(m_status==SF04_PLUGIN_STATUS_FAILED){h.status=SF02_HEALTH_UNHEALTHY;h.detail=m_last_error;}else{h.status=SF02_HEALTH_DEGRADED;h.detail="not running";}return h;}virtual void ProcessTick(const MqlTick &tick){if(m_status!=SF04_PLUGIN_STATUS_RUNNING)return;ulong started=m_clock.MonotonicMicroseconds();m_telemetry.Tick();OnPluginTick(tick);m_telemetry.Processing(m_clock.MonotonicMicroseconds()-started);}virtual void ProcessTimer(const long now){if(m_status!=SF04_PLUGIN_STATUS_RUNNING)return;ulong started=m_clock.MonotonicMicroseconds();m_telemetry.Timer();OnPluginTimer(now);m_telemetry.Processing(m_clock.MonotonicMicroseconds()-started);}virtual bool PopEvent(SF01_AnatomyEvent &e){return m_queue.Pop(e);}virtual int PendingEventCount(void)const{return m_queue.Count();}};
#endif
