#ifndef __SF04_PLUGIN_STARTUP_VALIDATOR_MQH__
#define __SF04_PLUGIN_STARTUP_VALIDATOR_MQH__
#include "ISF04_AnatomyPlugin.mqh"
struct SF04_StartupValidationReport{bool ready;int requirement_count;int prepared_count;int optional_failures;int required_failures;string requirements_hash;string detail;};
class CSF04PluginStartupValidator{private:CSF03MarketDataService *m_market;CSF03SymbolSpecCache *m_specs;ISF02ClockPort *m_clock;bool PrepareOne(const SF04_DataRequirement &r,string &e){if(!m_market.EnsureSymbol(r.symbol,e))return false;if(r.kind==SF04_REQUIREMENT_TICK)return m_market.RefreshTick(r.symbol,e);if(r.kind==SF04_REQUIREMENT_SYMBOL_SPEC){SF03_SymbolSpecSnapshot s;return m_specs.GetSnapshot(r.symbol,s,e);}if(r.kind==SF04_REQUIREMENT_CLOSED_BARS){if(!m_market.RegisterSeries(r.symbol,r.timeframe_seconds,e))return false;int copied=m_market.RefreshSeries(r.symbol,r.timeframe_seconds,r.lookback_bars,e);if(copied<=0)return false;SF01_BarRecord b;if(!m_market.LatestClosedBar(r.symbol,r.timeframe_seconds,b,e))return false;if(r.max_staleness_msc>0&&m_clock.UtcNowMilliseconds()-b.close_time.utc_epoch_milliseconds>r.max_staleness_msc){e="closed-bar series stale";return false;}return true;}e="unknown requirement";return false;}public:CSF04PluginStartupValidator(void){m_market=NULL;m_specs=NULL;m_clock=NULL;}void Bind(CSF03MarketDataService *m,CSF03SymbolSpecCache *s,ISF02ClockPort *c){m_market=m;m_specs=s;m_clock=c;}bool ValidateAndPrepare(ISF04AnatomyPlugin *p,SF04_StartupValidationReport &r,string &e){r.ready=false;r.requirement_count=0;r.prepared_count=0;r.optional_failures=0;r.required_failures=0;r.requirements_hash="";r.detail="";if(CheckPointer(p)==POINTER_INVALID||CheckPointer(m_market)==POINTER_INVALID||CheckPointer(m_specs)==POINTER_INVALID||CheckPointer(m_clock)==POINTER_INVALID){e="validator not bound";return false;}if(!p.ValidatePluginConfiguration(e))return false;CSF04PluginRequirements all;int n=p.RequirementCount();r.requirement_count=n;for(int i=0;i<n;i++){SF04_DataRequirement q;if(!p.GetRequirement(i,q)){e="requirement lookup failed";return false;}string x="";if(!all.Add(q,x)){e="invalid requirement: "+x;return false;}if(PrepareOne(q,x))r.prepared_count++;else if(q.strength==SF04_REQUIREMENT_REQUIRED){r.required_failures++;r.detail=x;e="required resource failed: "+x;return false;}else r.optional_failures++;}r.requirements_hash=all.Hash();r.ready=r.required_failures==0;r.detail=r.ready?"READY":"NOT_READY";e="";return r.ready;}};
#endif
