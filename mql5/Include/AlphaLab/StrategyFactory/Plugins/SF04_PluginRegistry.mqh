#ifndef __SF04_PLUGIN_REGISTRY_MQH__
#define __SF04_PLUGIN_REGISTRY_MQH__
#include "ISF04_PluginFactory.mqh"
#include "SF04_PluginSelection.mqh"
class CSF04PluginRegistry{private:ISF04AnatomyPluginFactory *m_factories[];bool Same(const SF04_PluginDescriptor &a,const SF04_PluginDescriptor &b)const{return a.plugin_id==b.plugin_id&&a.version==b.version;}public:int Count(void)const{return ArraySize(m_factories);}bool RegisterFactory(ISF04AnatomyPluginFactory *f,string &e){if(CheckPointer(f)==POINTER_INVALID){e="invalid factory";return false;}SF04_PluginDescriptor d;f.GetDescriptor(d);if(!SF04_ValidatePluginDescriptor(d,e))return false;if(d.kind!=SF04_PLUGIN_ANATOMY){e="anatomy registry only";return false;}for(int i=0;i<ArraySize(m_factories);i++){SF04_PluginDescriptor x;m_factories[i].GetDescriptor(x);if(Same(x,d)){e="duplicate plugin identity";return false;}}int n=ArraySize(m_factories);ArrayResize(m_factories,n+1);m_factories[n]=f;e="";return true;}bool DescriptorAt(const int i,SF04_PluginDescriptor &d)const{if(i<0||i>=ArraySize(m_factories))return false;m_factories[i].GetDescriptor(d);return true;}bool ResolveFactory(const SF04_PluginSelection &s,ISF04AnatomyPluginFactory *&f,SF04_PluginDescriptor &d,string &e)const{f=NULL;if(!SF04_ValidatePluginSelection(s,e))return false;for(int i=0;i<ArraySize(m_factories);i++){SF04_PluginDescriptor x;m_factories[i].GetDescriptor(x);if(x.plugin_id==s.plugin_id&&x.version==s.exact_version){if(!SF04_DescriptorMatchesSelection(x,s,e))return false;f=m_factories[i];d=x;e="";return true;}}e="plugin selection not found";return false;}bool Create(const SF04_PluginSelection &s,ISF04AnatomyPlugin *&p,SF04_PluginDescriptor &d,string &e)const{p=NULL;ISF04AnatomyPluginFactory *f=NULL;if(!ResolveFactory(s,f,d,e))return false;p=f.Create(e);if(CheckPointer(p)==POINTER_INVALID){if(e=="")e="invalid plugin pointer";return false;}SF04_PluginDescriptor actual;p.GetDescriptor(actual);if(SF04_PluginDescriptorHash(actual)!=SF04_PluginDescriptorHash(d)){delete p;p=NULL;e="factory-instance descriptor mismatch";return false;}e="";return true;}bool ValidateAll(string &e)const{for(int i=0;i<ArraySize(m_factories);i++){SF04_PluginDescriptor a;m_factories[i].GetDescriptor(a);if(!SF04_ValidatePluginDescriptor(a,e))return false;for(int j=i+1;j<ArraySize(m_factories);j++){SF04_PluginDescriptor b;m_factories[j].GetDescriptor(b);if(Same(a,b)){e="duplicate registry identity";return false;}}}e="";return true;}};
#endif
