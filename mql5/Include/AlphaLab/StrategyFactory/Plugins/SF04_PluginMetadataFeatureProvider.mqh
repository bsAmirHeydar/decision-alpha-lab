#ifndef __SF04_PLUGIN_METADATA_FEATURE_PROVIDER_MQH__
#define __SF04_PLUGIN_METADATA_FEATURE_PROVIDER_MQH__
#include "../Ports/ISF02_FeatureProvider.mqh"
#include "../Contracts/SF01_FeatureValue.mqh"
#include "ISF04_AnatomyPlugin.mqh"
class CSF04PluginMetadataFeatureProvider:public ISF02FeatureProvider{private:ISF04AnatomyPlugin *m_plugin;bool m_initialized,m_started;public:CSF04PluginMetadataFeatureProvider(void){m_plugin=NULL;m_initialized=false;m_started=false;}void BindPlugin(ISF04AnatomyPlugin *v){m_plugin=v;}string ServiceId(void)const{return "sf04.plugin_metadata_features";}ENUM_SF02_SERVICE_KIND ServiceKind(void)const{return SF02_SERVICE_FEATURES;}bool Initialize(const SF02_RuntimeConfig &c,string &e){if(CheckPointer(m_plugin)==POINTER_INVALID){e="plugin not bound";return false;}m_initialized=true;e="";return true;}bool Start(string &e){if(!m_initialized){e="not initialized";return false;}m_started=true;e="";return true;}void Stop(void){m_started=false;}void Shutdown(void){m_started=false;m_initialized=false;m_plugin=NULL;}SF02_ServiceHealth Health(const long now)const{SF02_ServiceHealth h;h.service_id=ServiceId();h.service_kind=ServiceKind();h.observed_at_utc_msc=now;h.status=(m_initialized&&m_started)?SF02_HEALTH_HEALTHY:SF02_HEALTH_DEGRADED;h.detail=(m_initialized&&m_started)?"running":"not running";return h;}bool BuildSnapshot(const SF01_AnatomyEvent &event,const long generation,CSF01FeatureSnapshot &s,string &e){if(!m_started){e="feature provider not started";return false;}SF04_PluginDescriptor d;m_plugin.GetDescriptor(d);s.schema=SF01_FeatureSnapshotSchema();s.event_id=event.event_id;s.strategy_id=event.strategy_id;s.snapshot_time=event.confirmation_time;s.producer_id=ServiceId();s.producer_version="1.0.0";s.source_hash=m_plugin.DescriptorHash();s.state_generation=generation;SF01_FeatureValue f1=SF01_MakeIntegerFeature("plugin_capability_mask","1.0.0",(long)d.capability_mask,event.known_time,event.event_id,d.plugin_id);if(!s.Add(f1,e))return false;SF01_FeatureValue f2=SF01_MakeIntegerFeature("event_direction","1.0.0",(long)event.direction,event.known_time,event.event_id,d.plugin_id);if(!s.Add(f2,e))return false;SF01_FeatureValue f3=SF01_MakeDoubleFeature("anatomy_risk_distance","1.0.0",MathAbs(event.reference_price-event.invalidation_price),event.known_time,event.event_id,d.plugin_id);if(!s.Add(f3,e))return false;s.snapshot_id=s.DeriveId();return s.Validate(e);}};
#endif
