enum UCEI08_AlgorithmFamily{UCEI08_FAMILY_BASELINE=0,UCEI08_FAMILY_LINEAR=1,UCEI08_FAMILY_TREE=2,UCEI08_FAMILY_BOOSTING=3,UCEI08_FAMILY_KERNEL=4,UCEI08_FAMILY_NEIGHBORHOOD=5,UCEI08_FAMILY_PROBABILISTIC=6,UCEI08_FAMILY_ADDITIVE=7,UCEI08_FAMILY_OPTIONAL_EXTERNAL=8};
enum UCEI08_AvailabilityState{UCEI08_AVAILABLE=0,UCEI08_UNAVAILABLE=1,UCEI08_INCOMPATIBLE=2,UCEI08_DISABLED=3};
enum UCEI08_CalibrationDisclosure{UCEI08_CALIBRATED=0,UCEI08_UNCALIBRATED=1,UCEI08_NOT_APPLICABLE=2};
enum UCEI08_BenchmarkStatus{UCEI08_BENCH_SUCCEEDED=0,UCEI08_BENCH_FAILED=1,UCEI08_BENCH_SKIPPED_UNAVAILABLE=2,UCEI08_BENCH_REJECTED=3};
enum UCEI08_GateState{UCEI08_GATE_PASS=0,UCEI08_GATE_BLOCK=1,UCEI08_GATE_REVIEW=2};
