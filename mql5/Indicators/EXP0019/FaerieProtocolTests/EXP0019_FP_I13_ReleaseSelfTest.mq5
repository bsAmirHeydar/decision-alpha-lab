#property strict
#property indicator_chart_window
#property indicator_plots 0
#include <AlphaLab/EXP0019/FaerieProtocol/I13/FP_I13_All.mqh>
input ENUM_FP_I13_RELEASE_PROFILE InpProfile=FP_I13_TRADING_30D;
int OnInit(){SFP_I13_Profile p=FP_I13_ReleaseProfiles::Resolve(InpProfile);if(p.history_days<=0||p.max_objects<100||p.chunk_size<=0){Print("FP-I13 profile self-test failed");return INIT_FAILED;}string reason="";if(!FP_I13_InstanceIsolation::Validate(ChartID(),"FPINST-SELFTEST",reason)){Print(reason);return INIT_FAILED;}SFP_I13_Config c;c.instance_id="FPINST-SELFTEST";c.profile=InpProfile;c.history_days=p.history_days;c.max_objects=p.max_objects;c.max_object_ops_per_frame=p.max_object_ops_per_frame;c.chunk_size=p.chunk_size;c.telemetry_enabled=true;c.diagnostics_interval_seconds=60;c.open_decision_state="UNSET";FP_I13_ReleaseGuard g;if(!g.Initialize(ChartID(),c.instance_id,c,reason)){Print(reason);return INIT_FAILED;}g.ObserveFrame(1000,10,2,100,false);SFP_I13_Telemetry t=g.Telemetry();if(t.budget_status!=FP_I13_BUDGET_PASS){Print("FP-I13 budget self-test failed");return INIT_FAILED;}SFP_I13_Acceptance a=g.Acceptance();if(a.status!=FP_I13_SOURCE_ACCEPTED_EXTERNAL_COMPILE_PENDING){Print("FP-I13 acceptance state failed");return INIT_FAILED;}Print("FP-I13 ReleaseSelfTest PASS reason=",a.reason_code);return INIT_SUCCEEDED;}
int OnCalculate(const int rates_total,const int prev_calculated,const datetime &time[],const double &open[],const double &high[],const double &low[],const double &close[],const long &tick_volume[],const long &volume[],const int &spread[]){return rates_total;}
