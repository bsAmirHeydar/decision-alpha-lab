#property strict
#include <AlphaLab/StrategyFactory/TrainerSDK/UCEI07_All.mqh>
#define CHECK(x,m) if(!(x)){Print("FAIL: ",m);return INIT_FAILED;}
int OnInit(){string reason;CUCEI07TrainerRegistry r;CUCEI07ReferenceCatalog c;CHECK(c.RegisterAll(r,reason),reason);CHECK(r.Size()==3,"registry size");UCEI07_TrainerCapability cap;CHECK(r.ResolveExact("uce.reference.prior_binary","1.0.0",cap,reason),reason);CHECK(!r.ResolveExact("uce.reference.prior_binary","9.9.9",cap,reason),"exact version must fail");CUCEI07TrainerLifecycle life;CHECK(life.Transition(UCEI07_PHASE_CONFIGURED,reason),reason);CHECK(life.Transition(UCEI07_PHASE_VALIDATED,reason),reason);CHECK(life.Transition(UCEI07_PHASE_FITTING,reason),reason);CHECK(life.Transition(UCEI07_PHASE_FITTED,reason),reason);CHECK(!life.Transition(UCEI07_PHASE_CONFIGURED,reason),"illegal transition accepted");CUCEI07TestSeal seal;UCEI07_AccessAuditRecord audit;CHECK(!seal.Authorize(UCEI07_ROLE_FINAL_TEST,UCEI07_ACCESS_PREDICT_FINAL_TEST,"final_test",cap.trainer_id,audit),"test leaked before lock");seal.LockSelection();CHECK(seal.Authorize(UCEI07_ROLE_FINAL_TEST,UCEI07_ACCESS_PREDICT_FINAL_TEST,"final_test",cap.trainer_id,audit),audit.reason);CHECK(!seal.Authorize(UCEI07_ROLE_FINAL_TEST,UCEI07_ACCESS_PREDICT_FINAL_TEST,"final_test",cap.trainer_id,audit),"second final-test read accepted");Print("UCE-I07 trainer SDK self-test PASS");return INIT_SUCCEEDED;}
void OnTick(){}
