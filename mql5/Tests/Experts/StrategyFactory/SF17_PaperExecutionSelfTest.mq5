#property strict
#include <AlphaLab/StrategyFactory/Execution/SF17_AllExecution.mqh>
bool AssertTrue(const bool value,const string label){if(!value)Print("FAIL: ",label);return value;}
SF16_ExecutionIntent FixtureIntent(){SF16_ExecutionIntent i;i.intent_id="intent_sf17";i.batch_id="batch";i.candidate_id="candidate";i.candidate_hash="candidate_hash";i.context_frame_id="context";i.strategy_id="reference";i.strategy_version="1.0.0";i.symbol="TEST";i.group_id="indices";i.direction=1;i.runtime_generation_id=17;i.model_id="model";i.model_version="1.0.0";i.model_release_hash="release";i.decision_policy_hash="dpol";i.risk_policy_hash="rpol";i.allocation_policy_hash="apol";i.order_kind=SF08_ORDER_LIMIT;i.entry_price=100.0;i.stop_price=98.0;i.target_price=104.0;i.has_target=true;i.volume=1.0;i.risk_budget_cash=100.0;i.expected_max_loss_cash=80.0;i.planned_r_multiple=2.0;i.model_score=0.8;i.ranking_score=1.0;i.priority=1;i.created_at_utc_msc=1700000000000;i.expires_at_utc_msc=1700000060000;i.authority=SF16_AUTHORITY_PAPER_ELIGIBLE;i.intent_hash=SF16_DeriveIntentHash(i);return i;}
int OnInit(){CSF17PaperExecutionEngine e;string error;bool ok=e.Configure("sf17-self-test",SF17_ReferencePolicy(),error);SF17_PaperOrder o;SF16_ExecutionIntent i=FixtureIntent();ok=AssertTrue(ok&&e.Submit(i,1700000000000,o,error),"submit")&&ok;ok=AssertTrue(e.OnQuote(SF17_ReferenceQuote(100.4,100.5,1700000001000,1),1700000001000,error),"quote1")&&ok;ok=AssertTrue(e.OnQuote(SF17_ReferenceQuote(99.8,99.9,1700000002000,2),1700000002000,error),"quote2")&&ok;ok=AssertTrue(e.OnQuote(SF17_ReferenceQuote(99.7,99.8,1700000003000,3),1700000003000,error),"quote3")&&ok;ok=AssertTrue(e.OnQuote(SF17_ReferenceQuote(104.2,104.3,1700000004000,4),1700000004000,error),"quote4")&&ok;SF17_PositionRecord p;ok=AssertTrue(e.OrderCount()==1&&e.FillCount()>=2&&e.PositionCount()==1&&e.GetPosition(0,p)&&p.state==SF17_POSITION_CLOSED,"lifecycle")&&ok;Print(ok?"SF17 SELF TEST PASS":"SF17 SELF TEST FAIL");return ok?INIT_SUCCEEDED:INIT_FAILED;}
