#property strict
#property description "UCEE-I03 deterministic treatment atom self-test; no broker authority"
#include <AlphaLab/StrategyFactory/TreatmentAtoms/UCEI03_All.mqh>
bool Assert(const bool condition,const string message){if(!condition)Print("ASSERT FAILED: ",message);return condition;}
int OnInit(){bool ok=true;string error;CUCEI03Catalog catalog;ok=Assert(catalog.Build(error),"catalog build "+error)&&ok;ok=Assert(catalog.Count()==50,"catalog count")&&ok;ok=Assert(catalog.entry.Count()==8&&catalog.stop.Count()==8&&catalog.target.Count()==7&&catalog.trailing.Count()==10&&catalog.management.Count()==8&&catalog.sizing.Count()==9,"registry counts")&&ok;for(int s=0;s<2;s++){ENUM_UCEI03_SIDE side=s==0?UCEI03_LONG:UCEI03_SHORT;UCEI03_BuildContext c;UCEI03_MakeFixtureContext(side,c);UCEI03_Invocation i;UCEI03_MakeFixtureInvocation(side,i);UCEI03_EntryPlan ep;ok=Assert(UCEI03_BuildImmediateMarket(c,i,ep,error),"market entry")&&ok;double expected=side==UCEI03_LONG?100.02:100.00;ok=Assert(MathAbs(ep.legs[0].trigger_price-expected)<0.000001,"executable side")&&ok;UCEI03_StopPlan sp;ok=Assert(UCEI03_BuildFixedDistanceStop(c,i,20.0,sp,error),"fixed stop")&&ok;double stop_expected=side==UCEI03_LONG?99.82:100.20;ok=Assert(MathAbs(sp.stop_price-stop_expected)<0.000001,"stop side")&&ok;UCEI03_TargetPlan tp;ok=Assert(UCEI03_BuildFixedRTarget(c,i,100.0,2.0,tp,error),"fixed R target")&&ok;double target_expected=side==UCEI03_LONG?102.02:98.00;ok=Assert(MathAbs(tp.legs[0].target_price-target_expected)<0.000001,"target side")&&ok;}UCEI03_ConformanceTelemetry telemetry;ok=Assert(UCEI03_RunCatalogConformance(catalog,telemetry,error),"conformance")&&ok;Print(ok?"UCE-I03 SELF TEST PASS":"UCE-I03 SELF TEST FAIL");return ok?INIT_SUCCEEDED:INIT_FAILED;}
void OnTick(){}
