#property strict
#property version "1.00"
#include <AlphaLab\StrategyFactory\Anatomy\SF06_AllAnatomy.mqh>
int OnInit(){string e="";SF01_MarketTimestamp t=SF01_MakeUtcMilliseconds(1783771260000,"UTC",0,"fixture",SF01_TIME_MILLISECONDS);SF06_AnatomyObservation o;o.schema="alpha_lab.strategy_factory/anatomy_observation@1.0.0";o.observation_id="";o.plugin_id="sf06.reference.sweep_rejection";o.plugin_version="1.0.0";o.symbol="EURUSD";o.timeframe_seconds=60;o.kind=SF06_OBS_REFERENCE_SWEEP_HIGH;o.occurred_at=t;o.known_at=t;o.reference_price=1.1000;o.extreme_price=1.1010;o.close_price=1.0995;o.source_bar_id="bar_fixture_002";o.source_hash="src_fixture_001";o.market_event_cluster_id="cluster_fixture_001";o.observation_id=SF06_DeriveObservationId(o);if(!SF06_ValidateObservation(o,e)){Print(e);return INIT_FAILED;}CSF06LifecycleTracker tracker;if(!tracker.Begin(o.observation_id))return INIT_FAILED;SF06_LifecycleRecord r;if(!tracker.Transition(SF06_LIFE_OBSERVED,t,"fixture_observed",o.source_hash,r,e))return INIT_FAILED;if(!tracker.Transition(SF06_LIFE_CONFIRMED,t,"fixture_confirmed",o.source_hash,r,e))return INIT_FAILED;if(!tracker.Transition(SF06_LIFE_EMITTED,t,"fixture_emitted",o.source_hash,r,e))return INIT_FAILED;SF06_EventBuildInput in;in.strategy_id="sf06_reference_anatomy";in.strategy_version="1.0.0";in.producer_id=o.plugin_id;in.producer_version=o.plugin_version;in.symbol=o.symbol;in.reference_symbol=o.symbol;in.direction=SF01_DIRECTION_SHORT;in.timeframe_seconds=o.timeframe_seconds;in.event_time=t;in.known_time=t;in.confirmation_time=t;in.reference_price=o.reference_price;in.invalidation_price=o.extreme_price;in.session_id="fixture_session";in.parent_event_id="none";in.market_event_cluster_id=o.market_event_cluster_id;in.source_hash=o.source_hash;in.anatomy_state="confirmed";SF01_AnatomyEvent event;if(!SF06_BuildCanonicalEvent(in,event,e)){Print(e);return INIT_FAILED;}Print("SF06 self-test PASS obs=",o.observation_id," event=",event.event_id);return INIT_SUCCEEDED;}
