#property strict
#property version "20.000"
#include <AlphaLab/StrategyFactory/Integration/SF20_AllIntegration.mqh>
#include <AlphaLab/StrategyFactory/Integration/EXP0017/Fixture/SF20_EXP0017Fixture.mqh>
bool Expect(const bool condition,const string message){if(condition)return true;Print("SF20 self-test failure: ",message);return false;}
int OnInit(){string error;SF20_EXP0017Config cfg=SF20_DefaultEXP0017Config();if(!Expect(SF20_ValidateEXP0017Config(cfg,error),error))return INIT_FAILED;SCGDDivergenceCandidate c;SF20_BuildReferenceLegacyCandidate(true,c);SF01_AnatomyEvent a,b;SF20_EXP0017MappingRecord ma,mb;if(!Expect(SF20_MapEXP0017Candidate(c,cfg,1783795000000,"exp0017_cycle_group_divergence","1.0.0",a,ma,error),error))return INIT_FAILED;c.hunter_current_extreme-=10.0;if(!Expect(SF20_MapEXP0017Candidate(c,cfg,1783795000000,"exp0017_cycle_group_divergence","1.0.0",b,mb,error),error))return INIT_FAILED;if(!Expect(a.event_id==b.event_id,"dynamic extreme changed canonical identity"))return INIT_FAILED;if(!Expect(a.symbol=="NDXUSD"&&a.reference_symbol=="SPXUSD","clean/hunter mapping"))return INIT_FAILED;if(!Expect(a.event_time.utc_epoch_milliseconds==a.known_time.utc_epoch_milliseconds&&a.known_time.utc_epoch_milliseconds==a.confirmation_time.utc_epoch_milliseconds,"known-time causality"))return INIT_FAILED;CSF20EXP0017DedupRegistry d;if(!d.Configure(4,error))return INIT_FAILED;d.BeginPulse();bool is_new=false;SF20_EXP0017LifecycleRecord rec;if(!d.Observe(a.event_id,1,is_new,rec,error)||!Expect(is_new,"first event not new"))return INIT_FAILED;if(!d.Observe(a.event_id,2,is_new,rec,error)||!Expect(!is_new,"duplicate not suppressed"))return INIT_FAILED;cfg.live_authority=true;if(!Expect(!SF20_ValidateEXP0017Config(cfg,error),"live authority accepted"))return INIT_FAILED;Print("SF20 EXP0017 integration self-test passed");return INIT_SUCCEEDED;}
