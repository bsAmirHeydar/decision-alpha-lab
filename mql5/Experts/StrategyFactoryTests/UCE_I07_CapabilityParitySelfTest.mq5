#property strict
#include <AlphaLab/StrategyFactory/TrainerSDK/UCEI07_All.mqh>
#define CHECK(x,m) if(!(x)){Print("FAIL: ",m);return INIT_FAILED;}
int OnInit(){string reason;CUCEI07TrainerRegistry r;CUCEI07ReferenceCatalog cat;CHECK(cat.RegisterAll(r,reason),reason);UCEI07_TrainerCapability cap;CHECK(r.ResolveExact("uce.reference.prior_binary","1.0.0",cap,reason),reason);UCEI07_TaskContract task;task.task_id="binary_edge";task.task_version="1.0.0";task.task_kind=UCEI07_TASK_BINARY;task.view_kind=UCEI07_VIEW_TABULAR;task.target_shape="scalar_binary";task.sample_weight_required=true;task.calibration_required=false;UCEI07_DatasetSchema schema;schema.row_count=100;schema.feature_count=8;schema.output_count=1;schema.tensor_kind="dense_float64";UCEI07_ResourceBudget budget;budget.max_rows=1000;budget.max_features=100;budget.max_outputs=2;budget.max_memory_mb=512;budget.max_wall_ms=60000;budget.max_workers=1;budget.device="cpu";budget.precision="float64";budget.deterministic_required=true;CUCEI07CapabilityMatcher m;CHECK(m.Match(cap,task,schema,budget,reason),reason);task.view_kind=UCEI07_VIEW_SEQUENCE;CHECK(!m.Match(cap,task,schema,budget,reason),"unsupported sequence view accepted");Print("UCE-I07 capability parity self-test PASS");return INIT_SUCCEEDED;}
void OnTick(){}
