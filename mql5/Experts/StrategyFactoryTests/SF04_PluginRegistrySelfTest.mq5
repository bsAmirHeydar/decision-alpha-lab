#property strict
#property version "1.00"
#include <AlphaLab\StrategyFactory\Testing\SF02_Assert.mqh>
#include <AlphaLab\StrategyFactory\Testing\SF02_FixtureServices.mqh>
#include <AlphaLab\StrategyFactory\Testing\SF03_FixtureMarketSource.mqh>
#include <AlphaLab\StrategyFactory\Market\SF03_AllMarket.mqh>
#include <AlphaLab\StrategyFactory\Plugins\SF04_AllPlugins.mqh>
int OnInit(){CSF02Assert checks;string e="";SF02_RuntimeConfig c=SF02_DefaultRuntimeConfig();c.strategy_id="sf04_self_test";c.strategy_version="1.0.0";c.run_id="sf04_self_test_run";CSF02FixtureClock clock;CSF03FixtureMarketSource source;CSF03MarketDataService market;CSF03SymbolSpecCache specs;market.BindSource(&source);market.BindClock(&clock);specs.BindSource(&source);MqlTick tick;tick.time=(datetime)1783771260;tick.time_msc=1783771260000;tick.bid=1.10000;tick.ask=1.10020;tick.last=1.10010;tick.volume=1;source.PutTick("EURUSD",tick,e);SF03_SymbolSpecSnapshot spec;spec.symbol="EURUSD";spec.digits=5;spec.point=0.00001;spec.tick_size=0.00001;spec.tick_value=1.0;spec.contract_size=100000.0;spec.volume_min=0.01;spec.volume_max=100.0;spec.volume_step=0.01;spec.stops_level_points=0;spec.freeze_level_points=0;spec.filling_mode=0;spec.order_mode=0;spec.trade_mode=0;spec.observed_at_utc_msc=clock.UtcNowMilliseconds();spec.specification_generation=1;source.PutSpec(spec,e);SF01_BarRecord bars[3];for(int i=0;i<3;i++){long t=1783771020000+(long)i*60000;bars[i].schema=SF01_BarRecordSchema();bars[i].symbol="EURUSD";bars[i].timeframe_seconds=60;bars[i].open_time=SF01_MakeUtcMilliseconds(t,"UTC",0,"fixture",SF01_TIME_MILLISECONDS);bars[i].close_time=SF01_MakeUtcMilliseconds(t+60000,"UTC",0,"fixture",SF01_TIME_MILLISECONDS);bars[i].open=1.1000+i*0.0001;bars[i].high=bars[i].open+0.0003;bars[i].low=bars[i].open-0.0002;bars[i].close=bars[i].open+0.0001;bars[i].tick_volume=100;bars[i].real_volume=0;bars[i].bid_close=bars[i].close;bars[i].ask_close=bars[i].close+0.00002;bars[i].spread_points=2;bars[i].source_id="fixture";bars[i].source_bar_id=SF01_StableId("bar",LongToString(t));}source.PutBars("EURUSD",60,bars,e);checks.True(market.Initialize(c,e),"market init");checks.True(specs.Initialize(c,e),"spec init");checks.True(market.Start(e),"market start");checks.True(specs.Start(e),"spec start");CSF04FixturePulseFactory f;f.Configure("EURUSD",60,3,1);CSF04PluginRegistry r;checks.True(r.RegisterFactory(&f,e),"register");checks.EqualInt(r.Count(),1,"registry count");checks.False(r.RegisterFactory(&f,e),"duplicate reject");SF04_PluginSelection s;s.plugin_id="sf04.fixture.pulse";s.exact_version="1.0.0";s.required_capabilities=SF04_CAP_DETERMINISTIC|SF04_CAP_TICK_INPUT;s.expected_descriptor_hash="";ISF04AnatomyPlugin *p=NULL;SF04_PluginDescriptor d;checks.True(r.Create(s,p,d,e),"create");checks.True(CheckPointer(p)!=POINTER_INVALID,"pointer");checks.True(p.BindSharedServices(&clock,&market,&specs,e),"bind");CSF04PluginStartupValidator v;v.Bind(&market,&specs,&clock);SF04_StartupValidationReport report;checks.True(v.ValidateAndPrepare(p,report,e),"prepare");checks.EqualInt(report.requirement_count,3,"requirement count");checks.True(p.Initialize(c,e),"plugin init");checks.True(p.Start(e),"plugin start");p.ProcessTick(tick);checks.EqualInt(p.PendingEventCount(),1,"queued");SF01_AnatomyEvent event;checks.True(p.PopEvent(event),"pop");checks.True(event.event_id!="","event id");checks.True(event.market_event_cluster_id!="","cluster id");SF04_PluginTelemetrySnapshot telemetry=p.PluginTelemetry();checks.EqualLong(telemetry.events_emitted,1,"emitted");checks.EqualLong(telemetry.events_popped,1,"popped");p.Stop();p.Shutdown();delete p;market.Stop();specs.Stop();market.Shutdown();specs.Shutdown();Print("SF04 checks=",checks.Total()," failed=",checks.Failed());return checks.Failed()==0?INIT_SUCCEEDED:INIT_FAILED;}
