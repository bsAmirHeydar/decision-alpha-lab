{
  "$id": "https://decision-alpha-lab.local/schemas/saed-v4-11/membership_audit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "audit_id": {
      "type": "string"
    },
    "canary_count": {
      "type": "integer"
    },
    "checkpoint_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "hits": {
      "items": {},
      "type": "array"
    },
    "method": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "phase": {
      "type": "string"
    }
  },
  "required": [
    "audit_hash",
    "audit_id",
    "canary_count",
    "checkpoint_hash",
    "hits",
    "method",
    "passed",
    "phase"
  ],
  "title": "Membership Audit",
  "type": "object"
}
