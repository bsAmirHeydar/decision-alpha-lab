{
  "$id": "https://decision-alpha-lab.local/schemas/saed-v4-11/claim_ledger.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "supported": {
            "type": "boolean"
          }
        },
        "required": [
          "basis",
          "claim",
          "supported"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ledger_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ledger_id": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "synthetic_reference_only": {
      "type": "boolean"
    }
  },
  "required": [
    "claims",
    "ledger_hash",
    "ledger_id",
    "phase",
    "synthetic_reference_only"
  ],
  "title": "Claim Ledger",
  "type": "object"
}
