{
  "$id": "https://decision-alpha-lab.local/schemas/saed-v4-11/objective_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "curriculum": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "epochs": {
            "type": "integer"
          },
          "max_pairs_per_record": {
            "type": "integer"
          },
          "objective_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "stage_id": {
            "type": "string"
          }
        },
        "required": [
          "epochs",
          "max_pairs_per_record",
          "objective_ids",
          "stage_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "forbidden_objectives": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "objectives": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "objective_id": {
            "type": "string"
          },
          "objective_kind": {
            "type": "string"
          },
          "outcome_supervised": {
            "type": "boolean"
          },
          "weight": {
            "type": "number"
          }
        },
        "required": [
          "enabled",
          "objective_id",
          "objective_kind",
          "outcome_supervised",
          "weight"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "phase": {
      "type": "string"
    },
    "registry_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "registry_id": {
      "type": "string"
    }
  },
  "required": [
    "curriculum",
    "forbidden_objectives",
    "objectives",
    "phase",
    "registry_hash",
    "registry_id"
  ],
  "title": "Objective Registry",
  "type": "object"
}
