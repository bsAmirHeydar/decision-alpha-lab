{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compiler_version": {
      "minLength": 1,
      "type": "string"
    },
    "exact_version": {
      "minLength": 1,
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "semantic_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "initialized",
        "rejected"
      ]
    },
    "twin_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "twin_id",
    "semantic_hash",
    "exact_version",
    "compiler_version",
    "status",
    "reason_codes"
  ],
  "title": "Twin Initialization Result",
  "type": "object"
}
