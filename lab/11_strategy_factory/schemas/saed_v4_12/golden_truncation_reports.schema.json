{
  "$id": "https://decision-alpha-lab.local/schemas/saed-v4-12/golden_truncation_reports.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed golden reference contract. Unknown fields fail validation. This schema does not confer production authority.",
  "properties": {
    "count": {
      "type": "integer"
    },
    "phase": {
      "type": "string"
    },
    "reports": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "mean_max_abs_diff": {
            "type": "number"
          },
          "report_hash": {
            "type": "string"
          },
          "rows": {
