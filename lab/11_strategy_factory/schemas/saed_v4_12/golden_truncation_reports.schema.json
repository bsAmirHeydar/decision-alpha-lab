              "additionalProperties": false,
              "properties": {
                "max_abs_diff": {
                  "type": "number"
                },
                "sequence_id": {
                  "type": "string"
                },
                "split": {
                  "type": "string"
                }
              },
              "required": [
                "max_abs_diff",
                "sequence_id",
                "split"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "candidate_id",
          "mean_max_abs_diff",
          "report_hash",
          "rows"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "count",
    "phase",
    "reports"
  ],
  "title": "SAED V4-12 Golden Truncation Reports",
  "type": "object"
}
