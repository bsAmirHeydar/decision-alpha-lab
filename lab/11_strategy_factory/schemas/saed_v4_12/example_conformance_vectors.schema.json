{
  "$id": "https://decision-alpha-lab.local/schemas/saed-v4-12/example_conformance_vectors.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Closed SAED V4-12 example input contract.",
  "items": {
    "additionalProperties": false,
    "properties": {
      "candidate": {
        "additionalProperties": false,
        "properties": {
          "architecture": {
            "type": "string"
          },
          "candidate_id": {
            "type": "string"
          },
          "context_steps": {
            "type": "integer"
          },
          "enabled": {
            "type": "boolean"
          },
          "seed": {
            "type": "integer"
          },
          "state_dim": {
            "type": "integer"
          }
        },
        "required": [
          "architecture",
          "candidate_id",
          "context_steps",
          "enabled",
          "seed",
          "state_dim"
        ],
        "type": "object"
      },
      "dts": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "input_dim": {
        "type": "integer"
      },
      "inputs": {
        "items": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "type": "array"
      },
      "tolerance": {
        "type": "number"
      },
      "vector_id": {
        "type": "string"
      }
    },
    "required": [
      "candidate",
      "dts",
      "input_dim",
      "inputs",
      "tolerance",
      "vector_id"
    ],
    "type": "object"
  },
  "title": "Example Conformance Vectors",
  "type": "array"
}
