{
  "$id": "https://alpha-lab.local/schemas/saed-v4-19/golden_provenance_graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "relation": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "relation",
          "source",
          "target"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "graph_hash": {
      "type": "string"
    },
    "nodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content_hash": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "node_type": {
            "type": "string"
          }
        },
        "required": [
          "content_hash",
          "node_id",
          "node_type"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "edges",
    "graph_hash",
    "nodes"
  ],
  "title": "Golden Provenance Graph",
  "type": "object"
}
