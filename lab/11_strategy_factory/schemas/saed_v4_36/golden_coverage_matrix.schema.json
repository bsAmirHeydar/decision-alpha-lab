          "claim_id",
          "dimensions",
          "mean_coverage",
          "mean_uncertainty"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "claim_count",
    "matrix_hash",
    "matrix_id",
    "phase",
    "research_only",
    "rows"
  ],
  "title": "GOLDEN_COVERAGE_MATRIX",
  "type": "object"
}
