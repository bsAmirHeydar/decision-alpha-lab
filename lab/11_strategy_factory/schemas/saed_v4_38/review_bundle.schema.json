        "required": [
          "review_id",
          "role",
          "release_hash",
          "decision",
          "findings",
          "independent",
          "reviewer_id",
          "review_hash"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "role_count": {
      "type": "integer"
    }
