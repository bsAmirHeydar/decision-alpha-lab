{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "closed_contract": true,
  "properties": {
    "approved_external_runtime": {
      "type": "boolean"
    },
    "approved_reference": {
      "type": "boolean"
    },
    "phase": {
      "type": "string"
    },
    "production_authorized": {
      "type": "boolean"
    },
    "release_hash": {
      "type": "string"
    },
    "research_only": {
      "type": "boolean"
    },
    "review_bundle_hash": {
      "type": "string"
    },
    "review_bundle_id": {
      "type": "string"
    },
    "reviews": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "type": "string"
          },
          "findings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "independent": {
            "type": "boolean"
          },
          "release_hash": {
            "type": "string"
          },
          "review_hash": {
            "type": "string"
          },
          "review_id": {
            "type": "string"
          },
