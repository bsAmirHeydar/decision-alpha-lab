              "ui_surface": {
                "type": "string"
              }
            },
            "required": [
              "selection_effect_possible",
              "ui_surface"
            ],
            "type": "object"
          },
          "object_hash": {
            "type": "string"
          },
          "object_id": {
            "type": "string"
          },
          "object_type": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string"
          },
          "previous_hash": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "query_id": {
            "type": "string"
          },
          "sequence": {
            "type": "integer"
          },
          "trial_id": {
            "type": "string"
          }
        },
        "required": [
          "actor_id",
          "actor_type",
          "chain",
          "data_role",
          "entry_hash",
          "event_id",
          "experiment_id",
          "exposure_type",
          "hypothesis_id",
          "known_at",
          "manual",
          "metadata",
          "object_hash",
          "object_id",
          "object_type",
          "occurred_at",
          "previous_hash",
          "purpose",
          "query_id",
          "sequence",
          "trial_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "event_count": {
      "type": "integer"
    },
    "exposure_ledger_hash": {
      "type": "string"
    },
    "exposure_ledger_id": {
      "type": "string"
    },
    "hash_linked": {
      "type": "boolean"
    },
    "hidden_evaluation_queries": {
      "type": "integer"
    },
    "network_requests": {
      "type": "integer"
    },
    "online_policy_mutations": {
      "type": "integer"
    },
    "order_submissions": {
      "type": "integer"
    },
    "phase": {
      "type": "string"
    },
    "protected_evidence_exposures": {
      "type": "integer"
    },
    "runtime_compilations": {
      "type": "integer"
    }
