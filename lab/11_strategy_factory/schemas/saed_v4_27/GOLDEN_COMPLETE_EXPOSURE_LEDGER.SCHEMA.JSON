  "required": [
    "append_only",
    "chain_receipt",
    "complete",
    "counts_by_actor",
    "counts_by_data_role",
    "counts_by_type",
    "duplicate_events_suppressed",
    "entries",
    "event_count",
    "exposure_ledger_hash",
    "exposure_ledger_id",
    "hash_linked",
    "hidden_evaluation_queries",
    "network_requests",
    "online_policy_mutations",
    "order_submissions",
    "phase",
    "protected_evidence_exposures",
    "runtime_compilations"
  ],
  "type": "object"
}
