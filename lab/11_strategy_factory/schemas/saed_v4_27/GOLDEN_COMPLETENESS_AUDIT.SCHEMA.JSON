      "additionalProperties": false,
      "properties": {
        "all_manifests_hash_bound": {
          "type": "boolean"
        },
        "all_trials_terminal": {
          "type": "boolean"
        },
        "duplicates_accounted": {
          "type": "boolean"
        },
        "expected_trials_equal_observed": {
          "type": "boolean"
        },
        "exposure_chain_verified": {
          "type": "boolean"
        },
        "failure_states_accounted": {
          "type": "boolean"
        },
        "hidden_query_zero": {
          "type": "boolean"
        },
        "multiplicity_complete": {
          "type": "boolean"
        },
        "no_missing_trials": {
          "type": "boolean"
        },
        "no_orphan_trials": {
          "type": "boolean"
        },
        "protected_exposure_zero": {
          "type": "boolean"
