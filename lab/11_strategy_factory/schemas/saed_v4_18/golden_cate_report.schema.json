{
  "$id": "https://decision-alpha-lab.local/lab/11_strategy_factory/schemas/saed_v4_18/golden_cate_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed SAED V4-18 deterministic synthetic reference contract. Unknown fields are forbidden.",
  "properties": {
    "algorithm": {
      "type": "string"
    },
    "baseline_treatment_id": {
      "type": "string"
    },
    "models": {
      "additionalProperties": false,
      "properties": {
        "t_adaptive_a": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "t_adaptive_b": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "t_manual": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "t_adaptive_a",
        "t_adaptive_b",
        "t_manual"
      ],
      "type": "object"
    },
    "phase": {
      "type": "string"
    },
    "report_hash": {
      "type": "string"
    },
    "summary": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "coefficient_count": {
            "type": "integer"
          },
          "mean_predicted_effect": {
            "type": "number"
          },
          "p10": {
            "type": "number"
          },
          "p50": {
            "type": "number"
          },
          "p90": {
            "type": "number"
          },
          "positive_share": {
            "type": "number"
          },
          "treatment_id": {
            "type": "string"
          }
        },
        "required": [
          "coefficient_count",
          "mean_predicted_effect",
          "p10",
          "p50",
          "p90",
          "positive_share",
          "treatment_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "synthetic_only": {
      "type": "boolean"
    }
  },
  "required": [
    "algorithm",
    "baseline_treatment_id",
    "models",
    "phase",
    "report_hash",
    "summary",
    "synthetic_only"
  ],
  "title": "GOLDEN_CATE_REPORT",
  "type": "object"
}
