{
  "$id": "https://decision-alpha-lab.local/schemas/v3/runtime_restart_snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_generation": {
      "minimum": 0,
      "type": "integer"
    },
    "bundle_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "journal_tail_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "bundle_hash",
    "active_generation",
    "journal_tail_hash"
  ],
  "title": "Runtime Restart Snapshot",
  "type": "object"
}
