      "type": "string"
    },
    "calibration_error": {
      "type": "number"
    },
    "economic_utility": {
      "type": "number"
    },
    "error_code": {
      "type": "string"
    },
    "fit_ms": {
      "minimum": 0,
      "type": "integer"
    },
    "predict_ms": {
      "minimum": 0,
      "type": "integer"
    },
    "primary_metric": {
