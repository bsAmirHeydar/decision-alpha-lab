{
  "$id": "https://decision-alpha-lab.local/schemas/v3/graph_artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "context_observation_id": {
      "minLength": 1,
      "type": "string"
    },
    "edges": {
      "items": {
        "items": {
          "minimum": 0,
          "type": "integer"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "known_time_ms": {
      "minimum": 0,
      "type": "integer"
    },
    "node_features": {
      "items": {
        "items": {
          "type": "number"
        },
        "minItems": 1,
        "type": "array"
      },
      "minItems": 1,
      "type": "array"
    },
    "node_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "node_times_ms": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "minItems": 1,
      "type": "array"
    },
    "spec_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "topology_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "spec_hash",
    "context_observation_id",
    "known_time_ms",
    "node_ids",
    "node_times_ms",
    "node_features",
    "edges",
    "topology_hash",
    "evidence_hash"
  ],
  "title": "graph_artifact",
  "type": "object"
}
