              "type": "string"
            },
            "epoch_ms": {
              "minimum": 0,
              "type": "integer"
            },
            "timezone": {
              "const": "UTC"
            }
          },
          "required": [
            "clock_id",
            "epoch_ms",
            "timezone"
          ],
          "type": "object"
