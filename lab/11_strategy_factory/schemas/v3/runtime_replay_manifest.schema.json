{
  "$id": "https://decision-alpha-lab.local/schemas/v3/runtime_replay_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "decision_hashes": {
      "type": "array"
    },
    "replay_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "replay_id": {
      "minLength": 1,
      "type": "string"
    },
    "request_hashes": {
      "type": "array"
    }
  },
  "required": [
    "replay_id",
    "bundle_hash",
    "request_hashes",
    "decision_hashes",
    "replay_hash"
  ],
  "title": "Runtime Replay Manifest",
  "type": "object"
}
