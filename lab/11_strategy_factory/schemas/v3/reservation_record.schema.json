{
  "$id": "https://decision-alpha-lab/schemas/v3/reservation_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "type": "string"
    },
    "consumed_cash": {
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
      "type": [
        "string",
        "number"
      ]
    },
    "correlation_group": {
      "type": "string"
    },
    "last_event_hash": {
      "type": "string"
    },
    "last_sequence": {
      "type": "integer"
    },
    "open_cash": {
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
      "type": [
        "string",
        "number"
      ]
    },
    "released_cash": {
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
      "type": [
        "string",
        "number"
      ]
    },
    "reservation_id": {
      "type": "string"
    },
    "reserved_cash": {
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
      "type": [
        "string",
        "number"
      ]
    },
    "state": {
      "type": "string"
    },
    "strategy_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "treatment_id": {
      "type": "string"
    }
  },
  "required": [
    "reservation_id",
    "account_id",
    "treatment_id",
    "reserved_cash",
    "consumed_cash",
    "released_cash",
    "open_cash",
    "state",
    "last_sequence",
    "last_event_hash"
  ],
  "title": "Reservation Record",
  "type": "object"
}
