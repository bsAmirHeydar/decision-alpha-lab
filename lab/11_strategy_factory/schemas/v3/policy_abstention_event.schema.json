{
  "$id": "https://decision-alpha-lab.local/schemas/v3/policy_abstention_event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "fallback_action": {
      "minLength": 1,
      "type": "string"
    },
    "occurrence_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "occurrence_id",
    "reason",
    "fallback_action",
    "evidence_hash"
  ],
  "title": "policy_abstention_event",
  "type": "object"
}
