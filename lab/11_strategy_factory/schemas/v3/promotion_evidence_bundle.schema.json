{
  "$id": "https://decision-alpha-lab.local/schemas/v3/promotion_evidence_bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "bundle_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "type": "string"
    },
    "bundle_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "candidate_key": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "type": "string"
    },
    "generated_known_time_ms": {
      "minimum": 0,
      "type": "integer"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "signature": {
      "pattern": "^(?:[0-9a-f]{64})?$",
      "type": "string"
    },
    "signer_key_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "type": "string"
    },
    "universe_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "bundle_version",
    "candidate_key",
    "universe_hash",
    "policy_hash",
    "artifact_hashes",
    "generated_known_time_ms",
    "signer_key_id",
    "signature"
  ],
  "title": "promotion_evidence_bundle",
  "type": "object"
}
