{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-alpha-lab.local/schemas/v3/operations_evidence_ref.schema.json",
  "title": "Operations Evidence Ref",
  "description": "Closed UCE-I19 contract for evidence ref.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "produced_at_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "evidence_id",
    "evidence_hash",
    "schema_version",
    "path",
    "produced_at_ms"
  ]
}
