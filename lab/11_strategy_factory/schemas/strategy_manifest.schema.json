{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-alpha-lab.local/schemas/strategy-manifest-1.0.0.json",
  "title": "Decision Alpha Lab Strategy Factory Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy",
    "anatomy_adapter",
    "features",
    "candidate_universe",
    "labels",
    "validation",
    "models",
    "execution"
  ],
  "properties": {
    "strategy": {
      "type": "object",
      "required": ["id", "version", "owner", "thesis", "null_hypothesis"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "status": {"type": "string"},
        "thesis": {"type": "string", "minLength": 1},
        "null_hypothesis": {"type": "string", "minLength": 1},
        "kill_criteria": {"type": "array", "items": {"type": "string"}}
      }
    },
    "anatomy_adapter": {
      "type": "object",
      "required": ["type", "version", "known_time_field", "event_id_fields"],
      "properties": {
        "type": {"type": "string"},
        "version": {"type": "string"},
        "known_time_field": {"type": "string"},
        "event_id_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "features": {
      "type": "object",
      "required": ["schema_version", "shared", "strategy_specific"],
      "properties": {
        "schema_version": {"type": "string"},
        "shared": {"type": "array", "items": {"type": "string"}},
        "strategy_specific": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "candidate_universe": {
      "type": "object",
      "required": ["entries", "stops", "exits", "max_candidates_per_event"],
      "properties": {
        "entries": {"type": "array", "minItems": 1},
        "stops": {"type": "array", "minItems": 1},
        "exits": {"type": "array", "minItems": 1},
        "max_candidates_per_event": {"type": "integer", "minimum": 1},
        "explicit_allow_pruning": {"type": "boolean"},
        "default_expiration_seconds": {"type": "integer", "minimum": 1},
        "default_max_holding_seconds": {"type": ["integer", "null"], "minimum": 1},
        "cost_model_id": {"type": "string"}
      }
    },
    "labels": {"type": "object"},
    "validation": {"type": "object"},
    "models": {"type": "object"},
    "execution": {"type": "object"}
  }
}
