{
  "$id": "https://decision-alpha-lab.local/schemas/saed_v4_29/GOLDEN_DISCLOSURE_ENVELOPE.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregate_metrics": {
      "additionalProperties": false,
      "properties": {
        "accuracy": {
          "type": "number"
        },
        "balanced_accuracy": {
          "type": "number"
        },
        "brier_score": {
          "type": "number"
        },
        "delta_balanced_accuracy_vs_baseline": {
          "type": "number"
        },
        "log_loss": {
          "type": "number"
        },
        "roc_auc": {
          "type": "number"
        }
      },
      "required": [
        "accuracy",
        "balanced_accuracy",
        "brier_score",
        "delta_balanced_accuracy_vs_baseline",
        "log_loss",
        "roc_auc"
      ],
      "type": "object"
    },
    "baseline_comparison": {
      "additionalProperties": false,
