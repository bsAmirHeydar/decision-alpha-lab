{
  "$id": "https://decision-alpha-lab.local/schemas/saed_v4_06/capability_profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "diagnostic_only": {
      "type": "boolean"
    },
    "exact_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "maximum_entry_legs": {
      "minimum": 1,
      "type": "integer"
    },
    "order_types": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "profile_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "profile_name": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "type": "string"
    },
    "supports_expiration": {
      "type": "boolean"
    },
    "supports_partial_exit": {
      "type": "boolean"
    },
    "supports_server_stop": {
      "type": "boolean"
    },
    "supports_trailing": {
      "type": "boolean"
    },
    "time_in_force": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "profile_name",
    "exact_version",
    "capabilities",
    "order_types",
    "time_in_force",
    "maximum_entry_legs",
    "supports_server_stop",
    "supports_partial_exit",
    "supports_trailing",
    "supports_expiration",
    "diagnostic_only",
    "profile_id",
    "profile_hash"
  ],
  "title": "Capability Profile",
  "type": "object"
}
