{
  "$id": "https://decision-alpha-lab.local/schemas/saed_v4_06/constraint_declaration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "constraint_name": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "requires_component",
        "excludes_component",
        "parameter_relation",
        "feature_predicate",
        "capability_required",
        "state_transition_guard"
      ],
      "type": "string"
    },
    "left_ref": {
      "type": "string"
    },
    "operator": {
      "enum": [
        "eq",
        "ne",
        "lt",
        "le",
        "gt",
        "ge",
        "in",
        "exists"
      ],
      "type": "string"
    },
    "right_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "right_value": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null",
        "array",
        "object"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "type": "string"
    }
  },
  "required": [
    "constraint_name",
    "kind",
    "left_ref",
    "operator",
    "right_value",
    "right_ref",
    "severity",
    "description"
  ],
  "title": "Constraint Declaration",
  "type": "object"
}
