{
  "$id": "https://decision-alpha-lab.local/schemas/saed_v4_06/parameter_definition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_values": {
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "default": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null",
        "array",
        "object"
      ]
    },
    "description": {
      "type": "string"
    },
    "identity_affecting": {
      "type": "boolean"
    },
    "maximum": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null",
        "array",
        "object"
      ]
    },
    "minimum": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null",
        "array",
        "object"
      ]
    },
    "monotonic_direction": {
      "enum": [
        "none",
        "increasing",
        "decreasing"
      ],
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "type": "string"
    },
    "parameter_type": {
      "enum": [
        "boolean",
        "integer",
        "decimal",
        "string",
        "enum",
        "duration_ms"
      ],
      "type": "string"
    },
    "required": {
      "type": "boolean"
    },
    "units": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "type": "string"
    }
  },
  "required": [
    "name",
    "parameter_type",
    "units",
    "default",
    "minimum",
    "maximum",
    "allowed_values",
    "required",
    "identity_affecting",
    "monotonic_direction",
    "description"
  ],
  "title": "Parameter Definition",
  "type": "object"
}
