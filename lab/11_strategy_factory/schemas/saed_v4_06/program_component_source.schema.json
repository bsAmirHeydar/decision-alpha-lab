{
  "$id": "https://decision-alpha-lab.local/schemas/saed_v4_06/program_component_source.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exact_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      },
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
      },
      "type": "object"
    },
    "primitive_id": {
      "enum": [
        "action.abstain",
        "action.skip",
        "capability.mt5_hedging",
        "cost.maximum_spread",
        "direction.context_declared",
        "entry.breakout_stop",
        "entry.market",
        "entry.passive_limit",
        "exit.time_stop",
        "management.none",
        "management.partial_scale",
        "payoff.asymmetric_r_multiple",
        "stop.context_invalidation",
        "stop.fixed_distance",
        "target.fixed_r_multiple",
        "time.session_window",
        "trail.break_even",
        "trail.none",
        "trigger.context_feature"
      ],
      "type": "string"
    },
    "slot": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "type": "string"
    }
  },
  "required": [
    "slot",
    "primitive_id",
    "exact_version",
    "parameters"
  ],
  "title": "Program Component Source",
  "type": "object"
}
