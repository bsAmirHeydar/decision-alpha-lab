{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_descriptors": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "catalog_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "catalog_id": {
      "minLength": 1,
      "type": "string"
    },
    "known_time": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "catalog_id",
    "artifact_descriptors",
    "catalog_hash",
    "known_time"
  ],
  "type": "object"
}