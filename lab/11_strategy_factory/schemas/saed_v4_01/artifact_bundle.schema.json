{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "bundle_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "bundle_id": {
      "minLength": 1,
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "lineage_root": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_registry_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "manifest_hash",
    "artifacts",
    "lineage_root",
    "schema_registry_hash",
    "limitations",
    "bundle_hash"
  ],
  "type": "object"
}