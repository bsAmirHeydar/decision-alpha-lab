{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data_role": {
      "enum": [
        "development",
        "calibration",
        "selection_validation",
        "locked_final",
        "prospective",
        "shadow",
        "micro_live",
        "live",
        "synthetic_stress",
        "external_static",
        "external_actual"
      ],
      "type": "string"
    },
    "entity_id": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "revision_id": {
      "minLength": 1,
      "type": "string"
    },
    "revision_number": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_name": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "connector_version": {
          "minLength": 1,
          "type": "string"
        },
        "jurisdiction": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "type": "string"
        },
        "trust_tier": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "jurisdiction",
        "trust_tier",
        "connector_version"
      ],
      "type": "object"
    },
    "supersedes_revision_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "temporal": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "event_time": {
          "format": "date-time",
          "type": "string"
        },
        "known_time": {
          "format": "date-time",
          "type": "string"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event_time",
        "known_time"
      ],
      "type": "object"
    }
  },
  "required": [
    "entity_id",
    "schema_name",
    "schema_version",
    "payload",
    "temporal",
    "source",
    "data_role",
    "revision_number",
    "supersedes_revision_id",
    "record_hash",
    "revision_id"
  ],
  "type": "object"
}