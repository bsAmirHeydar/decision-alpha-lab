{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "data_role": {
      "enum": [
        "development",
        "calibration",
        "selection_validation",
        "locked_final",
        "prospective",
        "shadow",
        "micro_live",
        "live",
        "synthetic_stress",
        "external_static",
        "external_actual"
      ],
      "type": "string"
    },
    "event_as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "known_as_of": {
      "format": "date-time",
      "type": "string"
    },
    "lineage_root": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "record_count": {
      "minimum": 0,
      "type": "integer"
    },
    "row_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_set_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "artifact_ids",
    "row_ids",
    "known_as_of",
    "event_as_of",
    "data_role",
    "schema_set_hash",
    "lineage_root",
    "record_count",
    "metadata",
    "snapshot_hash"
  ],
  "type": "object"
}