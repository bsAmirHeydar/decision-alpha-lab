{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data_role": {
      "enum": [
        "development",
        "calibration",
        "selection_validation",
        "locked_final",
        "prospective",
        "shadow",
        "micro_live",
        "live",
        "synthetic_stress",
        "external_static",
        "external_actual"
      ],
      "type": "string"
    },
    "event_as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "known_as_of": {
      "format": "date-time",
      "type": "string"
    },
    "query_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "query_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_names": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "query_id",
    "known_as_of",
    "event_as_of",
    "schema_names",
    "data_role",
    "query_hash"
  ],
  "type": "object"
}