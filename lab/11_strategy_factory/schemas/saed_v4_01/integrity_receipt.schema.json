{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "component_root": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "details": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "object_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "receipt_id": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ],
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "object_hash",
    "component_root",
    "status",
    "details"
  ],
  "type": "object"
}