{
  "$id": "https://decision-alpha-lab.local/lab/11_strategy_factory/schemas/saed_v4_16/contract_validation_map.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed SAED V4-16 contract generated from the deterministic reference artifact. Unknown fields are forbidden.",
  "properties": {
    "closed_contracts": {
      "type": "boolean"
    },
    "contract_count": {
      "type": "integer"
    },
    "contracts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "document": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          }
        },
        "required": [
          "document",
          "schema"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "phase": {
      "type": "string"
    }
  },
  "required": [
    "closed_contracts",
    "contract_count",
    "contracts",
    "phase"
  ],
  "title": "CONTRACT_VALIDATION_MAP",
  "type": "object"
}
