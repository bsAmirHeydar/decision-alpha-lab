    "chaos_report_id": {
      "type": "string"
    },
    "contained_count": {
      "type": "integer"
    },
    "events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capital_delta": {
            "type": "number"
          },
          "contained": {
            "type": "boolean"
          },
          "event_hash": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "expected_response": {
            "type": "string"
          },
          "live_order_delta": {
            "type": "integer"
          },
          "observed_response": {
            "type": "string"
