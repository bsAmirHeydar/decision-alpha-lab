{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "feature_id": {
      "type": "string"
    },
    "last_event_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "mask": {
      "enum": [
        0,
        1
      ],
      "type": "integer"
    },
    "missing": {
      "type": "boolean"
    },
    "normalized_value": {},
    "quality": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "source_artifact_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "source_keys": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "source_value_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "stale": {
      "type": "boolean"
    },
    "value": {}
  },
  "required": [
    "feature_id",
    "value",
    "normalized_value",
    "missing",
    "mask",
    "stale",
    "quality",
    "source_keys",
    "source_artifact_ids",
    "source_value_hashes",
    "last_event_time",
    "reason_codes"
  ],
  "title": "View Feature Value",
  "type": "object"
}
