      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "kind",
    "required_attributes",
    "prohibited_attributes",
    "description"
  ],
  "title": "Node Type Definition",
  "type": "object"
