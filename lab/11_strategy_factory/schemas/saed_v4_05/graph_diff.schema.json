{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "added_edge_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "added_node_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "changed_edge_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "changed_node_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "left_graph_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "removed_edge_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "removed_node_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "right_graph_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "status_changed": {
      "type": "boolean"
    },
    "support_changed": {
      "type": "boolean"
    }
  },
  "required": [
    "left_graph_hash",
    "right_graph_hash",
    "added_node_ids",
    "removed_node_ids",
    "changed_node_ids",
    "added_edge_ids",
    "removed_edge_ids",
    "changed_edge_ids",
    "status_changed",
    "support_changed"
  ],
  "title": "Graph Diff",
  "type": "object"
}
