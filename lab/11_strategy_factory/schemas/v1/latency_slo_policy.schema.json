  "properties": {
    "bucket_edges_us": {
      "items": {
        "minimum": 1,
        "type": "integer"
      },
      "minItems": 1,
      "type": "array"
    },
    "minimum_samples": {
      "minimum": 1,
      "type": "integer"
    },
    "p50_limit_us": {
      "minimum": 1,
      "type": "integer"
    },
    "p95_limit_us": {
      "minimum": 1,
      "type": "integer"
    },
    "p99_limit_us": {
      "minimum": 1,
      "type": "integer"
    },
    "policy_id": {
      "minLength": 1,
      "type": "string"
    },
    "stage": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "stage",
    "bucket_edges_us",
    "p50_limit_us",
    "p95_limit_us",
