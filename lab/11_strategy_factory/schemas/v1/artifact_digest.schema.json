{
  "$id": "alpha_lab.strategy_factory/artifact_digest@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byte_size": {
      "minimum": 0,
      "type": "integer"
    },
    "digest_id": {
      "minLength": 3,
      "type": "string"
    },
    "logical_name": {
      "minLength": 1,
      "type": "string"
    },
    "media_type": {
      "minLength": 1,
      "type": "string"
    },
    "relative_path": {
      "minLength": 1,
      "type": "string"
    },
    "required": {
      "type": "boolean"
    },
    "role": {
      "maximum": 12,
      "minimum": 1,
      "type": "integer"
    },
    "schema_id": {
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "logical_name",
    "relative_path",
    "role",
    "media_type",
    "byte_size",
    "sha256",
    "required",
    "digest_id"
  ],
  "title": "artifact_digest",
  "type": "object"
}
