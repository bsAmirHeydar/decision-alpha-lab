{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-alpha-lab/schemas/v1/fill_record.schema.json",
  "title": "Fill Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fill_id",
    "order_id",
    "intent_id",
    "position_id",
    "symbol",
    "direction",
    "reason",
    "volume",
    "price",
    "commission_cash",
    "quote_sequence",
    "fill_time_utc_msc",
    "fill_hash"
