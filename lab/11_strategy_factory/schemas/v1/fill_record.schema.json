  "properties": {
    "fill_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "intent_id": {
      "type": "string"
    },
    "position_id": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "direction": {
      "type": "integer"
    },
    "reason": {
      "type": "integer"
    },
    "volume": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "commission_cash": {
      "type": "number"
    },
    "slippage_cash_proxy": {
      "type": "number"
    },
    "quote_sequence": {
      "type": "integer"
    },
    "fill_time_utc_msc": {
      "type": "integer"
    },
    "fill_hash": {
      "type": "string"
    }
  }
}
