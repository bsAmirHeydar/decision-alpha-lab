{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "event_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "previous_event_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "quantity_fraction": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "type": "integer"
    },
    "state": {
      "type": "string"
    },
    "time_ms": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "sequence",
    "state",
    "time_ms",
    "quantity_fraction",
    "reason",
    "previous_event_hash",
    "event_hash"
  ],
  "title": "Lifecycle Event",
  "type": "object"
}
