      "exact_version": "1.0.0",
      "include_context": true,
      "minimum_members": 3,
      "relation_kind": "semantic_family",
      "required": false,
      "rule_name": "intermarket_liquidity_state",
      "selectors": [
        {
          "feature_id": "cross_market_state",
          "view_name": "intermarket_view"
