      "exact_version": "1.0.0",
      "include_context": true,
      "minimum_members": 5,
      "relation_kind": "semantic_family",
      "required": true,
      "rule_name": "context_time_session_state",
      "selectors": [
        {
          "feature_id": "hour_utc",
          "view_name": "time_view"
        },
        {
          "feature_id": "weekday_utc",
          "view_name": "time_view"
        },
        {
          "feature_id": "seconds_since_context_start",
          "view_name": "time_view"
        },
        {
          "feature_id": "session_id",
          "view_name": "session_view"
        },
        {
          "feature_id": "session_open",
          "view_name": "session_view"
        },
        {
          "feature_id": "minutes_from_open",
          "view_name": "session_view"
        }
      ]
    },
    {
      "description": "Explicit relation across current structure and ancestry descriptors.",
      "exact_version": "1.0.0",
      "include_context": true,
      "minimum_members": 3,
      "relation_kind": "semantic_family",
      "required": false,
      "rule_name": "structure_ancestry_state",
      "selectors": [
        {
          "feature_id": "lifecycle_state",
          "view_name": "structure_view"
        },
        {
          "feature_id": "twin_state",
          "view_name": "structure_view"
        },
        {
          "feature_id": "context_family",
