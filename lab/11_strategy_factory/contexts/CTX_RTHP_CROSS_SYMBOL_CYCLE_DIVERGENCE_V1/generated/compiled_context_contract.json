          "definition": "A completed or explicitly partial versioned cycle occurrence that supplies symbol-local High or Low reference levels for a registered family.",
          "forbidden_ambiguities": [
            "future_cycle",
            "inferred_cycle"
          ],
          "observable": true,
          "synonyms": [
            "source_cycle"
          ],
