          ],
          "term_id": "corresponding_level"
        },
        {
          "definition": "A tick-size-normalized observed price equals or crosses the symbol-local reference High or Low without requiring a bar close beyond that level.",
          "forbidden_ambiguities": [
            "close_confirmation",
            "tolerance_inference"
          ],
          "observable": true,
          "synonyms": [
            "hunt",
            "sweep"
          ],
          "term_id": "touch"
        },
        {
          "definition": "The member of the registered symbol pair whose corresponding level has the earliest recorded touch before the synchronized evaluation cut.",
          "forbidden_ambiguities": [
            "trade_symbol",
            "preferred_symbol"
          ],
          "observable": true,
          "synonyms": [
            "touching_symbol"
          ],
          "term_id": "hunter_symbol"
        },
        {
          "definition": "The paired symbol whose corresponding level remains untouched at the synchronized evaluation cut that confirms the relationship occurrence.",
          "forbidden_ambiguities": [
            "safe_asset",
            "entry_symbol"
          ],
          "observable": true,
          "synonyms": [
            "untouched_symbol"
          ],
          "term_id": "protected_symbol"
        },
        {
          "definition": "An immutable Context relationship record emitted only from exclusive-or touch state under synchronized non-stale observations and matching price-basis labels.",
          "forbidden_ambiguities": [
            "trade_signal",
            "guaranteed_reversal"
          ],
          "observable": true,
          "synonyms": [
            "rthp_context_occurrence"
          ],
          "term_id": "divergence_event"
        },
        {
          "definition": "A scoped reference state reached when the protected symbol later touches its corresponding level, ending future eligibility for that family and level side.",
          "forbidden_ambiguities": [
            "deleted_history",
            "invalidated_past_event"
          ],
          "observable": true,
          "synonyms": [
            "consumed_reference"
          ],
          "term_id": "reference_exhausted"
        },
        {
          "definition": "The versioned cycle occurrence whose observation window is evaluated against one or more registered reference-cycle occurrences.",
          "forbidden_ambiguities": [
