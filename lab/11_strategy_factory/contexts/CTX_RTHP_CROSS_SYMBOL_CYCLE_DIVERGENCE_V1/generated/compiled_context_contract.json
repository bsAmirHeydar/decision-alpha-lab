    "state_machine": {
      "determinism_policy": "SINGLE_TRANSITION_OR_FAIL",
      "initial_state": "UNTOUCHED_BOTH",
      "states": [
        "UNTOUCHED_BOTH",
        "ONE_SIDE_TOUCHED",
        "DIVERGENCE_CONFIRMED",
        "BOTH_SIDES_TOUCHED",
        "REFERENCE_EXHAUSTED",
        "UNCONFIRMED",
        "UNKNOWN"
      ],
      "terminal_states": [
        "BOTH_SIDES_TOUCHED",
        "REFERENCE_EXHAUSTED"
      ],
      "transitions": [
        {
          "event": "FIRST_SYMBOL_TOUCH",
          "from": "UNTOUCHED_BOTH",
          "guard": "Exactly one symbol-local level has a recorded first touch and the paired level has no recorded touch.",
          "priority": 10,
          "to": "ONE_SIDE_TOUCHED",
          "unknown_guard_policy": "QUARANTINE"
        },
        {
          "event": "SYNCHRONIZED_M15_XOR_CONFIRMATION",
          "from": "ONE_SIDE_TOUCHED",
          "guard": "Both symbols have synchronized non-stale observations and exactly one corresponding level is touched at the confirmation cut.",
          "priority": 20,
          "to": "DIVERGENCE_CONFIRMED",
          "unknown_guard_policy": "QUARANTINE"
        },
        {
          "event": "PROTECTED_SYMBOL_TOUCH_BEFORE_CONFIRMATION",
          "from": "ONE_SIDE_TOUCHED",
          "guard": "The paired symbol touches its corresponding level before the synchronized confirmation transition is committed.",
          "priority": 30,
          "to": "BOTH_SIDES_TOUCHED",
          "unknown_guard_policy": "QUARANTINE"
        },
        {
          "event": "PROTECTED_SYMBOL_LATER_TOUCH",
          "from": "DIVERGENCE_CONFIRMED",
