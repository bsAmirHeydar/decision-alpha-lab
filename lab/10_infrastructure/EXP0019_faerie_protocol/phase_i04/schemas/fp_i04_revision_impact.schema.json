{
  "$id": "https://decision-alpha-lab.local/exp0019/fp-i04/fp_i04_revision_impact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_minute_ids": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "affected_window_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "changed_suffix_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "reason_code": {
      "minLength": 1,
      "type": "string"
    },
    "revision_id": {
      "minLength": 1,
      "type": "string"
    },
    "unaffected_prefix_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "revision_id",
    "affected_minute_ids",
    "affected_window_ids",
    "unaffected_prefix_hash",
    "changed_suffix_hash",
    "reason_code"
  ],
  "title": "fp_i04_revision_impact",
  "type": "object"
}
