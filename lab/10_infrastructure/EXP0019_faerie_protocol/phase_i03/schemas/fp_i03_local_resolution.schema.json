{
  "$id": "https://decision-alpha-lab.local/exp0019/fp-i03/fp_i03_local_resolution.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_utc_ms": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "local_iso": {
      "minLength": 1,
      "type": "string"
    },
    "policy": {
      "enum": [
        "REJECT",
        "EARLIEST",
        "LATEST"
      ]
    },
    "reason_code": {
      "pattern": "^FP_TRC_[A-Z0-9_]+$",
      "type": "string"
    },
    "resolution_id": {
      "minLength": 1,
      "type": "string"
    },
    "selected_utc_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "UNIQUE",
        "AMBIGUOUS",
        "NONEXISTENT"
      ]
    },
    "time_rule_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "local_iso",
    "status",
    "candidate_utc_ms",
    "selected_utc_ms",
    "policy",
    "reason_code",
    "time_rule_version",
    "resolution_id"
  ],
  "title": "fp_i03_local_resolution",
  "type": "object"
}
