{
  "$id": "https://decision-alpha-lab.local/exp0019/fp-i03/fp_i03_time_kernel_config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ambiguous_end_policy": {
      "enum": [
        "REJECT",
        "EARLIEST",
        "LATEST"
      ]
    },
    "ambiguous_start_policy": {
      "enum": [
        "REJECT",
        "EARLIEST",
        "LATEST"
      ]
    },
    "calendar_version": {
      "minLength": 1,
      "type": "string"
    },
    "config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "context_id": {
      "minLength": 1,
      "type": "string"
    },
    "kernel_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "maximum_supported_year": {
      "minimum": 2007,
      "type": "integer"
    },
    "minimum_supported_year": {
      "minimum": 2007,
      "type": "integer"
    },
    "session_registry_version": {
      "minLength": 1,
      "type": "string"
    },
    "time_rule_version": {
      "minLength": 1,
      "type": "string"
    },
    "timezone_name": {
      "const": "America/New_York"
    }
  },
  "required": [
    "context_id",
    "timezone_name",
    "time_rule_version",
    "calendar_version",
    "session_registry_version",
    "kernel_version",
    "minimum_supported_year",
    "maximum_supported_year",
    "ambiguous_start_policy",
    "ambiguous_end_policy",
    "config_hash"
  ],
  "title": "fp_i03_time_kernel_config",
  "type": "object"
}
