{
  "$id": "https://alpha-lab.local/schemas/consolidation/uc04/w1/fixture_corpus.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "candidate_id": {
      "const": "ENGCAND_5F87C4D5849C4FD141DDBF29590235D8",
      "type": "string"
    },
    "comparison_mode": {
      "const": "BYTE_EXACT_ASCII",
      "type": "string"
    },
    "consumer_cutover_authority": {
      "const": false,
      "type": "boolean"
    },
    "corpus_id": {
      "const": "UC04_W1A_DATETIME_FORMAT_FIXTURE_CORPUS_V1",
      "type": "string"
    },
    "document_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "fixture_count": {
      "const": 13,
      "type": "integer"
    },
    "fixtures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expected": {
            "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$",
            "type": "string"
          },
          "fixture_id": {
            "pattern": "^UC04W1_DT_[0-9]{3}$",
            "type": "string"
          },
          "mql5_literal": {
            "pattern": "^D'[0-9]{4}\\.[0-9]{2}\\.[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}'$",
            "type": "string"
          },
          "unix_seconds": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "fixture_id",
          "unix_seconds",
          "mql5_literal",
          "expected"
        ],
        "type": "object"
      },
      "maxItems": 13,
      "minItems": 13,
      "type": "array"
    },
    "implementation_authority": {
      "const": false,
      "type": "boolean"
    },
    "metamorphic_properties": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 6,
      "type": "array",
      "uniqueItems": true
    },
    "native_execution_performed": {
      "const": false,
      "type": "boolean"
    },
    "program_id": {
      "const": "UCPS",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "semantic_change": {
      "const": false,
      "type": "boolean"
    },
    "stage_id": {
      "const": "UC04-W1A",
      "type": "string"
    },
    "status": {
      "const": "PASS_REFERENCE",
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "program_id",
    "stage_id",
    "document_digest",
    "corpus_id",
    "status",
    "candidate_id",
    "comparison_mode",
    "fixture_count",
    "fixtures",
    "metamorphic_properties",
    "native_execution_performed",
    "semantic_change",
    "implementation_authority",
    "consumer_cutover_authority"
  ],
  "title": "UC04-W1A Fixture Corpus",
  "type": "object"
}
