{
  "$id": "https://alpha-lab.local/schemas/consolidation/uc04/w1/entry_decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "authorized_actions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 6,
      "type": "array",
      "uniqueItems": true
    },
    "candidate_id": {
      "const": "ENGCAND_5F87C4D5849C4FD141DDBF29590235D8",
      "type": "string"
    },
    "capital_authority": {
      "const": false,
      "type": "boolean"
    },
    "consumer_cutover_authority": {
      "const": false,
      "type": "boolean"
    },
    "decision_id": {
      "const": "UC04_W1A_ENTRY_DECISION_V1",
      "type": "string"
    },
    "deletion_authority": {
      "const": false,
      "type": "boolean"
    },
    "document_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "implementation_authority": {
      "const": false,
      "type": "boolean"
    },
    "order_authority": {
      "const": false,
      "type": "boolean"
    },
    "program_id": {
      "const": "UCPS",
      "type": "string"
    },
    "prohibited_actions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 6,
      "type": "array",
      "uniqueItems": true
    },
    "runtime_authority": {
      "const": false,
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "semantic_change": {
      "const": false,
      "type": "boolean"
    },
    "stage_id": {
      "const": "UC04-W1A",
      "type": "string"
    },
    "status": {
      "const": "ACCEPTED_CHARACTERIZATION_ONLY",
      "type": "string"
    },
    "upstream_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "program_id",
    "stage_id",
    "document_digest",
    "decision_id",
    "status",
    "candidate_id",
    "upstream_evidence",
    "authorized_actions",
    "prohibited_actions",
    "semantic_change",
    "implementation_authority",
    "consumer_cutover_authority",
    "deletion_authority",
    "runtime_authority",
    "order_authority",
    "capital_authority"
  ],
  "title": "UC04-W1A Entry Decision",
  "type": "object"
}
