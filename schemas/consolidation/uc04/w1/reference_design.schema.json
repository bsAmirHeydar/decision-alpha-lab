{
  "$id": "https://alpha-lab.local/schemas/consolidation/uc04/w1/reference_design.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "candidate_id": {
      "const": "ENGCAND_5F87C4D5849C4FD141DDBF29590235D8",
      "type": "string"
    },
    "capital_authority": {
      "const": false,
      "type": "boolean"
    },
    "consumer_cutover_authority": {
      "const": false,
      "type": "boolean"
    },
    "consumer_files_modified": {
      "const": false,
      "type": "boolean"
    },
    "deletion_authority": {
      "const": false,
      "type": "boolean"
    },
    "design_id": {
      "const": "UC04_W1A_DETERMINISTIC_DATETIME_REFERENCE_DESIGN_V1",
      "type": "string"
    },
    "document_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "engine_id": {
      "const": "ENG_9599AA665C5BC4B13B020EBA4213CB16",
      "type": "string"
    },
    "forbidden_patterns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 7,
      "type": "array",
      "uniqueItems": true
    },
    "implementation_authority": {
      "const": false,
      "type": "boolean"
    },
    "native_self_test": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$",
      "type": "string"
    },
    "native_self_test_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "order_authority": {
      "const": false,
      "type": "boolean"
    },
    "production_target_materialized": {
      "const": false,
      "type": "boolean"
    },
    "program_id": {
      "const": "UCPS",
      "type": "string"
    },
    "proposed_production_target": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$",
      "type": "string"
    },
    "reference_header": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$",
      "type": "string"
    },
    "reference_header_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_authority": {
      "const": false,
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "semantic_change": {
      "const": false,
      "type": "boolean"
    },
    "stage_id": {
      "const": "UC04-W1A",
      "type": "string"
    },
    "status": {
      "const": "TEST_ONLY_REFERENCE",
      "type": "string"
    },
    "wrapper_strategy": {
      "const": "PRESERVE_EXISTING_FUNCTION_NAMES_AND_DELEGATE_AFTER_NATIVE_PASS",
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "program_id",
    "stage_id",
    "document_digest",
    "design_id",
    "status",
    "candidate_id",
    "engine_id",
    "reference_header",
    "reference_header_sha256",
    "native_self_test",
    "native_self_test_sha256",
    "proposed_production_target",
    "production_target_materialized",
    "consumer_files_modified",
    "wrapper_strategy",
    "forbidden_patterns",
    "semantic_change",
    "implementation_authority",
    "consumer_cutover_authority",
    "deletion_authority",
    "runtime_authority",
    "order_authority",
    "capital_authority"
  ],
  "title": "UC04-W1A Test-only Reference Design",
  "type": "object"
}
