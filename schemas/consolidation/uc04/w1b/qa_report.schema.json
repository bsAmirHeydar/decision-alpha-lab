{
  "$id": "urn:alpha-lab:uc04:w1b:installable-qa-report",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "capital_authority": {
          "const": false
        },
        "consumer_cutover_authority": {
          "const": false
        },
        "deletion_authority": {
          "const": false
        },
        "implementation_authority": {
          "const": false
        },
        "order_authority": {
          "const": false
        },
        "runtime_authority": {
          "const": false
        },
        "semantic_change": {
          "const": false
        }
      },
      "required": [
        "implementation_authority",
        "consumer_cutover_authority",
        "deletion_authority",
        "runtime_authority",
        "order_authority",
        "capital_authority",
        "semantic_change"
      ],
      "type": "object"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "metaeditor_runtime": {
          "enum": [
            "PENDING_LOCAL_WINDOWS",
            "PASS",
            "FAIL"
          ]
        },
        "metatrader_runtime": {
          "enum": [
            "PENDING_LOCAL_WINDOWS",
            "PASS",
            "FAIL"
          ]
        },
        "platform": {
          "type": "string"
        },
        "powershell_runtime": {
          "enum": [
            "NOT_AVAILABLE_IN_BUILD_ENVIRONMENT",
            "PASS"
          ]
        },
        "python": {
          "type": "string"
        }
      },
      "required": [
        "python",
        "platform",
        "powershell_runtime",
        "metaeditor_runtime",
        "metatrader_runtime"
      ],
      "type": "object"
    },
    "gates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "gate": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "NOT_RUN",
              "BLOCKED"
            ]
          }
        },
        "required": [
          "gate",
          "status",
          "command",
          "detail"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "lfs": {
      "additionalProperties": false,
      "properties": {
        "baseline_archive": {
          "const": "FOUR_HISTORICAL_POINTERS_WITHOUT_BLOBS"
        },
        "full_suite_effect": {
          "const": "BLOCKS_COMPLETE_LOCAL_FULL_SUITE_CLAIM"
        },
        "patch_payload": {
          "const": "NO_LFS_POINTERS"
        }
      },
      "required": [
        "patch_payload",
        "baseline_archive",
        "full_suite_effect"
      ],
      "type": "object"
    },
    "package": {
      "additionalProperties": false,
      "properties": {
        "deterministic_rebuild": {
          "const": "PASS"
        },
        "duplicate_entries": {
          "const": 0
        },
        "lfs_pointers": {
          "const": 0
        },
        "line_endings": {
          "const": "PASS"
        },
        "root_relative": {
          "const": true
        },
        "schema_validation": {
          "const": "PASS"
        },
        "secret_findings": {
          "const": 0
        },
        "tree_validation": {
          "const": "PASS"
        },
        "unsafe_paths": {
          "const": 0
        },
        "zip_validation": {
          "const": "PASS"
        }
      },
      "required": [
        "tree_validation",
        "zip_validation",
        "deterministic_rebuild",
        "root_relative",
        "duplicate_entries",
        "unsafe_paths",
        "lfs_pointers",
        "secret_findings",
        "line_endings",
        "schema_validation"
      ],
      "type": "object"
    },
    "program_id": {
      "const": "UCPS"
    },
    "pytest_collection": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "errors": {
          "minimum": 0,
          "type": "integer"
        },
        "tests_collected": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "tests_collected",
        "errors",
        "command"
      ],
      "type": "object"
    },
    "release_id": {
      "const": "UC04_W1B_Q_INSTALLABLE_R4"
    },
    "residual_risks": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "1.2.0"
    },
    "stage_id": {
      "const": "UC04-W1B-Q"
    },
    "status": {
      "enum": [
        "PASS_TOOLING_NATIVE_EXECUTION_PENDING",
        "FAIL"
      ]
    },
    "targeted_tests": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "failed": {
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed",
        "skipped",
        "command"
      ],
      "type": "object"
    },
    "unexecuted": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "program_id",
    "stage_id",
    "release_id",
    "status",
    "environment",
    "gates",
    "targeted_tests",
    "pytest_collection",
    "package",
    "lfs",
    "authority",
    "unexecuted",
    "warnings",
    "residual_risks"
  ],
  "type": "object"
}
