{
  "$id": "urn:alpha-lab:uc04:w1b:installable-patch-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "capital_authority": {
          "const": false
        },
        "consumer_cutover_authority": {
          "const": false
        },
        "deletion_authority": {
          "const": false
        },
        "implementation_authority": {
          "const": false
        },
        "order_authority": {
          "const": false
        },
        "runtime_authority": {
          "const": false
        },
        "semantic_change": {
          "const": false
        }
      },
      "required": [
        "implementation_authority",
        "consumer_cutover_authority",
        "deletion_authority",
        "runtime_authority",
        "order_authority",
        "capital_authority",
        "semantic_change"
      ],
      "type": "object"
    },
    "base_stage": {
      "const": "UC04-W1A"
    },
    "current_behavior": {
      "minLength": 1,
      "type": "string"
    },
    "delivery_type": {
      "const": "installable_native_qualification_tooling"
    },
    "desired_behavior": {
      "minLength": 1,
      "type": "string"
    },
    "full_repository_suite_status": {
      "const": "NOT_COMPLETED_HISTORICAL_LFS_BLOCKER"
    },
    "hash_ledger_entry_count": {
      "minimum": 1,
      "type": "integer"
    },
    "intent": {
      "minLength": 1,
      "type": "string"
    },
    "lfs_pointer_count": {
      "const": 0
    },
    "line_ending_policy": {
      "additionalProperties": false,
      "properties": {
        "final_newline": {
          "const": true
        },
        "other_text": {
          "const": "LF"
        },
        "powershell": {
          "const": "CRLF"
        },
        "utf8_bom": {
          "const": false
        }
      },
      "required": [
        "powershell",
        "other_text",
        "utf8_bom",
        "final_newline"
      ],
      "type": "object"
    },
    "native_evidence_status": {
      "const": "PENDING_LOCAL_WINDOWS_MT5"
    },
    "non_goals": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "patch_file_count": {
      "minimum": 1,
      "type": "integer"
    },
    "payload_total_bytes_excluding_manifest_and_hash_ledger": {
      "minimum": 1,
      "type": "integer"
    },
    "platform_contract": {
      "additionalProperties": false,
      "properties": {
        "installation": {
          "const": "WINDOWS_POWERSHELL_5_OR_NEWER"
        },
        "path_separator_in_index": {
          "const": "POSIX_FORWARD_SLASH"
        },
        "validation": {
          "const": "WINDOWS_AND_LINUX_PYTHON_3_11_PLUS"
        },
        "windows_case_collision_check": {
          "const": true
        }
      },
      "required": [
        "installation",
        "validation",
        "path_separator_in_index",
        "windows_case_collision_check"
      ],
      "type": "object"
    },
    "preserved_invariants": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "program_id": {
      "const": "UCPS"
    },
    "related_workflows": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "release_id": {
      "const": "UC04_W1B_Q_INSTALLABLE_R4"
    },
    "release_revision": {
      "const": 4
    },
    "residual_risks": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "rollback_strategy": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.2.0"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "secret_finding_count": {
      "const": 0
    },
    "stage_id": {
      "const": "UC04-W1B-Q"
    },
    "status": {
      "const": "ACCEPTED_TOOLING_NATIVE_EXECUTION_PENDING"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "zip_layout": {
      "const": "ROOT_RELATIVE_FILES_ONLY_NO_REPOSITORY_WRAPPER"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "program_id",
    "stage_id",
    "release_id",
    "release_revision",
    "title",
    "status",
    "delivery_type",
    "base_stage",
    "intent",
    "current_behavior",
    "desired_behavior",
    "scope",
    "non_goals",
    "preserved_invariants",
    "patch_file_count",
    "hash_ledger_entry_count",
    "payload_total_bytes_excluding_manifest_and_hash_ledger",
    "lfs_pointer_count",
    "secret_finding_count",
    "zip_layout",
    "line_ending_policy",
    "platform_contract",
    "authority",
    "native_evidence_status",
    "full_repository_suite_status",
    "related_workflows",
    "rollback_strategy",
    "residual_risks"
  ],
  "type": "object"
}
