{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-alpha-lab/schemas/consolidation/uc04/complete/capability_implementation_ledger.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "program_id", "stage_id", "schema_version", "selected_capability_count", "consumer_adapter_count", "capabilities", "semantic_change_authority", "deletion_authority", "runtime_authority", "order_authority", "capital_authority", "document_digest"],
  "properties": {
    "$schema": {"type": "string"},
    "program_id": {"const": "UCPS"},
    "stage_id": {"const": "UC04-COMPLETE"},
    "schema_version": {"const": "1.0.0"},
    "selected_capability_count": {"const": 14},
    "consumer_adapter_count": {"const": 109},
    "capabilities": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "historical_candidate_digest", "category", "canonical_include", "canonical_function", "consumer_count", "adapter_count", "members", "implementation_state"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^ENGCAND_[0-9A-F]{32}$"},
          "historical_candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "category": {"type": "string"},
          "canonical_include": {"type": "string", "pattern": "^mql5/Include/AlphaLab/UC04/"},
          "canonical_function": {"type": "string", "pattern": "^AL_UC04"},
          "consumer_count": {"type": "integer", "minimum": 1},
          "adapter_count": {"type": "integer", "minimum": 1},
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_path", "function_name", "source_sha256", "adapter_call_present"],
              "properties": {
                "artifact_path": {"type": "string", "pattern": "^mql5/"},
                "function_name": {"type": "string"},
                "source_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "adapter_call_present": {"const": true}
              }
            }
          },
          "implementation_state": {"const": "CANONICAL_IMPLEMENTATION_WITH_LOCAL_COMPATIBILITY_ADAPTERS"}
        }
      }
    },
    "semantic_change_authority": {"const": false},
    "deletion_authority": {"const": false},
    "runtime_authority": {"const": false},
    "order_authority": {"const": false},
    "capital_authority": {"const": false},
    "document_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
