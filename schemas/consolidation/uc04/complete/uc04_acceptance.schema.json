{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-alpha-lab/schemas/consolidation/uc04/complete/uc04_acceptance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "program_id", "stage_id", "schema_version", "implementation_status", "native_seal_status", "selected_shared_capability_count", "explicit_variant_count", "consumer_adapter_count", "compile_target_count", "runtime_test_rows", "runtime_failed_rows", "native_receipt_sha256", "independent_review_sha256", "evidence_bundle_sha256", "production_source_mutation", "unexplained_behavior_delta_count", "active_internal_imports_from_retired_engines", "context_specific_branch_in_shared_kernel", "semantic_change_authority", "deletion_authority", "runtime_authority", "order_authority", "capital_authority", "status", "document_digest"],
  "properties": {
    "$schema": {"type": "string"},
    "program_id": {"const": "UCPS"},
    "stage_id": {"const": "UC-04"},
    "schema_version": {"const": "1.0.0"},
    "implementation_status": {"const": "COMPLETE"},
    "native_seal_status": {"const": "PASS"},
    "selected_shared_capability_count": {"const": 14},
    "explicit_variant_count": {"const": 191},
    "consumer_adapter_count": {"const": 109},
    "compile_target_count": {"type": "integer", "minimum": 30},
    "runtime_test_rows": {"type": "integer", "minimum": 20},
    "runtime_failed_rows": {"const": 0},
    "native_receipt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "independent_review_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_bundle_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "production_source_mutation": {"const": false},
    "unexplained_behavior_delta_count": {"const": 0},
    "active_internal_imports_from_retired_engines": {"const": 0},
    "context_specific_branch_in_shared_kernel": {"const": false},
    "semantic_change_authority": {"const": false},
    "deletion_authority": {"const": false},
    "runtime_authority": {"const": false},
    "order_authority": {"const": false},
    "capital_authority": {"const": false},
    "status": {"const": "ACCEPTED"},
    "document_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
