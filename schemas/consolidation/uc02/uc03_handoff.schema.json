{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "authority_package_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "authority_package_id": {
      "type": "string"
    },
    "destructive_authority": {
      "const": false
    },
    "program_id": {
      "const": "UCPS"
    },
    "stage_id": {
      "const": "UC-02"
    },
    "status": {
      "enum": [
        "WITHHELD",
        "ISSUED"
      ]
    }
  },
  "required": [
    "program_id",
    "stage_id",
    "status",
    "authority_package_id",
    "authority_package_digest",
    "destructive_authority"
  ],
  "type": "object"
}
