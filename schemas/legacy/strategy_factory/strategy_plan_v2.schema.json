{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-alpha-lab.local/schemas/strategy_plan_v2.schema.json",
  "title": "Decision Alpha Lab Strategy Factory V2 Plan",
  "type": "object",
  "required": ["strategy", "context", "decision", "runtime"],
  "properties": {
    "strategy": {
      "type": "object",
      "required": ["id", "version", "owner", "thesis", "null_hypothesis"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "thesis": {"type": "string", "minLength": 1},
        "null_hypothesis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "required": ["providers", "feature_vectors"],
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "version"],
            "properties": {
              "id": {"type": "string"},
              "version": {"type": "string"},
              "implementation": {"type": "string"},
              "fields": {"type": "array", "items": {"type": "string"}},
              "dependencies": {"type": "array", "items": {"type": "string"}},
              "required": {"type": "boolean"},
              "ttl_seconds": {"type": ["number", "null"], "minimum": 0}
            },
            "additionalProperties": true
          }
        },
        "feature_vectors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["version", "names", "defaults"],
            "properties": {
              "version": {"type": "string"},
              "names": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "defaults": {"type": "array", "items": {"type": "number"}, "minItems": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["max_candidates_per_event", "candidate_templates", "models", "model_routes", "abstention"],
      "properties": {
        "max_candidates_per_event": {"type": "integer", "minimum": 1, "maximum": 1024},
        "candidate_templates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "entry", "stop", "exit"],
            "properties": {
              "id": {"type": "string"},
              "entry": {"type": "string"},
              "stop": {"type": "string"},
              "exit": {"type": "string"},
              "priority": {"type": "integer"},
              "parameters": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "models": {"type": "array", "items": {"type": "object"}},
        "model_routes": {"type": "array", "items": {"type": "object"}},
        "utility_weights": {"type": "object", "additionalProperties": {"type": "number"}},
        "abstention": {"type": "object"}
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": ["fallback_mode", "latency_budget_ms"],
      "properties": {
        "fallback_mode": {"enum": ["abstain", "rule_baseline", "error"]},
        "latency_budget_ms": {"type": "object", "additionalProperties": {"type": ["number", "string"]}}
      },
      "additionalProperties": true
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
