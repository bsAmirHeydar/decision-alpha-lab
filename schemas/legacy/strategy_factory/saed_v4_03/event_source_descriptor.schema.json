{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clock_domain": {
      "enum": [
        "exchange",
        "broker",
        "terminal",
        "research",
        "canonical_utc"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "source_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_version": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "trusted": {
      "type": "boolean"
    }
  },
  "required": [
    "source_id",
    "source_version",
    "clock_domain",
    "source_hash",
    "trusted",
    "timezone",
    "metadata"
  ],
  "title": "Event Source Descriptor",
  "type": "object"
}
