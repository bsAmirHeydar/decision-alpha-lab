{
  "$id": "https://decision-alpha-lab.local/schemas/saed_v4_15/contract_validation_map.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "closed_contracts": {
      "type": "boolean"
    },
    "contract_count": {
      "type": "integer"
    },
    "contracts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "document": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          }
        },
        "required": [
          "document",
          "schema"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "phase": {
      "type": "string"
    }
  },
  "required": [
    "phase",
    "contracts",
    "contract_count",
    "closed_contracts"
  ],
  "type": "object"
}
