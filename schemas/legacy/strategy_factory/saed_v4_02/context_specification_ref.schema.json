{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "context_id": {
      "minLength": 1,
      "type": "string"
    },
    "context_version": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "specification_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ucee_phase": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "context_id",
    "context_version",
    "artifact_id",
    "specification_hash",
    "ucee_phase",
    "schema_version"
  ],
  "title": "Context Specification Ref",
  "type": "object"
}
