      "type": "boolean"
    },
    "definition": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "namespace": {
      "minLength": 1,
      "type": "string"
    },
    "source_ref": {
      "type": "string"
    },
