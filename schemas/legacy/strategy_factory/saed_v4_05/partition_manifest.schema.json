{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "edge_partitions": {
      "items": {
        "items": false,
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "minimum": 0,
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "minItems": 1,
      "type": "array"
    },
    "graph_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "graph_id": {
      "minLength": 1,
      "pattern": "^sthypergraph_[0-9a-f]{24}$",
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "node_partitions": {
      "items": {
        "items": false,
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "minimum": 0,
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "minItems": 1,
      "type": "array"
    },
    "partition_count": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "graph_id",
    "graph_hash",
    "partition_count",
    "node_partitions",
    "edge_partitions",
    "manifest_hash"
  ],
  "title": "Graph Partition Manifest",
  "type": "object"
}
