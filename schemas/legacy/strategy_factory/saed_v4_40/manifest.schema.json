  "required": [
    "phase",
    "upstream_certificate_hash",
    "registry_hash",
    "placement_hash",
    "cell_count",
    "replica_count",
    "cells",
    "fleet_merkle_root",
    "immutable",
    "research_only",
    "production_authorized",
    "fleet_manifest_id",
    "fleet_manifest_hash"
