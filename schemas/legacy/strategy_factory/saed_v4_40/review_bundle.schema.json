{
  "$id": "https://alpha-lab.local/schemas/saed_v4_40/review_bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "closed_contract": true,
  "properties": {
    "accepted_reference": {
      "type": "boolean"
    },
    "phase": {
      "type": "string"
    },
    "production_authorized": {
      "type": "boolean"
    },
    "research_only": {
      "type": "boolean"
    },
    "review_bundle_hash": {
      "type": "string"
    },
    "review_bundle_id": {
      "type": "string"
    },
    "reviews": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "conflicts_declared": {
            "type": "boolean"
          },
          "decision": {
            "type": "string"
          },
          "evidence_hash": {
            "type": "string"
          },
          "independent": {
            "type": "boolean"
          },
          "reviewer_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        },
        "required": [
          "conflicts_declared",
          "decision",
          "evidence_hash",
          "independent",
          "reviewer_id",
          "role",
          "scope"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "roles": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "phase",
    "reviews",
    "roles",
    "accepted_reference",
    "production_authorized",
    "research_only",
    "review_bundle_id",
    "review_bundle_hash"
  ],
  "title": "SAED V4-40 review_bundle",
  "type": "object"
}
