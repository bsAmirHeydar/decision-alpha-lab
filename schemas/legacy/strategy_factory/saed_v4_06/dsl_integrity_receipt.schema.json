{
  "$id": "https://decision-alpha-lab.local/schemas/saed_v4_06/dsl_integrity_receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "capability_profile_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "lineage_root": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "package_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "program_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "receipt_id": {
      "type": "string"
    },
    "registry_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_graph_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_handoff_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    }
  },
  "required": [
    "receipt_id",
    "package_id",
    "package_hash",
    "registry_hash",
    "policy_hash",
    "capability_profile_hash",
    "source_graph_hash",
    "source_handoff_hash",
    "program_hashes",
    "binding_hashes",
    "lineage_root",
    "verified",
    "reason_codes"
  ],
  "title": "DSL Integrity Receipt",
  "type": "object"
}
