{
  "$id": "https://decision-alpha-lab.local/schemas/saed_v4_06/primitive_definition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "exact_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "family": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "action",
        "payoff",
        "direction",
        "entry",
        "trigger",
        "stop",
        "target",
        "exit",
        "trail",
        "management",
        "time",
        "cost",
        "capability"
      ],
      "type": "string"
    },
    "parameters": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "allowed_values": {
            "items": {
              "type": "string"
            },
            "minItems": 0,
            "type": "array"
          },
          "default": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null",
              "array",
              "object"
            ]
          },
          "description": {
            "type": "string"
          },
          "identity_affecting": {
            "type": "boolean"
          },
          "maximum": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null",
              "array",
              "object"
            ]
          },
          "minimum": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null",
              "array",
              "object"
            ]
          },
          "monotonic_direction": {
            "enum": [
              "none",
              "increasing",
              "decreasing"
            ],
            "type": "string"
          },
          "name": {
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
            "type": "string"
          },
          "parameter_type": {
            "enum": [
              "boolean",
              "integer",
              "decimal",
              "string",
              "enum",
              "duration_ms"
            ],
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "units": {
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "parameter_type",
          "units",
          "default",
          "minimum",
          "maximum",
          "allowed_values",
          "required",
          "identity_affecting",
          "monotonic_direction",
          "description"
        ],
        "title": "Parameter Definition",
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "path_dependent": {
      "type": "boolean"
    },
    "primitive_id": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "type": "string"
    },
    "required_capabilities": {
      "items": {
        "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "semantic_labels": {
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null",
          "array",
          "object"
        ]
      },
      "type": "object"
    },
    "supported_sides": {
      "items": {
        "enum": [
          "long",
          "short",
          "none"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "primitive_id",
    "exact_version",
    "kind",
    "family",
    "parameters",
    "required_capabilities",
    "supported_sides",
    "semantic_labels",
    "path_dependent",
    "description"
  ],
  "title": "Primitive Definition",
  "type": "object"
}
