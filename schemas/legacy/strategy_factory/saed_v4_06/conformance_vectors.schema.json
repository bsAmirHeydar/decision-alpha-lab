{
  "$id": "https://decision-alpha-lab.local/schemas/saed_v4_06/conformance_vectors.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "phase": {
      "const": "SAED_V4_06"
    },
    "vectors": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expected": {
            "type": "string"
          },
          "package_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "vector_id": {
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
            "type": "string"
          }
        },
        "required": [
          "vector_id",
          "expected"
        ],
        "title": "Conformance Vector",
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "phase",
    "version",
    "vectors"
  ],
  "title": "V4-06 Conformance Vectors",
  "type": "object"
}
