{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed": {
      "type": "boolean"
    },
    "decision_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "reason_code": {
      "minLength": 1,
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "allowed",
    "reason_code",
    "policy_hash",
    "decision_hash"
  ],
  "type": "object"
}