{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "environment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "exact": {
      "type": "boolean"
    },
    "expected_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "observed_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "receipt_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "artifact_id",
    "expected_hash",
    "observed_hash",
    "environment_hash",
    "exact",
    "details"
  ],
  "type": "object"
}