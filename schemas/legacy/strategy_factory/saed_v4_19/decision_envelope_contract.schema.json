    "canonical_baseline": {
      "type": "string"
    },
    "default_fallback": {
      "type": "string"
    },
    "exact_version": {
      "type": "string"
    },
    "manual_fallback": {
      "type": "string"
    },
    "maximum_disagreement": {
      "type": "number"
