{
  "$id": "https://decision-alpha-lab.local/schemas/v3/fusion_prediction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "abstained": {
      "type": "boolean"
    },
    "available_views": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "fusion_kind": {
      "enum": [
        "late_weighted",
        "gated",
        "stacked"
      ]
    },
    "missing_views": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "prediction_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "row_id": {
      "minLength": 1,
      "type": "string"
    },
    "uncertainty": {
      "minimum": 0,
      "type": "number"
    },
    "value": {
      "type": "number"
    },
    "view_weights": {
      "additionalProperties": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "type": "object"
    }
  },
  "required": [
    "prediction_id",
    "row_id",
    "fusion_kind",
    "available_views",
    "missing_views",
    "view_weights",
    "value",
    "uncertainty",
    "abstained",
    "reason",
    "evidence_hash"
  ],
  "title": "fusion_prediction",
  "type": "object"
}
