{
  "$id": "https://decision-alpha-lab.local/schemas/v3/deep_algorithm_descriptor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm_id": {
      "minLength": 1,
      "type": "string"
    },
    "algorithm_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "default_parameters": {
      "type": "object"
    },
    "dependency_profile": {
      "type": "string"
    },
    "determinism": {
      "minLength": 1,
      "type": "string"
    },
    "export_paths": {
      "items": {
        "enum": [
          "none",
          "native_json",
          "onnx",
          "distilled_mql5"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "family": {
      "enum": [
        "sequence",
        "vision",
        "graph",
        "regime_anomaly",
        "multi_view_fusion",
        "transfer_compression",
        "qualification"
      ]
    },
    "formulation": {
      "minLength": 1,
      "type": "string"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "native": {
      "type": "boolean"
    },
    "output_semantics": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "required_fields": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "tasks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "view_kinds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "algorithm_id",
    "algorithm_version",
    "family",
    "formulation",
    "view_kinds",
    "tasks",
    "native",
    "determinism",
    "required_fields",
    "output_semantics",
    "dependency_profile",
    "export_paths",
    "default_parameters",
    "limitations"
  ],
  "title": "deep_algorithm_descriptor",
  "type": "object"
}
