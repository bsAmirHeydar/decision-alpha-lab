{
  "$id": "https://decision-alpha-lab.local/schemas/v3/dependency_probe.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detected_version": {
      "type": "string"
    },
    "evidence_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "minimum_version": {
      "minLength": 1,
      "type": "string"
    },
    "module": {
      "minLength": 1,
      "type": "string"
    },
    "profile": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "available",
        "missing",
        "incompatible"
      ]
    }
  },
  "required": [
    "profile",
    "module",
    "status",
    "detected_version",
    "minimum_version",
    "reason",
    "evidence_hash"
  ],
  "title": "dependency_probe",
  "type": "object"
}
