{
  "$id": "https://alpha-lab.local/schemas/v3/feature_value_v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "feature_id": {
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
      "type": "string"
    },
    "feature_version": {
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
      "type": "string"
    },
    "is_missing": {
      "type": "boolean"
    },
    "known_time": {
      "additionalProperties": false,
      "properties": {
        "clock_id": {
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
          "type": "string"
        },
        "epoch_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "timezone": {
          "const": "UTC"
        }
      },
      "required": [
        "clock_id",
        "epoch_ms",
        "timezone"
      ],
      "type": "object"
    },
    "missing_reason": {
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
      "type": "string"
    },
    "source_time": {
      "additionalProperties": false,
      "properties": {
        "clock_id": {
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
          "type": "string"
        },
        "epoch_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "timezone": {
          "const": "UTC"
        }
      },
      "required": [
        "clock_id",
        "epoch_ms",
        "timezone"
      ],
      "type": "object"
    },
    "value": {}
  },
  "required": [
    "feature_id",
    "feature_version",
    "value",
    "known_time",
    "source_time",
    "is_missing",
    "missing_reason"
  ],
  "title": "UCEE v3 Feature Value",
  "type": "object"
}
