{
  "$id": "https://decision-alpha-lab.local/schemas/v3/promotion_registry_snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "registry_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "suites": {
      "minProperties": 7,
      "type": "object"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "version",
    "suites",
    "registry_hash"
  ],
  "title": "promotion_registry_snapshot",
  "type": "object"
}
