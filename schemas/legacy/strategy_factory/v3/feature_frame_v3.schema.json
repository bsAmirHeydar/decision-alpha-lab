{
  "$id": "https://alpha-lab.local/schemas/v3/feature_frame_v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context_observation_id": {
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
      "type": "string"
    },
    "context_package_id": {
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
      "type": "string"
    },
    "context_package_version": {
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
      "type": "string"
    },
    "features": {
      "items": {
        "$ref": "feature_value_v3.schema.json"
      },
      "minItems": 1,
      "type": "array"
    },
    "frame_hash": {
      "pattern": "^(?:[0-9a-f]{64}|fnv1a64:[0-9a-f]{16})$",
      "type": "string"
    },
    "frame_id": {
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
      "type": "string"
    },
    "observation_cut": {
      "additionalProperties": false,
      "properties": {
        "clock_id": {
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
          "type": "string"
        },
        "epoch_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "timezone": {
          "const": "UTC"
        }
      },
      "required": [
        "clock_id",
        "epoch_ms",
        "timezone"
      ],
      "type": "object"
    }
  },
  "required": [
    "frame_id",
    "frame_hash",
    "context_observation_id",
    "context_package_id",
    "context_package_version",
    "observation_cut",
    "features"
  ],
  "title": "UCEE v3 Immutable Feature Frame",
  "type": "object"
}
