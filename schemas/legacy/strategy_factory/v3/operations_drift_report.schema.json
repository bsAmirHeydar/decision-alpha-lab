{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-alpha-lab.local/schemas/v3/operations_drift_report.schema.json",
  "title": "Operations Drift Report",
  "description": "Closed UCE-I19 contract for drift report.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "type": "string"
    },
    "captured_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "context_drift_score": {
      "type": "number",
      "minimum": 0
    },
    "feature_drift_score": {
      "type": "number",
      "minimum": 0
    },
    "prediction_drift_score": {
      "type": "number",
      "minimum": 0
    },
    "execution_drift_score": {
      "type": "number",
      "minimum": 0
    },
    "threshold_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "report_id",
    "captured_at_ms",
    "context_drift_score",
    "feature_drift_score",
    "prediction_drift_score",
    "execution_drift_score",
    "threshold_hash",
    "evidence_hash"
  ]
}
