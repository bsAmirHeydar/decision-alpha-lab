{
  "$id": "https://decision-alpha-lab/schemas/v3/stress_scenario.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "definition_id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "expected_direction": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "magnitude": {
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
      "type": [
        "string",
        "number"
      ]
    },
    "scenario_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "version",
    "kind",
    "magnitude"
  ],
  "title": "Stress Scenario",
  "type": "object"
}
