{
  "$id": "https://decision-alpha-lab.local/schemas/v3/experiment_trial_identity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Complete behavior-bearing trial identity.",
  "properties": {
    "budget_policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_key": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/\\-]*$",
      "type": "string"
    },
    "compiler_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "dataset_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "economics_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "experiment_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/\\-]*$",
      "type": "string"
    },
    "fold_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/\\-]*$",
      "type": "string"
    },
    "identity_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "known_time_policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "parameter_values": {
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      },
      "type": "object"
    },
    "resource_level": {
      "minimum": 1,
      "type": "integer"
    },
    "scheduler_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "search_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "type": "integer"
    },
    "split_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "target_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "trainer_key": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/\\-]*$",
      "type": "string"
    },
    "transform_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "trial_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/\\-]*$",
      "type": "string"
    }
  },
  "required": [
    "trial_id",
    "experiment_id",
    "candidate_key",
    "trainer_key",
    "parameter_values",
    "fold_id",
    "seed",
    "resource_level",
    "dataset_manifest_hash",
    "split_plan_hash",
    "transform_plan_hash",
    "target_plan_hash",
    "economics_plan_hash",
    "known_time_policy_hash",
    "search_plan_hash",
    "budget_policy_hash",
    "scheduler_version",
    "compiler_version",
    "identity_hash"
  ],
  "title": "Experiment Trial Identity",
  "type": "object"
}
