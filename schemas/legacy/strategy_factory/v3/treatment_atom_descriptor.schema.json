{
  "$id": "https://decision-alpha-lab/schemas/v3/treatment_atom_descriptor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "atom_id": {
      "type": "string"
    },
    "compatibility": {
      "type": "object"
    },
    "description": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "implementation_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "entry",
        "stop",
        "target",
        "trailing",
        "management",
        "sizing"
      ]
    },
    "owner": {
      "type": "string"
    },
    "parameter_schema": {
      "type": "object"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "atom_id",
    "version",
    "kind",
    "family",
    "owner",
    "implementation_id",
    "parameter_schema",
    "compatibility"
  ],
  "title": "Treatment Atom Descriptor",
  "type": "object"
}
