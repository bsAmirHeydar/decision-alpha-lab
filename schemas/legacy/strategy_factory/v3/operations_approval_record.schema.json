{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-alpha-lab.local/schemas/v3/operations_approval_record.schema.json",
  "title": "Operations Approval Record",
  "description": "Closed UCE-I19 contract for approval record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "subject_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "string"
    },
    "revoked_at_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "approval_id",
    "subject_hash",
    "approved_by",
    "approved_at_ms",
    "expires_at_ms",
    "scope",
    "revoked_at_ms"
  ]
}
