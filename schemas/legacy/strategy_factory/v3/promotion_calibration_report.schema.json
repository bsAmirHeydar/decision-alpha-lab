{
  "$id": "https://decision-alpha-lab.local/schemas/v3/promotion_calibration_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "abstention_coverage": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "brier_score": {
      "minimum": 0,
      "type": "number"
    },
    "conformal_coverage": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "decision_net_benefit": {
      "type": "number"
    },
    "details": {
      "type": "object"
    },
    "evidence_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expected_calibration_error": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "log_loss": {
      "minimum": 0,
      "type": "number"
    },
    "report_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "type": "string"
    },
    "risk_tier_error": {
      "minimum": 0,
      "type": "number"
    },
    "target_coverage": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "report_id",
    "brier_score",
    "log_loss",
    "expected_calibration_error",
    "conformal_coverage",
    "target_coverage",
    "decision_net_benefit",
    "abstention_coverage",
    "risk_tier_error",
    "evidence_hash",
    "details"
  ],
  "title": "promotion_calibration_report",
  "type": "object"
}
