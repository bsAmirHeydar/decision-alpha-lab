  "additionalProperties": false,
  "properties": {
    "observations": {
      "items": {
        "$ref": "price_observation.schema.json"
      },
      "type": "array"
    },
    "path_id": {
      "minLength": 8,
      "type": "string"
    },
    "symbol": {
