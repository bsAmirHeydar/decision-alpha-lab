      "required": [
        "feature_order",
        "intercept",
        "link",
        "model_type",
        "weights"
      ],
      "type": "object"
    },
    "network_dependencies": {
      "items": {},
      "type": "array"
    },
    "preprocessing_hash": {
      "type": "string"
    },
    "source_commit_hash": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "submitter_actor_id": {
      "type": "string"
    },
    "training_data_roles": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "adaptive_to_final_evaluation",
    "candidate_id",
    "candidate_version",
    "feature_contract_hash",
    "frozen",
    "hidden_data_touched",
    "inference_entrypoint",
    "model_artifact_hash",
    "model_spec",
    "network_dependencies",
    "preprocessing_hash",
    "source_commit_hash",
    "submitted_at",
