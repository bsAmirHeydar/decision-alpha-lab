{
  "$id": "https://decision-alpha-lab.local/schemas/saed_v4_29/CANDIDATE_SUBMISSION.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adaptive_to_final_evaluation": {
      "type": "boolean"
    },
    "candidate_id": {
      "type": "string"
    },
    "candidate_version": {
      "type": "string"
    },
    "feature_contract_hash": {
      "type": "string"
    },
    "frozen": {
      "type": "boolean"
    },
    "hidden_data_touched": {
      "type": "boolean"
    },
    "inference_entrypoint": {
      "type": "string"
    },
    "model_artifact_hash": {
      "type": "string"
    },
    "model_spec": {
      "additionalProperties": false,
      "properties": {
        "feature_order": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "intercept": {
          "type": "number"
        },
        "link": {
          "type": "string"
        },
        "model_type": {
          "type": "string"
        },
        "weights": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
