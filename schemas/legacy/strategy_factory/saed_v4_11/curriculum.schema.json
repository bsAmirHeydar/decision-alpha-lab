          "epochs",
          "max_pairs_per_record",
          "objective_ids",
          "stage_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "outcome_supervision": {
      "type": "boolean"
    },
    "phase": {
      "type": "string"
    },
    "progression": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
