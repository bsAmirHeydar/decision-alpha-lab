        "type": "object"
      },
      "type": "array"
    },
    "future_training_forbidden": {
      "type": "boolean"
    },
    "phase": {
      "type": "string"
    },
    "sibling_split_forbidden": {
      "type": "boolean"
    },
    "split_hash": {
      "type": "string"
    },
    "split_plan_id": {
      "type": "string"
    }
  },
  "required": [
    "chronological",
    "cluster_aware",
    "fold_count",
    "folds",
    "future_training_forbidden",
    "phase",
    "sibling_split_forbidden",
    "split_hash",
    "split_plan_id"
