{
  "$id": "https://decision-alpha-lab.local/schemas/legacy/strategy_factory/saed_v4_18/golden_split_plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed SAED V4-18 deterministic synthetic reference contract. Unknown fields are forbidden.",
  "properties": {
    "chronological": {
      "type": "boolean"
    },
    "cluster_aware": {
      "type": "boolean"
    },
    "fold_count": {
      "type": "integer"
    },
    "folds": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "embargo_rows": {
            "type": "integer"
          },
          "evaluation_end": {
            "type": "integer"
          },
          "evaluation_ordinals": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "evaluation_start": {
            "type": "integer"
          },
          "fold_id": {
            "type": "string"
          },
          "purge_rows": {
            "type": "integer"
          },
          "train_end": {
            "type": "integer"
          },
          "train_ordinals": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "embargo_rows",
          "evaluation_end",
          "evaluation_ordinals",
          "evaluation_start",
          "fold_id",
          "purge_rows",
          "train_end",
          "train_ordinals"
