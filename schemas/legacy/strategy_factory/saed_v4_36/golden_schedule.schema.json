{
  "$id": "https://alpha-lab.local/saed/v4-36/golden_schedule.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed deterministic SAED V4-36 research-memory and active-planner reference artifact schema.",
  "properties": {
    "all_candidates_scheduled": {
      "type": "boolean"
    },
    "execution_started": {
      "type": "boolean"
    },
    "phase": {
      "type": "string"
    },
    "research_only": {
      "type": "boolean"
    },
    "schedule_hash": {
      "type": "string"
    },
    "schedule_id": {
      "type": "string"
    },
    "wave_count": {
      "type": "integer"
    },
    "waves": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidate_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "execution_status": {
            "type": "string"
          },
          "parallel_count": {
            "type": "integer"
          },
          "wave": {
            "type": "integer"
          }
        },
        "required": [
          "candidate_ids",
          "execution_status",
          "parallel_count",
          "wave"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "all_candidates_scheduled",
    "execution_started",
    "phase",
    "research_only",
    "schedule_hash",
    "schedule_id",
    "wave_count",
    "waves"
  ],
  "title": "GOLDEN_SCHEDULE",
  "type": "object"
}
