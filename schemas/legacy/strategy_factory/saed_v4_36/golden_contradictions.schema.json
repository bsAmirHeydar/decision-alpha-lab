{
  "$id": "https://alpha-lab.local/saed/v4-36/golden_contradictions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed deterministic SAED V4-36 research-memory and active-planner reference artifact schema.",
  "properties": {
    "blocking_count": {
      "type": "integer"
    },
    "open_count": {
      "type": "integer"
    },
    "phase": {
      "type": "string"
    },
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "contradiction_id": {
            "type": "string"
          },
          "oppose_side": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "required_experiment_family": {
            "type": "string"
          },
          "resolution_state": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "support_side": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "synthetic_fixture": {
            "type": "boolean"
          }
        },
        "required": [
          "claim_id",
          "contradiction_id",
          "oppose_side",
          "required_experiment_family",
          "resolution_state",
          "severity",
          "support_side",
          "synthetic_fixture"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "register_hash": {
      "type": "string"
    },
    "register_id": {
      "type": "string"
    },
    "research_only": {
      "type": "boolean"
    }
  },
  "required": [
    "blocking_count",
    "open_count",
    "phase",
    "records",
    "register_hash",
    "register_id",
    "research_only"
  ],
  "title": "GOLDEN_CONTRADICTIONS",
  "type": "object"
}
