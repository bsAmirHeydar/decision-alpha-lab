{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "closed_contract": true,
  "properties": {
    "all_tombstones_covered": {
      "type": "boolean"
    },
    "archive_manifest_hash": {
      "type": "string"
    },
    "archive_manifest_id": {
      "type": "string"
    },
    "immutable": {
      "type": "boolean"
    },
    "package_count": {
      "type": "integer"
    },
    "packages": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "archive_hash": {
            "type": "string"
          },
          "archive_id": {
            "type": "string"
          },
          "cell_id": {
            "type": "string"
          },
          "deletion_allowed": {
            "type": "boolean"
          },
          "evidence_merkle_root": {
            "type": "string"
          },
          "legal_hold": {
            "type": "boolean"
          },
          "mutable": {
            "type": "boolean"
          },
          "reinstatement_authority": {
            "type": "boolean"
          },
          "retention_class": {
            "type": "string"
          },
          "tombstone_hash": {
            "type": "string"
          }
        },
        "required": [
          "archive_hash",
          "archive_id",
          "cell_id",
          "deletion_allowed",
          "evidence_merkle_root",
          "legal_hold",
          "mutable",
          "reinstatement_authority",
          "retention_class",
          "tombstone_hash"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "research_only": {
      "type": "boolean"
    },
    "retirement_ledger_hash": {
      "type": "string"
    }
  },
  "required": [
    "all_tombstones_covered",
    "archive_manifest_hash",
    "archive_manifest_id",
    "immutable",
    "package_count",
    "packages",
    "research_only",
    "retirement_ledger_hash"
  ],
