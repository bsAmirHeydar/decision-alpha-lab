  "required": [
    "request_id",
    "intent_id",
    "intent_hash",
    "action",
    "symbol",
    "direction",
    "order_kind",
    "volume",
    "price",
    "stop_price",
    "target_price",
    "has_target",
    "deviation_points",
    "magic_number",
