      "enum": [
        1,
        2,
        3
      ],
      "type": "integer"
    },
    "deviation_points": {
      "minimum": 0,
      "type": "integer"
    },
    "direction": {
      "enum": [
        -1,
        1
      ],
      "type": "integer"
    },
    "expires_at_utc_msc": {
      "minimum": 1,
      "type": "integer"
    },
    "has_target": {
      "type": "boolean"
    },
    "intent_hash": {
      "minLength": 1,
      "type": "string"
    },
    "intent_id": {
      "minLength": 1,
      "type": "string"
    },
    "magic_number": {
      "minimum": 0,
      "type": "integer"
    },
    "order_kind": {
      "enum": [
        1,
        2,
        3
      ],
      "type": "integer"
    },
    "price": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "request_hash": {
      "minLength": 1,
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "stop_price": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "symbol": {
      "minLength": 1,
      "type": "string"
    },
    "target_price": {
      "type": "number"
    },
    "volume": {
      "exclusiveMinimum": 0,
      "type": "number"
    }
