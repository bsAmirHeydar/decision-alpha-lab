{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chain_hash": {
      "minLength": 1,
      "type": "string"
    },
    "entity_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_time_utc_msc": {
      "minimum": 1,
      "type": "integer"
    },
    "message": {
      "type": "string"
    },
    "payload_hash": {
      "minLength": 1,
      "type": "string"
    },
    "previous_chain_hash": {
      "minLength": 1,
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "transaction_id": {
      "minLength": 1,
      "type": "string"
    },
    "transaction_type": {
      "maximum": 17,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "transaction_id",
    "sequence",
    "transaction_type",
    "entity_id",
    "event_time_utc_msc",
    "previous_chain_hash",
    "payload_hash",
