{
  "$id": "alpha_lab.strategy_factory/research_run_manifest@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "candidate_matrix_hash": {
      "type": "string"
    },
    "cost_registry_hash": {
      "type": "string"
    },
    "fidelity_preset": {
      "maximum": 3,
      "minimum": 0,
      "type": "integer"
    },
    "manifest_hash": {
      "type": "string"
    },
    "objective_mode": {
      "maximum": 3,
      "minimum": 0,
      "type": "integer"
    },
    "run_id": {
      "type": "string"
    },
