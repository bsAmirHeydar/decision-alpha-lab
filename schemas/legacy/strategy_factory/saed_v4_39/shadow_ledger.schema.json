          "intent_id": {
            "type": "string"
          },
          "known_time": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "observation_id": {
            "type": "string"
          },
          "order_submitted": {
            "type": "boolean"
          },
          "ordinal": {
            "type": "integer"
          },
          "paper_net_pnl_bps": {
