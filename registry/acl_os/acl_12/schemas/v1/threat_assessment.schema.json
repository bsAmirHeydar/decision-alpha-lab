{
  "$id": "https://alpha-lab.local/acl12/threat_assessment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed ACL-12 reference contract.",
  "properties": {
    "assessment_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "open_production_gap_count": {
      "type": "integer"
    },
    "production_risk_accepted": {
      "type": "boolean"
    },
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "incomplete_controls": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "inherent_severity": {
            "type": "string"
          },
          "mapped_controls": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "production_risk_accepted": {
            "type": "boolean"
          },
          "residual_state": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "threat_id": {
            "type": "string"
          },
          "threat_result_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "incomplete_controls",
          "inherent_severity",
          "mapped_controls",
          "production_risk_accepted",
          "residual_state",
          "schema_version",
          "threat_id",
          "threat_result_digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "type": "string"
    },
    "threat_count": {
      "type": "integer"
    },
    "threat_registry_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "assessment_digest",
    "open_production_gap_count",
    "production_risk_accepted",
    "results",
    "schema_version",
    "threat_count",
    "threat_registry_digest"
  ],
  "title": "threat_assessment",
  "type": "object"
}
