{
  "$id": "https://alpha-lab.local/acl12/scan_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed ACL-12 reference contract.",
  "properties": {
    "files_scanned": {
      "type": "integer"
    },
    "finding_count": {
      "type": "integer"
    },
    "findings": {
      "items": {},
      "type": "array"
    },
    "passed": {
      "type": "boolean"
    },
    "scan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "scan_type": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "files_scanned",
    "finding_count",
    "findings",
    "passed",
    "scan_digest",
    "scan_type",
    "schema_version"
  ],
  "title": "scan_report",
  "type": "object"
}
