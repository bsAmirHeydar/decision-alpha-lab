    "interface_id": {
      "type": "string"
    },
    "key_export_allowed": {
      "type": "boolean"
    },
    "production_key_access_allowed": {
      "type": "boolean"
    },
    "production_key_material_present": {
      "type": "boolean"
    },
    "provider_connected": {
