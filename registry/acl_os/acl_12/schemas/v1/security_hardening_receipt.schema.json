{
  "$id": "https://alpha-lab.local/acl12/security_hardening_receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed ACL-12 reference contract.",
  "properties": {
    "acl13_handoff_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "artifact_count": {
      "type": "integer"
    },
    "output_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "receipt_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "reference_only": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "string"
    },
    "security_hardening_run_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "security_hardening_run_id": {
      "type": "string"
    },
    "security_readiness_decision_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "acl13_handoff_digest",
    "artifact_count",
    "output_manifest_digest",
    "receipt_digest",
    "reference_only",
    "schema_version",
    "security_hardening_run_digest",
    "security_hardening_run_id",
    "security_readiness_decision_digest"
  ],
  "title": "security_hardening_receipt",
  "type": "object"
}
