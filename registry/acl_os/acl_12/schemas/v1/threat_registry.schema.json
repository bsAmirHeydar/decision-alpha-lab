{
  "$id": "https://alpha-lab.local/acl12/threat_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed ACL-12 reference contract.",
  "properties": {
    "closed": {
      "type": "boolean"
    },
    "registry_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "registry_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "threat_count": {
      "type": "integer"
    },
    "threats": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "domain": {
            "type": "string"
          },
          "inherent_severity": {
            "type": "string"
          },
          "threat_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "domain",
          "inherent_severity",
          "threat_id",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "closed",
    "registry_digest",
    "registry_id",
    "schema_version",
    "threat_count",
    "threats"
  ],
  "title": "threat_registry",
  "type": "object"
}
