{
  "$id": "https://alpha-lab.local/acl12/incident_response_readiness.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed ACL-12 reference contract.",
  "properties": {
    "communication_matrix_defined": {
      "type": "boolean"
    },
    "evidence_preservation_defined": {
      "type": "boolean"
    },
    "playbook_count": {
      "type": "integer"
    },
    "playbooks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "production_on_call_verified": {
      "type": "boolean"
    },
    "readiness_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "readiness_id": {
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "type": "string"
    },
    "severity_model_defined": {
      "type": "boolean"
    },
    "tabletop_exercise_completed": {
      "type": "boolean"
    }
  },
  "required": [
    "communication_matrix_defined",
    "evidence_preservation_defined",
    "playbook_count",
    "playbooks",
    "production_on_call_verified",
    "readiness_digest",
    "readiness_id",
    "reason_codes",
    "schema_version",
    "severity_model_defined",
    "tabletop_exercise_completed"
  ],
  "title": "incident_response_readiness",
  "type": "object"
}
