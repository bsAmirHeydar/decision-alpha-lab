{
  "$id": "https://alpha-lab.local/acl12/acl11_binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed ACL-12 reference contract.",
  "properties": {
    "acl11_handoff_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "binding_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "custody_decision_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "event_ledger_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "parity_assessment_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "promotion_run_id": {
      "type": "string"
    },
    "provenance_graph_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_candidate_count": {
      "type": "integer"
    },
    "runtime_custody_run_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_custody_run_id": {
      "type": "string"
    },
    "runtime_generation_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "signing_plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "tcb_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "acl11_handoff_digest",
    "binding_digest",
    "custody_decision_digest",
    "event_ledger_digest",
    "parity_assessment_digest",
    "promotion_run_id",
    "provenance_graph_digest",
    "runtime_candidate_count",
    "runtime_custody_run_digest",
    "runtime_custody_run_id",
    "runtime_generation_manifest_digest",
    "schema_version",
    "signing_plan_digest",
    "tcb_digest"
  ],
  "title": "acl11_binding",
  "type": "object"
}
