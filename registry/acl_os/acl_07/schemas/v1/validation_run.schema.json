{
  "$id": "https://alpha-lab.local/acl07/validation_run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alpha_claim_allowed": {},
    "batch_id": {
      "minLength": 1,
      "type": "string"
    },
    "capital_activation_allowed": {},
    "claim_ceiling": {
      "minLength": 1,
      "type": "string"
    },
    "decision_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "gate_matrix_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "gate_registry_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "input_binding_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "live_order_submission_allowed": {},
    "policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "promotion_allowed": {},
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "state": {
      "minLength": 1,
      "type": "string"
    },
    "validated_at": {},
    "validation_id": {
      "minLength": 1,
      "type": "string"
    },
    "validation_run_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "validator_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "validation_id",
    "run_id",
    "batch_id",
    "state",
    "validated_at",
    "validator_version",
    "claim_ceiling",
    "input_binding_digest",
    "policy_digest",
    "gate_registry_digest",
    "gate_matrix_digest",
    "decision_bundle_digest",
    "alpha_claim_allowed",
    "promotion_allowed",
    "live_order_submission_allowed",
    "capital_activation_allowed",
    "validation_run_digest"
