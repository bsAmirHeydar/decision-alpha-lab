{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acyclic_required": {
      "const": true
    },
    "context_id": {
      "minLength": 1,
      "type": "string"
    },
    "edges": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "lineage_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "nodes": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context_id",
    "nodes",
    "edges",
    "acyclic_required",
    "lineage_digest"
  ],
  "type": "object"
}
