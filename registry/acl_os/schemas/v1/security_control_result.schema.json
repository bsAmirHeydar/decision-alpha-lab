{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "passed": {
            "type": "boolean"
          },
          "reason_code": {
            "type": "string"
          }
        },
        "required": [
          "check_id",
          "passed",
          "reason_code"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "control_id": {
      "pattern": "^SEC_[A-Z0-9_.:-]{3,120}$",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "type": "string"
    },
    "evaluator": {
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "pattern": "^[A-Z][A-Z0-9_.:-]{2,127}$",
            "type": "string"
          },
          "digest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "locator": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "version",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "DEGRADED",
        "NOT_APPLICABLE"
      ]
    },
    "subject_ref": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Z][A-Z0-9_.:-]{2,127}$",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "version",
        "digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "control_id",
    "subject_ref",
    "status",
    "severity",
    "checks",
    "evidence_refs",
    "evaluated_at"
  ],
  "title": "ACL Security Control Result",
  "type": "object"
}
