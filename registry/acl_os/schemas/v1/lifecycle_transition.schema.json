{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "minLength": 1,
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "type": "string"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "WAIVE"
      ]
    },
    "evidence_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "pattern": "^[A-Z][A-Z0-9_.:-]{2,127}$",
            "type": "string"
          },
          "digest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "locator": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "version",
          "digest"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "from_state": {
      "type": "string"
    },
    "reasons": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[A-Z0-9_]{3,80}$",
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "artifact_id": {
                  "pattern": "^[A-Z][A-Z0-9_.:-]{2,127}$",
                  "type": "string"
                },
                "digest": {
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "type": "string"
                },
                "locator": {
                  "minLength": 1,
                  "type": "string"
                },
                "version": {
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
                  "type": "string"
                }
              },
              "required": [
                "artifact_id",
                "version",
                "digest"
              ],
              "type": "object"
            },
            "type": "array",
            "uniqueItems": true
          },
          "message": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "signature_ref": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Z][A-Z0-9_.:-]{2,127}$",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "subject_ref": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Z][A-Z0-9_.:-]{2,127}$",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "to_state": {
      "type": "string"
    },
    "transition_id": {
      "pattern": "^TRN_[A-Z0-9_:-]{6,120}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "transition_id",
    "subject_ref",
    "from_state",
    "to_state",
    "decision",
    "reasons",
    "evidence_refs",
    "actor",
    "decided_at"
  ],
  "title": "ACL Lifecycle Transition",
  "type": "object"
}
