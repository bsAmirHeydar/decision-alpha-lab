{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "pattern": "^[A-Z][A-Z0-9_.:-]{2,159}$",
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "message": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "remediation": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR",
        "BLOCKER"
      ]
    }
  },
  "required": [
    "code",
    "severity",
    "path",
    "details"
  ],
  "type": "object"
}
