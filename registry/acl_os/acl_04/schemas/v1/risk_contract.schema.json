{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "max_risk_units": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "type": "number"
    },
    "protective_reference_required": {
      "type": "boolean"
    },
    "sizing_mode": {
      "pattern": "^[A-Z][A-Z0-9_.:-]{2,159}$",
      "type": "string"
    }
  },
  "required": [
    "sizing_mode",
    "max_risk_units",
    "protective_reference_required"
  ],
  "type": "object"
}
