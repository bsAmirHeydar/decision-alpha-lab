{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ai_exposures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "complete_enumeration": {
            "type": "boolean"
          },
          "compute_units": {
            "type": "integer"
          },
          "generator": {
            "type": "string"
          },
          "materialized_candidates": {
            "type": "integer"
          },
          "request_id": {
            "pattern": "^[A-Z][A-Z0-9_.:-]{2,159}$",
            "type": "string"
          },
          "requested_candidates": {
            "type": "integer"
          },
          "schema_version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "vary_parameters": {
            "items": {
              "pattern": "^[A-Z][A-Z0-9_.:-]{2,159}$",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "generator",
          "seed",
          "requested_candidates",
          "materialized_candidates",
          "compute_units",
          "vary_parameters",
          "complete_enumeration"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "authority_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "authority_id": {
      "pattern": "^[A-Z][A-Z0-9_.:-]{2,159}$",
      "type": "string"
    },
    "baseline_count": {
      "minimum": 0,
      "type": "integer"
    },
    "complete_search_exposure_recorded": {
      "const": true
    },
    "human_definition_count": {
      "minimum": 0,
      "type": "integer"
    },
    "ledger_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "total_materialized": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "authority_id",
    "authority_digest",
    "human_definition_count",
    "ai_exposures",
    "baseline_count",
    "total_materialized",
    "complete_search_exposure_recorded",
    "ledger_digest"
  ],
  "type": "object"
}
