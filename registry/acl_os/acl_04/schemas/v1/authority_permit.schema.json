{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "ACL04_BUILD_SETUP_UNIVERSE"
    },
    "actor_id": {
      "pattern": "^[A-Z][A-Z0-9_.:-]{2,159}$",
      "type": "string"
    },
    "capital_activation_allowed": {
      "const": false
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY"
      ]
    },
    "expires_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "issued_at": {
      "format": "date-time",
      "type": "string"
    },
    "live_order_submission_allowed": {
      "const": false
    },
    "permit_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "permit_id": {
      "pattern": "^[A-Z][A-Z0-9_.:-]{2,159}$",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "subject_context_id": {
      "minLength": 1,
      "type": "string"
    },
    "upstream_handoff_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "permit_id",
    "decision",
    "action",
    "subject_context_id",
    "upstream_handoff_digest",
    "actor_id",
    "issued_at",
    "live_order_submission_allowed",
    "capital_activation_allowed",
    "permit_digest"
  ],
  "type": "object"
}
