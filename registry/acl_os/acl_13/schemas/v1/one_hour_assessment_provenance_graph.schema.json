{
  "$id": "https://alpha-lab.local/schemas/acl13/one_hour_assessment_provenance_graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capital_authority_created": {
      "type": "boolean"
    },
    "edges": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "graph_digest": {
      "type": "string"
    },
    "live_order_authority_created": {
      "type": "boolean"
    },
    "nodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_digest": {
            "type": "string"
          },
          "artifact_type": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          }
        },
        "required": [
          "artifact_digest",
          "artifact_type",
          "node_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "pilot_execution_authority_created": {
      "type": "boolean"
    },
    "production_security_evidence_invented": {
      "type": "boolean"
    },
    "reaches_acl12_security_readiness": {
      "type": "boolean"
    },
    "runtime_candidate_invented": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "string"
    },
    "source_security_readiness_reinterpreted": {
      "type": "boolean"
    },
    "synthetic_reference_disclosed": {
      "type": "boolean"
    },
    "validation_evidence_invented": {
      "type": "boolean"
    }
  },
  "required": [
    "capital_authority_created",
    "edges",
    "graph_digest",
    "live_order_authority_created",
    "nodes",
    "pilot_execution_authority_created",
    "production_security_evidence_invented",
    "reaches_acl12_security_readiness",
    "runtime_candidate_invented",
    "schema_version",
    "source_security_readiness_reinterpreted",
    "synthetic_reference_disclosed",
    "validation_evidence_invented"
  ],
  "title": "One Hour Assessment Provenance Graph",
  "type": "object"
}
