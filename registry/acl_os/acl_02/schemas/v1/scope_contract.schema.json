{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "directions": {
      "items": {
        "enum": [
          "LONG",
          "SHORT",
          "NEUTRAL",
          "BIDIRECTIONAL"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "exclusions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "exclusion_id": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "exclusion_id",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "goals": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "markets": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "non_goals": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "sessions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "symbols": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "timeframes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "symbols",
    "markets",
    "timeframes",
    "sessions",
    "directions",
    "goals",
    "non_goals",
    "exclusions"
  ],
  "title": "ACL-02 Scope",
  "type": "object"
}
