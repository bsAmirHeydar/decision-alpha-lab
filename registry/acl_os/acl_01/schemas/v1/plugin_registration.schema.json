{
  "$id": "https://schemas.alpha-lab.local/acl-os/acl-01/v1/plugin_registration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "conformance_suite": {
      "type": "string"
    },
    "entry_point": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "plugin_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "QUARANTINED",
        "RETIRED"
      ]
    },
    "tenant_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "plugin_id",
    "tenant_id",
    "version",
    "kind",
    "entry_point",
    "capabilities",
    "conformance_suite",
    "status"
  ],
  "title": "plugin_registration.schema.json",
  "type": "object"
}
