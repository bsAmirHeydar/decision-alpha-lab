{
  "$id": "https://schemas.alpha-lab.local/acl-os/acl-01/v1/locator_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capital_activation_allowed": {
      "const": false
    },
    "descriptor": {
      "oneOf": [
        {
          "$ref": "https://schemas.alpha-lab.local/acl-os/acl-01/v1/artifact_descriptor.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "live_order_submission_allowed": {
      "const": false
    },
    "reasons": {
      "items": {
        "$ref": "https://schemas.alpha-lab.local/acl-os/acl-01/v1/reason.schema.json"
      },
      "type": "array"
    },
    "registry_digest": {
      "type": "string"
    },
    "requested_ref": {
      "type": "string"
    },
    "resolved_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "enum": [
        "RESOLVED",
        "NOT_FOUND",
        "AMBIGUOUS",
        "INTEGRITY_FAILURE",
        "POLICY_DENIED",
        "INCOMPATIBLE"
      ]
    },
    "verified_digest": {
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "requested_ref",
    "descriptor",
    "reasons",
    "resolved_at",
    "registry_digest",
    "verified_digest",
    "live_order_submission_allowed",
    "capital_activation_allowed"
  ],
  "title": "locator_result.schema.json",
  "type": "object"
}
