{
  "$id": "https://schemas.alpha-lab.local/acl-os/acl-00/v1/policy_bundle_snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "documents": {
      "type": "object"
    },
    "policy_bundle_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "policy_bundle_digest",
    "documents",
    "created_at"
  ],
  "title": "ACL-00 Policy Bundle Snapshot",
  "type": "object"
}
