{
  "$id": "https://alpha-lab.local/acl11/ACL12Handoff.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capital_activation_allowed": {
      "type": "boolean"
    },
    "custody_decision": {
      "type": "string"
    },
    "custody_decision_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "event_ledger_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "forbidden_acl12_actions": {
      "type": "array"
    },
    "handoff_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "handoff_type": {
      "const": "ACL11_TO_ACL12"
    },
    "live_order_submission_allowed": {
      "type": "boolean"
    },
    "parity_assessment_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "promotion_run_id": {
      "type": "string"
    },
    "provenance_graph_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "required_acl12_actions": {
      "type": "array"
    },
    "runtime_activation_allowed": {
      "type": "boolean"
    },
    "runtime_candidate_count": {
      "minimum": 0,
      "type": "integer"
    },
    "runtime_custody_run_id": {
      "type": "string"
    },
    "runtime_generation_allowed": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "string"
    },
    "security_report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "handoff_type",
    "runtime_custody_run_id",
    "custody_decision",
    "required_acl12_actions",
    "forbidden_acl12_actions",
    "handoff_digest"
  ],
  "title": "ACL12Handoff",
  "type": "object"
}
