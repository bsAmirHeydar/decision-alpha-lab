{
  "$id": "https://alpha-lab.local/acl11/AuthorityPermit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acl10_handoff_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "action": {
      "const": "ACL11_ASSESS_RUNTIME_CUSTODY"
    },
    "capital_activation_allowed": {
      "type": "boolean"
    },
    "expires_at": {
      "type": "string"
    },
    "issued_at": {
      "type": "string"
    },
    "live_order_submission_allowed": {
      "type": "boolean"
    },
    "network_access_allowed": {
      "type": "boolean"
    },
    "permit_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "permit_id": {
      "type": "string"
    },
    "phase": {
      "const": "ACL-11"
    },
    "promotion_run_id": {
      "type": "string"
    },
    "runtime_activation_allowed": {
      "type": "boolean"
    },
    "runtime_generation_allowed": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "string"
    },
    "secret_access_allowed": {
      "type": "boolean"
    },
    "signing_key_access_allowed": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "phase",
    "action",
    "promotion_run_id",
    "acl10_handoff_digest",
    "permit_digest"
  ],
  "title": "AuthorityPermit",
  "type": "object"
}
