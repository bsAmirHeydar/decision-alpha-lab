{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_behavior_mutated": {
      "type": "boolean"
    },
    "edges": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "graph_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "graph_id": {
      "type": "string"
    },
    "nodes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "reaches_frozen_batch": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "candidate_behavior_mutated",
    "edges",
    "graph_digest",
    "graph_id",
    "nodes",
    "reaches_frozen_batch",
    "schema_version"
  ],
  "type": "object"
}
