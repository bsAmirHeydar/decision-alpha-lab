{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "capital_activation_allowed": {
      "type": "boolean"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "dag_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "event_ledger_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "forbidden_acl07_actions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "handoff_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "handoff_type": {
      "type": "string"
    },
    "live_order_submission_allowed": {
      "type": "boolean"
    },
    "object_index_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "provenance_graph_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "required_acl07_actions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "research_run_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "resource_accounting_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "result_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "task_receipt_set_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "capital_activation_allowed",
    "claim_ceiling",
    "dag_digest",
    "event_ledger_digest",
    "forbidden_acl07_actions",
    "handoff_digest",
    "handoff_type",
    "live_order_submission_allowed",
    "object_index_digest",
    "provenance_graph_digest",
    "required_acl07_actions",
    "research_run_digest",
    "resource_accounting_digest",
    "result_bundle_digest",
    "run_id",
    "schema_version",
    "task_receipt_set_digest"
  ],
  "type": "object"
}
