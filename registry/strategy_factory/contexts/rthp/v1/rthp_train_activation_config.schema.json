{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registry/strategy_factory/contexts/rthp/v1/rthp_train_activation_config.schema.json",
  "title": "RTHP Train Activation Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "output_root", "data_source", "split_policy", "resource_policy"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "output_root": {"type": "string", "minLength": 1},
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "provider", "primary_symbol", "secondary_symbol", "primary_tick_jsonl", "secondary_tick_jsonl", "timezone", "price_basis", "tick_size_source", "contract_roll_policy", "entitlement_id", "producer_version", "availability_time_policy", "source_revision"],
      "properties": {
        "mode": {"const": "PAIRED_TICK_JSONL"},
        "provider": {"type": "string", "minLength": 1},
        "primary_symbol": {"type": "string", "minLength": 1},
        "secondary_symbol": {"type": "string", "minLength": 1},
        "primary_tick_jsonl": {"type": "string", "minLength": 1},
        "secondary_tick_jsonl": {"type": "string", "minLength": 1},
        "timezone": {"const": "America/New_York"},
        "price_basis": {"const": "BID"},
        "tick_size_source": {"type": "string", "minLength": 1},
        "contract_roll_policy": {"type": "string", "minLength": 1},
        "entitlement_id": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "minLength": 1},
        "availability_time_policy": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "start_time_ms": {"type": ["integer", "null"]},
        "end_time_ms": {"type": ["integer", "null"]},
        "max_confirmation_freshness_ms": {"type": "integer", "minimum": 0}
      }
    },
    "split_policy": {"type": "object"},
    "resource_policy": {"type": "object"},
    "selected_task_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "family_filter": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "train_all_mature_tasks": {"type": "boolean"},
    "retain_materialized_views": {"type": "boolean"},
    "fail_on_task_insufficiency": {"type": "boolean"}
  }
}
