{
  "$id": "registry/strategy_factory/contexts/rthp/v1/rthp_train_activation_config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data_source": {
      "additionalProperties": false,
      "properties": {
        "availability_time_policy": {
          "minLength": 1,
          "type": "string"
        },
        "contract_roll_policy": {
          "minLength": 1,
          "type": "string"
        },
        "end_time_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "entitlement_id": {
          "minLength": 1,
          "type": "string"
        },
        "max_confirmation_freshness_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "enum": [
            "PAIRED_TICK_JSONL",
            "PAIRED_M1_BAR_JSONL"
          ]
        },
        "price_basis": {
          "const": "BID"
        },
        "primary_m1_bar_jsonl": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_symbol": {
          "minLength": 1,
          "type": "string"
        },
        "primary_tick_jsonl": {
          "minLength": 1,
          "type": "string"
        },
        "producer_version": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "secondary_m1_bar_jsonl": {
          "type": [
            "string",
            "null"
          ]
        },
        "secondary_symbol": {
          "minLength": 1,
          "type": "string"
        },
        "secondary_tick_jsonl": {
          "minLength": 1,
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "type": "string"
        },
        "start_time_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tick_size_source": {
          "minLength": 1,
          "type": "string"
        },
        "timezone": {
          "const": "America/New_York"
        }
      },
      "required": [
        "mode",
        "provider",
        "primary_symbol",
        "secondary_symbol",
        "primary_tick_jsonl",
        "secondary_tick_jsonl",
        "timezone",
        "price_basis",
        "tick_size_source",
        "contract_roll_policy",
        "entitlement_id",
        "producer_version",
        "availability_time_policy",
        "source_revision"
      ],
      "type": "object"
    },
    "fail_on_task_insufficiency": {
      "type": "boolean"
    },
    "family_filter": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "output_root": {
      "minLength": 1,
      "type": "string"
    },
    "resource_policy": {
      "type": "object"
    },
    "retain_materialized_views": {
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "selected_task_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "split_policy": {
      "type": "object"
    },
    "train_all_mature_tasks": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "output_root",
    "data_source",
    "split_policy",
    "resource_policy"
  ],
  "title": "RTHP Train Activation Configuration",
  "type": "object"
}
