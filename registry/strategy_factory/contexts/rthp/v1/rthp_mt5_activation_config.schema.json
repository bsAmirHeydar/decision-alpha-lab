{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alpha-lab:rthp:mt5-activation-config:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "output_root",
    "symbols",
    "terminal",
    "history",
    "quality",
    "train",
    "source_revision",
    "contract_roll_policy",
    "entitlement_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "output_root": {
      "type": "string",
      "minLength": 1
    },
    "symbols": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "canonical_primary_id",
        "canonical_secondary_id"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "secondary": {
          "type": "string",
          "minLength": 1
        },
        "canonical_primary_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_secondary_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "terminal": {
      "type": "object"
    },
    "history": {
      "type": "object"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_common_bars": {
          "type": "integer",
          "minimum": 1
        },
        "max_symbol_specific_gap_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "max_joint_gap_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_unexplained_gap_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "require_exact_m15_coverage": {
          "type": "boolean"
        },
        "reject_sub_m1": {
          "const": true
        },
        "drop_incomplete_current_bar": {
          "const": true
        },
        "session_calendar_profile": {
          "enum": [
            "AUTO",
            "WEEKLY_ONLY_V1",
            "US_INDEX_CFD_NY_V1"
          ]
        },
        "max_scheduled_closure_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "require_scheduled_closure_boundary_bars": {
          "type": "boolean"
        }
      }
    },
    "train": {
      "type": "object"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "contract_roll_policy": {
      "type": "string",
      "minLength": 1
    },
    "entitlement_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
