{
  "$id": "https://alpha-lab.local/lcm10a/treatment_atom_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "atom_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "atom_type": {
      "type": "string"
    },
    "claim_ceiling": {
      "const": "LCM_10A_REFERENCE_ONLY",
      "type": "string"
    },
    "deterministic_identity": {
      "const": true,
      "type": "boolean"
    },
    "evidence_count": {
      "minimum": 1,
      "type": "integer"
    },
    "evidence_locations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "excerpt": {
            "type": "string"
          },
          "line_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "line_number": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "line_number",
          "line_digest",
          "excerpt"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "executable_rule_extracted": {
      "const": false
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_time_semantics": {
      "minLength": 1,
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "mode_classes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "owner": {
      "additionalProperties": false,
      "properties": {
        "code_owner_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner_resolution_status": {
          "type": "string"
        },
        "ownership_is_human_approved": {
          "type": "boolean"
        },
        "security_reviewer_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "security_sensitive": {
          "type": "boolean"
        },
        "semantic_owner_role": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code_owner_role",
        "semantic_owner_role",
        "owner_resolution_status",
        "ownership_is_human_approved",
        "security_sensitive"
      ],
      "type": "object"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "semantic_status": {
      "const": "OBSERVED_STATIC_NOT_NORMALIZED"
    },
    "source_delete_performed": {
      "const": false
    },
    "source_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "source_move_performed": {
      "const": false
    },
    "source_path": {
      "minLength": 1,
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      },
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "symbol_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "symbol_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "treatment_atom_id": {
      "minLength": 3,
      "type": "string"
    },
    "validation_status": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "producer",
    "source_digests",
    "generated_at",
    "generated_time_semantics",
    "deterministic_identity",
    "owner",
    "reviewer",
    "claim_ceiling",
    "validation_status",
    "treatment_atom_id",
    "atom_type",
    "source_path",
    "source_sha256",
    "language",
    "mode_classes",
    "evidence_locations",
    "evidence_count",
    "semantic_status",
    "executable_rule_extracted",
    "source_move_performed",
    "source_delete_performed",
    "atom_digest"
  ],
  "title": "treatment_atom_record",
  "type": "object"
}
