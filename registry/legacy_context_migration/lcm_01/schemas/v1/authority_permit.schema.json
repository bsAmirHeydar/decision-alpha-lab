{
  "$id": "https://alpha-lab.local/lcm01/schemas/v1/authority_permit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "action": {
      "const": "LCM01_RUN_FORENSIC_REPOSITORY_SURVEY"
    },
    "permit_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "phase_id": {
      "const": "LCM-01"
    }
  },
  "required": [
    "schema_version",
    "permit_id",
    "phase_id",
    "action",
    "permit_digest"
  ],
  "title": "LCM01 Authority Permit",
  "type": "object"
}
