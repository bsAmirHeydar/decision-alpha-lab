  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_count": {
      "minimum": 1,
      "type": "integer"
    },
    "phase_id": {
      "const": "LCM-01"
    },
    "summary_digest": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "phase_id",
    "survey_id",
    "artifact_count",
    "summary_digest"
  ],
  "title": "LCM01 Survey Summary",
  "type": "object"
}
