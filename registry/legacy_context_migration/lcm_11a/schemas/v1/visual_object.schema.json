{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "blocker_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "source_path": {
      "minLength": 1,
      "type": "string"
    },
    "surface_kind": {
      "enum": [
        "CHART_OBJECT",
        "INDICATOR_BUFFER",
        "REPORT_PROJECTION"
      ]
    },
    "visual_object_id": {
      "pattern": "^VISOBJ_[A-F0-9]{32}$",
      "type": "string"
    }
  },
  "required": [
    "visual_object_id",
    "source_path",
    "surface_kind",
    "object_type",
    "owner",
    "source_event_type",
    "active_status"
  ],
  "title": "LCM-11A Visual Object",
  "type": "object"
}
