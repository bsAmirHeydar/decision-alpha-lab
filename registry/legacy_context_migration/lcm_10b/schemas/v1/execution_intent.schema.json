{
  "$id": "https://alpha-lab.local/lcm10b/execution_intent.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "adapter_mode": {
      "enum": [
        "DRY_RUN"
      ]
    },
    "claim_ceiling": {
      "const": "LCM_10B_REFERENCE_ONLY",
      "type": "string"
    },
    "deterministic_identity": {
      "const": true,
      "type": "boolean"
    },
    "entry": {
      "type": "object"
    },
    "generated_at": {
      "type": [
        "null",
        "string"
      ]
    },
    "generated_time_semantics": {
      "type": "string"
    },
    "intent_digest": {
      "type": "string"
    },
    "intent_id": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "side": {
      "enum": [
        "BUY",
        "SELL",
        "UNKNOWN"
      ]
    },
    "source_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "stop": {
      "type": "object"
    },
    "submission_requested": {
      "const": false,
      "type": "boolean"
    },
    "symbol": {
      "type": [
        "string",
        "null"
      ]
    },
    "targets": {
      "type": "array"
    },
    "treatment_package_id": {
      "type": "string"
    },
    "validation_status": {
      "type": "string"
    },
    "volume_request": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "producer",
    "source_digests",
    "generated_at",
    "generated_time_semantics",
    "deterministic_identity",
    "owner",
    "reviewer",
    "claim_ceiling",
    "validation_status",
    "intent_id",
    "treatment_package_id",
    "side",
    "symbol",
    "entry",
    "submission_requested",
    "intent_digest"
  ],
  "title": "execution_intent",
  "type": "object"
}
