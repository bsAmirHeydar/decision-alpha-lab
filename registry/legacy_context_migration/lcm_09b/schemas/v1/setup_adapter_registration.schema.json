{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "adapter_id": {
      "pattern": "^[A-Z][A-Z0-9_.:-]{2,191}$",
      "type": "string"
    },
    "adapter_status": {
      "enum": [
        "REFERENCE_READY",
        "REFERENCE_BLOCKED"
      ]
    },
    "claim_ceiling": {
      "const": "LCM_09B_REFERENCE_ONLY"
    },
    "executes_legacy_source": {
      "const": false
    },
    "generated_time_semantics": {
      "minLength": 1,
      "type": "string"
    },
    "input_contract": {
      "type": "string"
    },
    "output_contract": {
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_.:-]{2,191}$",
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "setup_id": {
      "pattern": "^[A-Z][A-Z0-9_.:-]{2,191}$",
      "type": "string"
    },
    "source_artifact_path": {
      "type": "string"
    },
    "source_artifact_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "source_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "BLOCKED",
        "UNKNOWN",
        "FAIL"
      ]
    }
  },
  "required": [
    "schema_version",
    "producer",
    "source_digests",
    "generated_time_semantics",
    "owner",
    "claim_ceiling",
    "validation_status",
    "adapter_id",
    "setup_id",
    "source_artifact_path",
    "source_artifact_sha256",
    "adapter_status",
    "input_contract",
    "output_contract",
    "executes_legacy_source",
    "reason_codes",
    "adapter_digest"
  ],
  "title": "Adapter registration",
  "type": "object"
}
