{
  "$id": "https://alpha-lab.local/lcm12a/documentation_canonical_map.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "claim_ceiling": {
      "const": "LCM_12A_REFERENCE_ONLY"
    },
    "delete_count": {
      "const": 0
    },
    "deterministic_identity": {
      "const": true
    },
    "generated_at": {
      "type": [
        "null",
        "string"
      ]
    },
    "generated_time_semantics": {
      "const": "DETERMINISTIC_FROM_BOUND_INPUTS_NO_WALL_CLOCK_IDENTITY"
    },
    "map_digest": {
      "type": "string"
    },
    "map_id": {
      "type": "string"
    },
    "mappings": {
      "type": "array"
    },
    "master_phase": {
      "const": "LCM-12"
    },
    "move_count": {
      "const": 0
    },
    "owner": {
      "type": "string"
    },
    "phase_id": {
      "const": "LCM-12A"
    },
    "producer": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "FAILED",
        "UNKNOWN",
        "BLOCKED"
      ]
    }
  },
  "required": [
    "schema_version",
    "phase_id",
    "master_phase",
    "claim_ceiling",
    "producer",
    "owner",
    "reviewer",
    "generated_at",
    "generated_time_semantics",
    "deterministic_identity",
    "source_digests",
    "validation_status",
    "map_id",
    "mappings",
    "move_count",
    "delete_count",
    "map_digest"
  ],
  "title": "documentation_canonical_map",
  "type": "object"
}
