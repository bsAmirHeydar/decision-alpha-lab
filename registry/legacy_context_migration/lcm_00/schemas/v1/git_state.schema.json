      "type": "string"
    },
    "git_state_digest": {
      "type": "string"
    },
    "head_commit": {
      "type": "string"
    },
    "lfs_available": {},
    "reason_codes": {
      "type": "array"
    },
    "repository_metadata_available": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "status_porcelain_v2": {
      "type": "string"
    },
    "submodule_status": {
      "type": "string"
    },
