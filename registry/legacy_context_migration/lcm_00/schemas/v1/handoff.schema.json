{
  "$id": "https://alpha-lab.local/lcm00/handoff.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_actions": {
      "type": "array"
    },
    "baseline_id": {
      "type": "string"
    },
    "baseline_manifest_digest": {
      "type": "string"
    },
    "baseline_state": {
      "type": "string"
    },
    "completed_gates": {
      "type": "array"
    },
    "forbidden_actions": {
      "type": "array"
    },
    "handoff_digest": {
      "type": "string"
    },
    "handoff_type": {
      "const": "LCM00_TO_LCM01"
    },
    "human_approval_status": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "unresolved_blockers": {
      "type": "array"
    }
  },
  "required": [
    "handoff_type",
    "baseline_id",
    "allowed_actions",
    "forbidden_actions",
    "handoff_digest"
  ],
  "title": "handoff",
  "type": "object"
}
