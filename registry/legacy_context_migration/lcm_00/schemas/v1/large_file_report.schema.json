  "additionalProperties": false,
  "properties": {
    "external_storage_required": {
      "type": "boolean"
    },
    "files": {
      "type": "array"
    },
    "large_file_count": {
      "minimum": 0,
      "type": "integer"
    },
    "large_file_report_digest": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
