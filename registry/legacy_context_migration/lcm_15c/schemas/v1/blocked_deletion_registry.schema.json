{
  "$id": "https://alpha-lab.local/schemas/lcm15c/blocked_deletion_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "claim_ceiling": {
      "const": "LCM_15C_REFERENCE_ONLY"
    },
    "phase_id": {
      "const": "LCM-15C"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "FAILED",
        "BLOCKED",
        "UNKNOWN",
        "PARTIAL"
      ]
    }
  },
  "required": [
    "schema_version",
    "phase_id",
    "claim_ceiling",
    "validation_status",
    "registry_digest",
    "blocked_count",
    "approved_count"
  ],
  "title": "blocked_deletion_registry.schema.json",
  "type": "object"
}
