{
  "$id": "https://alpha-lab.local/schemas/lcm16b/upstream_binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_kind": {
      "const": "UPSTREAM_BINDING"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "master_phase": {
      "const": "LCM-16",
      "type": "string"
    },
    "phase_id": {
      "const": "LCM-16B",
      "type": "string"
    },
    "program_closure_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "upstream_handoff_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "FAILED",
        "BLOCKED",
        "UNKNOWN",
        "PARTIAL"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "phase_id",
    "master_phase",
    "program_closure_id",
    "artifact_kind",
    "upstream_handoff_digest",
    "validation_status"
  ],
  "title": "LCM16B Upstream Binding",
  "type": "object"
}
