{
  "$id": "https://alpha-lab.local/schemas/lcm16b/residual_risk_register.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_kind": {
      "const": "RESIDUAL_RISK_REGISTER"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "master_phase": {
      "const": "LCM-16",
      "type": "string"
    },
    "phase_id": {
      "const": "LCM-16B",
      "type": "string"
    },
    "program_closure_id": {
      "type": "string"
    },
    "risks": {
      "minItems": 5,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "FAILED",
        "BLOCKED",
        "UNKNOWN",
        "PARTIAL"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "phase_id",
    "master_phase",
    "program_closure_id",
    "artifact_kind",
    "risk_count",
    "risks",
    "validation_status"
  ],
  "title": "LCM16B Residual Risk Register",
  "type": "object"
}
