{
  "$id": "https://alpha-lab.local/acl12/security_readiness_decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed ACL-12 reference contract.",
  "properties": {
    "assessment_product_handoff_allowed": {
      "type": "boolean"
    },
    "capital_activation_allowed": {
      "type": "boolean"
    },
    "control_matrix_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "evidence_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "live_order_submission_allowed": {
      "type": "boolean"
    },
    "production_key_access_allowed": {
      "type": "boolean"
    },
    "production_security_ready": {
      "type": "boolean"
    },
    "readiness_decision_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "readiness_state": {
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reference_hardening_passed": {
      "type": "boolean"
    },
    "risk_register_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_activation_allowed": {
      "type": "boolean"
    },
    "runtime_custody_run_id": {
      "type": "string"
    },
    "runtime_generation_allowed": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "string"
    },
    "security_readiness_decision_id": {
      "type": "string"
    },
    "threat_assessment_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "assessment_product_handoff_allowed",
    "capital_activation_allowed",
    "control_matrix_digest",
    "decided_at",
    "decision",
    "evidence_bundle_digest",
    "live_order_submission_allowed",
    "production_key_access_allowed",
    "production_security_ready",
    "readiness_decision_digest",
    "readiness_state",
    "reason_codes",
    "reference_hardening_passed",
    "risk_register_digest",
    "runtime_activation_allowed",
    "runtime_custody_run_id",
    "runtime_generation_allowed",
    "schema_version",
    "security_readiness_decision_id",
    "threat_assessment_digest"
  ],
  "title": "security_readiness_decision",
  "type": "object"
}
