{
  "$id": "https://alpha-lab.local/acl12/reference_sbom.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed ACL-12 reference contract.",
  "properties": {
    "component_count": {
      "type": "integer"
    },
    "components": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "component_id": {
            "type": "string"
          },
          "component_type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "source_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "component_id",
          "component_type",
          "name",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "format": {
      "type": "string"
    },
    "production_completeness_claimed": {
      "type": "boolean"
    },
    "sbom_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "sbom_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "component_count",
    "components",
    "format",
    "production_completeness_claimed",
    "sbom_digest",
    "sbom_id",
    "schema_version"
  ],
  "title": "reference_sbom",
  "type": "object"
}
