  "additionalProperties": false,
  "description": "Closed ACL-12 reference contract.",
  "properties": {
    "acl11_handoff_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "capital_activation_allowed": {
      "type": "boolean"
    },
    "expires_at": {
      "type": "string"
    },
    "issued_at": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "live_order_submission_allowed": {
      "type": "boolean"
    },
    "network_access_allowed": {
      "type": "boolean"
    },
    "permit_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "permit_id": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "production_key_access_allowed": {
      "type": "boolean"
    },
    "runtime_activation_allowed": {
      "type": "boolean"
    },
    "runtime_custody_run_id": {
      "type": "string"
    },
    "runtime_generation_allowed": {
      "type": "boolean"
