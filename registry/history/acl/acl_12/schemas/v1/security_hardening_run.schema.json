{
  "$id": "https://alpha-lab.local/acl12/security_hardening_run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed ACL-12 reference contract.",
  "properties": {
    "capital_activation_allowed": {
      "type": "boolean"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "hardened_at": {
      "type": "string"
    },
    "live_order_submission_allowed": {
      "type": "boolean"
    },
    "production_security_ready": {
      "type": "boolean"
    },
    "promotion_run_id": {
      "type": "string"
    },
    "runtime_activation_allowed": {
      "type": "boolean"
    },
    "runtime_candidate_count": {
      "type": "integer"
    },
    "runtime_custody_run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "security_control_matrix_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "security_hardening_run_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "security_hardening_run_id": {
      "type": "string"
    },
    "security_readiness_decision_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "service_version": {
      "type": "string"
    },
    "state": {
      "type": "string"
    }
  },
  "required": [
    "capital_activation_allowed",
    "claim_ceiling",
    "hardened_at",
    "live_order_submission_allowed",
    "production_security_ready",
    "promotion_run_id",
    "runtime_activation_allowed",
    "runtime_candidate_count",
    "runtime_custody_run_id",
    "schema_version",
    "security_control_matrix_digest",
    "security_hardening_run_digest",
    "security_hardening_run_id",
    "security_readiness_decision_digest",
    "service_version",
    "state"
  ],
  "title": "security_hardening_run",
  "type": "object"
}
