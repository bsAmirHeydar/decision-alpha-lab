{
  "$id": "https://alpha-lab.local/acl12/authority_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed ACL-12 reference contract.",
  "properties": {
    "acl11_handoff_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "authority_report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "denied_capabilities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "permit_id": {
      "type": "string"
    },
    "runtime_custody_run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "validated": {
      "type": "boolean"
    }
  },
  "required": [
    "acl11_handoff_digest",
    "action",
    "authority_report_digest",
    "denied_capabilities",
    "permit_id",
    "runtime_custody_run_id",
    "schema_version",
    "validated"
  ],
  "title": "authority_report",
  "type": "object"
}
