{
  "$id": "https://schemas.alpha-lab.local/acl-os/acl-01/v1/scan_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capital_activation_allowed": {
      "const": false
    },
    "findings": {
      "items": {
        "$ref": "https://schemas.alpha-lab.local/acl-os/acl-01/v1/scan_finding.schema.json"
      },
      "type": "array"
    },
    "live_order_submission_allowed": {
      "const": false
    },
    "passed": {
      "type": "boolean"
    },
    "registered_artifacts": {
      "minimum": 0,
      "type": "integer"
    },
    "registry_digest": {
      "type": "string"
    }
  },
  "required": [
    "passed",
    "findings",
    "registered_artifacts",
    "registry_digest",
    "live_order_submission_allowed",
    "capital_activation_allowed"
  ],
  "title": "scan_report.schema.json",
  "type": "object"
}
