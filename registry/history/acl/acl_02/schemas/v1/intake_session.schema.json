{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answers": {
      "type": "object"
    },
    "context_id": {
      "minLength": 1,
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "OPEN",
        "CLOSED"
      ]
    }
  },
  "required": [
    "context_id",
    "session_id",
    "answers",
    "status",
    "revision",
    "digest"
  ],
  "title": "ACL-02 Intake Session",
  "type": "object"
}
