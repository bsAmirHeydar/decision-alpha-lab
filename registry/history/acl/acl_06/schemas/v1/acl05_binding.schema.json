{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acl05_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "acl05_handoff_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "batch_definition_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "batch_id": {
      "type": "string"
    },
    "binding_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "immutable": {
      "type": "boolean"
    },
    "object_index_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "acl05_bundle_digest",
    "acl05_handoff_digest",
    "batch_definition_digest",
    "batch_id",
    "binding_digest",
    "immutable",
    "object_index_digest",
    "schema_version"
  ],
  "type": "object"
}
