{
  "$id": "https://alpha-lab.local/acl11/OutputManifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_count": {
      "minimum": 0,
      "type": "integer"
    },
    "files": {
      "type": "array"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_custody_run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "self_reference_policy": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "runtime_custody_run_id",
    "artifact_count",
    "files",
    "manifest_digest"
  ],
  "title": "OutputManifest",
  "type": "object"
}
