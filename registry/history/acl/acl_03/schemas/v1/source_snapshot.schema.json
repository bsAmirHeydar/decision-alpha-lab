{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compiler_version": {
      "minLength": 1,
      "type": "string"
    },
    "context_id": {
      "minLength": 1,
      "type": "string"
    },
    "context_version": {
      "minLength": 1,
      "type": "string"
    },
    "files": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "source_package_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context_id",
    "context_version",
    "compiler_version",
    "files",
    "source_package_digest",
    "snapshot_digest"
  ],
  "type": "object"
}
