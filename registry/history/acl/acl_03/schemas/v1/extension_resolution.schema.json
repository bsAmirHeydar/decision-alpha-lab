{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context_id": {
      "minLength": 1,
      "type": "string"
    },
    "extension_count": {
      "type": "integer"
    },
    "extensions": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "findings": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "passed": {
      "type": "boolean"
    },
    "resolution_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context_id",
    "extensions",
    "extension_count",
    "passed",
    "findings",
    "resolution_digest"
  ],
  "type": "object"
}
