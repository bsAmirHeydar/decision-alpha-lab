{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_ceiling": {
      "const": "CONTEXT_COMPILATION_REFERENCE_ONLY"
    },
    "compiler_version": {
      "minLength": 1,
      "type": "string"
    },
    "context_id": {
      "minLength": 1,
      "type": "string"
    },
    "context_version": {
      "minLength": 1,
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "source_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "steps": {
      "items": {
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "context_id",
    "context_version",
    "source_digest",
    "compiler_version",
    "steps",
    "claim_ceiling",
    "plan_digest"
  ],
  "type": "object"
}
