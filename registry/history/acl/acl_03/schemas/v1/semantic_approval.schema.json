{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "approver_roles": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "source_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "subject_artifact_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "decision",
    "subject_artifact_id",
    "source_snapshot_digest",
    "approver_roles"
  ],
  "type": "object"
}
