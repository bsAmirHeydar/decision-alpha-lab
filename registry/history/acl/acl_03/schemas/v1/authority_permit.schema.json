      "const": "ACL03_COMPILE_CONTEXT"
    },
    "capital_activation_allowed": {
      "const": false
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY"
      ]
    },
    "live_order_submission_allowed": {
      "const": false
    },
    "permit_id": {
      "minLength": 1,
