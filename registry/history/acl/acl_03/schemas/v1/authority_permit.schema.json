    },
    "subject_artifact_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "decision",
    "action",
    "subject_artifact_id",
    "live_order_submission_allowed",
    "capital_activation_allowed"
  ],
  "type": "object"
}
