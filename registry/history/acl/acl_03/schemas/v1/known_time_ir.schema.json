{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calendar_id": {
      "minLength": 1,
      "type": "string"
    },
    "clock_skew_tolerance_ms": {
      "type": "integer"
    },
    "context_id": {
      "minLength": 1,
      "type": "string"
    },
    "future_revision_allowed": {
      "const": false
    },
    "guards": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "known_time_ir_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "late_data_policy": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "source_guards": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "timezone": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context_id",
    "timezone",
    "calendar_id",
    "clock_skew_tolerance_ms",
    "late_data_policy",
    "guards",
    "source_guards",
    "future_revision_allowed",
    "known_time_ir_digest"
  ],
  "type": "object"
}
