{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "closed_schema_required": {
      "const": true
    },
    "context_id": {
      "minLength": 1,
      "type": "string"
    },
    "entries": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "schema_index_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context_id",
    "entries",
    "closed_schema_required",
    "schema_index_digest"
  ],
  "type": "object"
}
