{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context_id": {
      "minLength": 1,
      "type": "string"
    },
    "context_version": {
      "minLength": 1,
      "type": "string"
    },
    "entries": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "entry_count": {
      "type": "integer"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "source_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context_id",
    "context_version",
    "source_digest",
    "entries",
    "entry_count",
    "manifest_digest"
  ],
  "type": "object"
}
