{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_count": {
      "type": "integer"
    },
    "failed_count": {
      "type": "integer"
    },
    "passed_count": {
      "type": "integer"
    },
    "replay_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "results": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "case_count",
    "passed_count",
    "failed_count",
    "results",
    "replay_digest"
  ],
  "type": "object"
}
