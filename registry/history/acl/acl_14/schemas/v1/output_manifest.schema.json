{
  "$id": "https://alpha-lab.local/acl14/output_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_count": {
      "type": "integer"
    },
    "files": {
      "type": "array"
    },
    "manifest_digest": {
      "type": "string"
    },
    "pilot_run_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schema_version",
    "pilot_run_id",
    "artifact_count",
    "files",
    "manifest_digest"
  ],
  "title": "output_manifest",
  "type": "object"
}
