{
  "$id": "https://alpha-lab.local/acl07/output_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_count": {},
    "files": {},
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "self_reference_policy": {
      "minLength": 1,
      "type": "string"
    },
    "validation_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "validation_id",
    "artifact_count",
    "files",
    "self_reference_policy",
    "manifest_digest"
  ],
  "title": "output_manifest",
  "type": "object"
}
