{
  "$id": "https://alpha-lab.local/acl07/integrity_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acl06_bundle_verified": {},
    "candidate_files_verified": {},
    "passed": {},
    "report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "research_results_mutated": {},
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "segment_results_verified": {},
    "validation_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "validation_id",
    "acl06_bundle_verified",
    "candidate_files_verified",
    "segment_results_verified",
    "research_results_mutated",
    "passed",
    "report_digest"
  ],
  "title": "integrity_report",
  "type": "object"
}
