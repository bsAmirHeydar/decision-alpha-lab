{
  "$id": "https://alpha-lab.local/lcm15a/Handoff.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "approved_future_deletion_count": {
      "const": 0
    },
    "claim_ceiling": {
      "const": "LCM_15A_REFERENCE_ONLY"
    },
    "handoff_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "handoff_type": {
      "const": "LCM15A_TO_LCM15B"
    },
    "master_phase": {
      "const": "LCM-15"
    },
    "phase_id": {
      "const": "LCM-15A"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "BLOCKED",
        "FAILED",
        "UNKNOWN",
        "PARTIAL"
      ]
    }
  },
  "required": [
    "schema_version",
    "phase_id",
    "master_phase",
    "claim_ceiling",
    "validation_status",
    "handoff_type",
    "handoff_digest",
    "approved_future_deletion_count"
  ],
  "title": "Handoff",
  "type": "object"
}
