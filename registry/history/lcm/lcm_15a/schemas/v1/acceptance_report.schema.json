{
  "$id": "https://alpha-lab.local/lcm15a/AcceptanceReport.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "claim_ceiling": {
      "const": "LCM_15A_REFERENCE_ONLY"
    },
    "gates": {
      "type": "object"
    },
    "master_phase": {
      "const": "LCM-15"
    },
    "phase_id": {
      "const": "LCM-15A"
    },
    "proof_id": {
      "type": "string"
    },
    "report_result": {
      "const": "PASS"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "BLOCKED",
        "FAILED",
        "UNKNOWN",
        "PARTIAL"
      ]
    }
  },
  "required": [
    "schema_version",
    "phase_id",
    "master_phase",
    "claim_ceiling",
    "validation_status",
    "proof_id",
    "report_result",
    "gates"
  ],
  "title": "AcceptanceReport",
  "type": "object"
}
