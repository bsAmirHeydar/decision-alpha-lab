{
  "$id": "https://alpha-lab.local/lcm-16a/lcm-16a-rollback-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "claim_ceiling": {
      "const": "LCM_16A_REFERENCE_ONLY"
    },
    "phase_id": {
      "const": "LCM-16A"
    },
    "rollback_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "FAILED",
        "BLOCKED",
        "UNKNOWN",
        "PARTIAL",
        "PASS_WITH_RESIDUALS"
      ]
    }
  },
  "required": [
    "schema_version",
    "phase_id",
    "claim_ceiling",
    "validation_status",
    "rollback_manifest_digest",
    "phase_owned_paths"
  ],
  "title": "LCM-16A Rollback Manifest",
  "type": "object"
}
