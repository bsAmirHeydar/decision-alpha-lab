{
  "$id": "https://alpha-lab.local/schemas/lcm16b/final_locator_snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_kind": {
      "const": "FINAL_LOCATOR_SNAPSHOT"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "master_phase": {
      "const": "LCM-16",
      "type": "string"
    },
    "phase_id": {
      "const": "LCM-16B",
      "type": "string"
    },
    "phase_locator_count": {
      "minimum": 30,
      "type": "integer"
    },
    "phase_locators": {
      "minItems": 30,
      "type": "array"
    },
    "program_closure_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "FAILED",
        "BLOCKED",
        "UNKNOWN",
        "PARTIAL"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "phase_id",
    "master_phase",
    "program_closure_id",
    "artifact_kind",
    "phase_locator_count",
    "phase_locators",
    "validation_status"
  ],
  "title": "LCM16B Final Locator Snapshot",
  "type": "object"
}
