{
  "$id": "https://alpha-lab.local/lcm10a/security_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "adapter_activation_allowed": {
      "const": false
    },
    "authority_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "capability_id": {
      "minLength": 3,
      "type": "string"
    },
    "claim_ceiling": {
      "const": "LCM_10A_REFERENCE_ONLY",
      "type": "string"
    },
    "deterministic_identity": {
      "const": true,
      "type": "boolean"
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_time_semantics": {
      "minLength": 1,
      "type": "string"
    },
    "lcm02_security_review_status": {
      "type": "string"
    },
    "lcm02_security_sensitive": {
      "type": "boolean"
    },
    "live_order_authority": {
      "const": false
    },
    "owner": {},
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "restriction_state": {
      "const": "SECURITY_REVIEW_REQUIRED"
    },
    "reviewer": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "security_record_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "security_record_id": {
      "minLength": 3,
      "type": "string"
    },
    "security_reviewer_role": {
      "type": "string"
    },
    "source_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "source_path": {
      "minLength": 1,
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      },
      "type": "string"
    },
    "validation_status": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "producer",
    "source_digests",
    "generated_at",
    "generated_time_semantics",
    "deterministic_identity",
    "owner",
    "reviewer",
    "claim_ceiling",
    "validation_status",
    "security_record_id",
    "capability_id",
    "source_path",
    "authority_class",
    "lcm02_security_sensitive",
    "lcm02_security_review_status",
    "security_reviewer_role",
    "restriction_state",
    "adapter_activation_allowed",
    "live_order_authority",
    "security_record_digest"
  ],
  "title": "security_record",
  "type": "object"
}
