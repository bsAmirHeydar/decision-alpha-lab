{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_gate_passed": {
      "const": true
    },
    "claim_ceiling": {
      "const": "LCM_09B_REFERENCE_ONLY"
    },
    "explicitly_blocked_count": {
      "type": "integer"
    },
    "factory_registration_count": {
      "const": 60,
      "type": "integer"
    },
    "generated_time_semantics": {
      "minLength": 1,
      "type": "string"
    },
    "hard_mismatch_count": {
      "const": 0,
      "type": "integer"
    },
    "migration_id": {
      "pattern": "^[A-Z][A-Z0-9_.:-]{2,191}$",
      "type": "string"
    },
    "non_compensatory_gates": {
      "type": "array"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "package_count": {
      "const": 60,
      "type": "integer"
    },
    "parity_blocked_count": {
      "type": "integer"
    },
    "parity_pass_count": {
      "type": "integer"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "reference_ready_count": {
      "type": "integer"
    },
    "report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "source_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "BLOCKED",
        "UNKNOWN",
        "FAIL"
      ]
    }
  },
  "required": [
    "schema_version",
    "producer",
    "source_digests",
    "generated_time_semantics",
    "owner",
    "claim_ceiling",
    "validation_status",
    "migration_id",
    "acceptance_gate_passed",
    "package_count",
    "reference_ready_count",
    "explicitly_blocked_count",
    "factory_registration_count",
    "parity_pass_count",
    "parity_blocked_count",
    "hard_mismatch_count",
    "non_compensatory_gates",
    "report_digest"
  ],
  "title": "Acceptance report",
  "type": "object"
}
