{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_ceiling": {
      "const": "LCM_09B_REFERENCE_ONLY"
    },
    "factory_port": {
      "const": "ACL04_LEGACY_REFERENCE_PORT_V1"
    },
    "generated_time_semantics": {
      "minLength": 1,
      "type": "string"
    },
    "migration_id": {
      "pattern": "^[A-Z][A-Z0-9_.:-]{2,191}$",
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "registration_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "registrations": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "source_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "BLOCKED",
        "UNKNOWN",
        "FAIL"
      ]
    }
  },
  "required": [
    "schema_version",
    "producer",
    "source_digests",
    "generated_time_semantics",
    "owner",
    "claim_ceiling",
    "validation_status",
    "migration_id",
    "factory_port",
    "registrations",
    "registration_digest"
  ],
  "title": "Factory registration",
  "type": "object"
}
