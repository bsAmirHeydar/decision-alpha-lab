{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_reference_package_count": {
      "const": 60
    },
    "claim_ceiling": {
      "const": "LCM_09B_REFERENCE_ONLY"
    },
    "closure_status": {
      "const": "CLOSED_REFERENCE_ACCOUNTING"
    },
    "explicitly_blocked_count": {
      "type": "integer"
    },
    "generated_time_semantics": {
      "minLength": 1,
      "type": "string"
    },
    "migration_id": {
      "pattern": "^[A-Z][A-Z0-9_.:-]{2,191}$",
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "reference_ready_count": {
      "type": "integer"
    },
    "report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "setup_identity_count": {
      "const": 60
    },
    "source_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "unaccounted_count": {
      "const": 0
    },
    "validation_status": {
      "enum": [
        "PASS",
        "BLOCKED",
        "UNKNOWN",
        "FAIL"
      ]
    }
  },
  "required": [
    "schema_version",
    "producer",
    "source_digests",
    "generated_time_semantics",
    "owner",
    "claim_ceiling",
    "validation_status",
    "migration_id",
    "setup_identity_count",
    "canonical_reference_package_count",
    "reference_ready_count",
    "explicitly_blocked_count",
    "unaccounted_count",
    "closure_status",
    "report_digest"
  ],
  "title": "Portfolio closure",
  "type": "object"
}
