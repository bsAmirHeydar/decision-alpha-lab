{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocker_ids": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_.:-]{2,191}$",
        "type": "string"
      },
      "type": "array"
    },
    "case_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[A-Z][A-Z0-9_.:-]{2,191}$",
      "type": "string"
    },
    "case_status": {
      "enum": [
        "EXECUTABLE",
        "BLOCKED"
      ]
    },
    "claim_ceiling": {
      "const": "LCM_09B_REFERENCE_ONLY"
    },
    "expected_decision": {
      "type": "object"
    },
    "generated_time_semantics": {
      "minLength": 1,
      "type": "string"
    },
    "input_snapshot": {
      "type": "object"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "setup_id": {
      "pattern": "^[A-Z][A-Z0-9_.:-]{2,191}$",
      "type": "string"
    },
    "source_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "validation_status": {
      "enum": [
        "PASS",
        "BLOCKED",
        "UNKNOWN",
        "FAIL"
      ]
    }
  },
  "required": [
    "schema_version",
    "producer",
    "source_digests",
    "generated_time_semantics",
    "owner",
    "claim_ceiling",
    "validation_status",
    "case_id",
    "setup_id",
    "case_status",
    "input_snapshot",
    "expected_decision",
    "blocker_ids",
    "case_digest"
  ],
  "title": "Golden case",
  "type": "object"
}
