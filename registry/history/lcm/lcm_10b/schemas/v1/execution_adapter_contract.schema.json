{
  "$id": "https://alpha-lab.local/lcm10b/execution_adapter_contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "adapter_digest": {
      "type": "string"
    },
    "adapter_id": {
      "type": "string"
    },
    "capability_ids": {
      "type": "array"
    },
    "claim_ceiling": {
      "const": "LCM_10B_REFERENCE_ONLY",
      "type": "string"
    },
    "deterministic_identity": {
      "const": true,
      "type": "boolean"
    },
    "dry_run_mode_allowed": {
      "const": true,
      "type": "boolean"
    },
    "generated_at": {
      "type": [
        "null",
        "string"
      ]
    },
    "generated_time_semantics": {
      "type": "string"
    },
    "live_mode_allowed": {
      "const": false,
      "type": "boolean"
    },
    "owner": {
      "type": "string"
    },
    "paper_mode_allowed": {
      "const": false,
      "type": "boolean"
    },
    "producer": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "source_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "source_path": {
      "type": "string"
    },
    "submission_capability_default": {
      "const": false,
      "type": "boolean"
    },
    "validation_status": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "producer",
    "source_digests",
    "generated_at",
    "generated_time_semantics",
    "deterministic_identity",
    "owner",
    "reviewer",
    "claim_ceiling",
    "validation_status",
    "adapter_id",
    "source_path",
    "capability_ids",
    "submission_capability_default",
    "live_mode_allowed",
    "paper_mode_allowed",
    "adapter_digest"
  ],
  "title": "execution_adapter_contract",
  "type": "object"
}
