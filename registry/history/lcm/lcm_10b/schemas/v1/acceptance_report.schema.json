{
  "$id": "https://alpha-lab.local/lcm10b/acceptance_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "acceptance_gate_passed": {
      "type": "boolean"
    },
    "claim_ceiling": {
      "const": "LCM_10B_REFERENCE_ONLY",
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "deterministic_identity": {
      "const": true,
      "type": "boolean"
    },
    "generated_at": {
      "type": [
        "null",
        "string"
      ]
    },
    "generated_time_semantics": {
      "type": "string"
    },
    "non_compensatory_gates": {
      "type": "array"
    },
    "owner": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "report_digest": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "source_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "validation_status": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "producer",
    "source_digests",
    "generated_at",
    "generated_time_semantics",
    "deterministic_identity",
    "owner",
    "reviewer",
    "claim_ceiling",
    "validation_status",
    "acceptance_gate_passed",
    "counts",
    "non_compensatory_gates",
    "report_digest"
  ],
  "title": "acceptance_report",
  "type": "object"
}
