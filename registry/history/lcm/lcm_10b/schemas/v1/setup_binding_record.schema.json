{
  "$id": "https://alpha-lab.local/lcm10b/setup_binding_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "binding_digest": {
      "type": "string"
    },
    "binding_id": {
      "type": "string"
    },
    "binding_status": {
      "type": "string"
    },
    "blocker_ids": {
      "type": "array"
    },
    "claim_ceiling": {
      "const": "LCM_10B_REFERENCE_ONLY",
      "type": "string"
    },
    "deterministic_identity": {
      "const": true,
      "type": "boolean"
    },
    "execution_authorized": {
      "const": false,
      "type": "boolean"
    },
    "generated_at": {
      "type": [
        "null",
        "string"
      ]
    },
    "generated_time_semantics": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "setup_id": {
      "type": "string"
    },
    "source_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "treatment_package_ids": {
      "type": "array"
    },
    "validation_status": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "producer",
    "source_digests",
    "generated_at",
    "generated_time_semantics",
    "deterministic_identity",
    "owner",
    "reviewer",
    "claim_ceiling",
    "validation_status",
    "binding_id",
    "setup_id",
    "binding_status",
    "treatment_package_ids",
    "blocker_ids",
    "execution_authorized",
    "binding_digest"
  ],
  "title": "setup_binding_record",
  "type": "object"
}
