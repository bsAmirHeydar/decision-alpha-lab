{
  "$id": "https://alpha-lab.local/lcm10c/handoff.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "allowed_next_actions": {
      "type": "array"
    },
    "claim_ceiling": {
      "const": "LCM_10C_REFERENCE_ONLY"
    },
    "deterministic_identity": {
      "const": true
    },
    "forbidden_actions": {
      "type": "array"
    },
    "generated_at": {
      "type": [
        "null",
        "string"
      ]
    },
    "generated_time_semantics": {
      "type": "string"
    },
    "handoff_digest": {
      "type": "string"
    },
    "handoff_id": {
      "type": "string"
    },
    "handoff_type": {
      "const": "LCM10C_TO_LCM11A"
    },
    "owner": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "source_digests": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "validation_status": {
      "type": "string"
    }
  },
  "required": [
    "handoff_id",
    "handoff_type",
    "allowed_next_actions",
    "forbidden_actions",
    "handoff_digest"
  ],
  "title": "handoff",
  "type": "object"
}
