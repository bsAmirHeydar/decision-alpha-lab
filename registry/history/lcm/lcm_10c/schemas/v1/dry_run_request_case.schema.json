{
  "$id": "https://alpha-lab.local/lcm10c/dry_run_request_case.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "case_digest": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "claim_ceiling": {
      "const": "LCM_10C_REFERENCE_ONLY"
    },
    "deterministic_identity": {
      "const": true
    },
    "generated_at": {
      "type": [
        "null",
        "string"
      ]
    },
    "generated_time_semantics": {
      "type": "string"
    },
    "intent": {
      "type": "object"
    },
    "owner": {
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "source_digests": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "symbol_fixture": {
      "type": "object"
    },
    "validation_status": {
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "package_id",
    "intent",
    "symbol_fixture",
    "case_digest"
  ],
  "title": "dry_run_request_case",
  "type": "object"
}
