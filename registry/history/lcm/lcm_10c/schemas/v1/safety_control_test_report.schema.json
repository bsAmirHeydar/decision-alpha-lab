{
  "$id": "https://alpha-lab.local/lcm10c/safety_control_test_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "case_count": {
      "type": "integer"
    },
    "claim_ceiling": {
      "const": "LCM_10C_REFERENCE_ONLY"
    },
    "controls": {
      "type": "array"
    },
    "deterministic_identity": {
      "const": true
    },
    "failed_count": {
      "const": 0
    },
    "generated_at": {
      "type": [
        "null",
        "string"
      ]
    },
    "generated_time_semantics": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "passed_count": {
      "type": "integer"
    },
    "producer": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "source_digests": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "validation_status": {
      "type": "string"
    }
  },
  "required": [
    "case_count",
    "passed_count",
    "failed_count",
    "controls"
  ],
  "title": "safety_control_test_report",
  "type": "object"
}
