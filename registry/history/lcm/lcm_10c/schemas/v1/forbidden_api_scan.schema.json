{
  "$id": "https://alpha-lab.local/lcm10c/forbidden_api_scan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "canonical_hit_count": {
      "const": 0
    },
    "claim_ceiling": {
      "const": "LCM_10C_REFERENCE_ONLY"
    },
    "deterministic_identity": {
      "const": true
    },
    "generated_at": {
      "type": [
        "null",
        "string"
      ]
    },
    "generated_time_semantics": {
      "type": "string"
    },
    "legacy_evidence_hit_count": {
      "type": "integer"
    },
    "owner": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "scanned_roots": {
      "type": "array"
    },
    "schema_version": {
      "type": "string"
    },
    "source_digests": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "validation_status": {
      "type": "string"
    }
  },
  "required": [
    "scanned_roots",
    "canonical_hit_count",
    "legacy_evidence_hit_count"
  ],
  "title": "forbidden_api_scan",
  "type": "object"
}
